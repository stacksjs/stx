{{-- What a screen reader is told about a form built from the shared fields
     (stacksjs/stx#2184): each one named by its label, the password hidden
     until asked for, the picker announcing its choice. Compiled by STX and
     run in the maintained iOS gate. --}}
@import('TextInput', '../../../../components/src/ui/input/TextInput.stx')
@import('EmailInput', '../../../../components/src/ui/input/EmailInput.stx')
@import('PasswordInput', '../../../../components/src/ui/input/PasswordInput.stx')
@import('Select', '../../../../components/src/ui/select/Select.stx')
@import('SegmentedControl', '../../../../components/src/ui/segmented-control/SegmentedControl.stx')
<script client>
const name = state('')
const email = state('')
const secret = state('')
const sport = state('')
const period = state('week')
</script>
<section class="p-4 gap-3 bg-white dark:bg-black text-black dark:text-white">
  <TextInput testID="form-name" label="Full name" placeholder="Ada Lovelace" v-model:value="name" />
  <EmailInput testID="form-email" label="Email" v-model:value="email" />
  <PasswordInput testID="form-password" label="Password" v-model:value="secret" />
  <Select testID="form-sport" label="Sport" v-model:value="sport" :options="[{ value: 'run', label: 'Run' }, { value: 'ride', label: 'Ride' }]" />
  <SegmentedControl testID="form-period" label="Period" stretch v-model:value="period" :options="[{ value: 'week', label: 'This week' }, { value: 'month', label: 'This month' }, { value: 'all', label: 'All time', disabled: true }]" />
  <span testID="form-summary" :text="'Summary: ' + name() + ', ' + email() + ', ' + secret().length + ' characters, ' + (sport() || 'no sport') + ', ' + period()"></span>
</section>
