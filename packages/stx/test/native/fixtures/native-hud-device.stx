@import('NativeHudPanel', './NativeHudPanel.stx')
<script client>
import * as hud from './native-hud-model'
const mounts = state([1])
window.hudProbe = { model: hud }
</script>
<section class="p-4 gap-2 bg-white dark:bg-black text-black dark:text-white">
  <template :for="mount in mounts()" :key="mount">
    <NativeHudPanel />
  </template>
  <span testID="subscriptions" :text="'Subscriptions: ' + hud.subscriberCount()"></span>
  <button testID="toggle-hud" @click="mounts.set(mounts().length ? [] : [1])">Toggle HUD</button>
  <button testID="external-increment" @click="hud.increment(1)">External update</button>
</section>
