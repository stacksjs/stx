{{--
  FloatingActions: the round controls that float over a screen, above the
  trailing end of the tab bar, joined in one capsule of glass as the map
  controls in Maps are.

    <FloatingActions :actions="[
      { path: '/add', label: 'Add', symbol: 'plus', menu: addChoices },
      { path: '/messages', label: 'Messages', symbol: 'message.fill', badge: unread },
    ]" />

  `layout` is `vertical` (the default), `horizontal`, or `separate` for a
  round control each. The host draws them (Liquid Glass on iOS 26), so this
  takes no room in the screen's own layout; they follow `actions` as it
  changes and leave with the screen.

  A web page has no host, so there the component draws the same group itself:
  each action's `icon` (an icon class) in place of its SF Symbol, opening its
  `href` where the website's path differs from the app's. Its look weighs
  nothing against a class: `class` goes on the group (`flex md:hidden` shows
  it on a phone only), `badgeClass` on the badge and `menuClass` on a menu.
  `--stx-floating-actions-*` place and colour it too (floating-actions-web.ts). For actions every screen shares, pass
  `floatingActions()` from `@stacksjs/stx/native` to `craft.navigation.setChrome`.
--}}
<script client>
import { floatingActions } from '../floating-actions'
import { mountFloatingActionsWeb } from '../floating-actions-web'

const floatingList = useReactiveProp('actions', [])
const floatingLayout = useReactiveProp('layout', 'vertical')
const floatingClass = useReactiveProp('class', '')
// `className` as well: a component's `class` can be taken by its own root.
const floatingClassName = useReactiveProp('className', '')
const floatingBadgeClass = useReactiveProp('badgeClass', '')
const floatingMenuClass = useReactiveProp('menuClass', '')
const floatingHost = typeof craft !== 'undefined' && craft && craft.navigation ? craft.navigation : null
// A page drawn by a browser has no host chrome to put them in, so it draws them.
const floatingPage = !floatingHost && typeof document !== 'undefined' ? mountFloatingActionsWeb(document) : null
let floatingSent = ''

effect(() => {
  if (floatingPage) {
    const list = floatingList()
    floatingPage.update(Array.isArray(list) ? list : [], String(floatingLayout() || 'vertical'), { group: String(floatingClassName() || floatingClass() || ''), badge: String(floatingBadgeClass() || ''), menu: String(floatingMenuClass() || '') })
    return
  }
  if (!floatingHost) return
  const list = floatingList()
  const accessory = floatingActions(Array.isArray(list) ? list : [], String(floatingLayout() || 'vertical'))
  // The same actions again (a parent re-rendered) are not a change to draw.
  const next = JSON.stringify(accessory)
  // Nor is having none before any were shown: there is nothing to take away.
  if (next === floatingSent || (accessory === null && !floatingSent)) return
  floatingSent = next
  floatingHost.setOptions({ tabAccessory: accessory })
})

onDestroy(() => {
  if (floatingPage) floatingPage.dispose()
  if (floatingHost && floatingSent && floatingSent !== 'null') floatingHost.setOptions({ tabAccessory: null })
})
</script>
<div data-native="View" class="hidden" aria-hidden="true" data-floating-actions></div>
