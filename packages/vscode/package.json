{
  "publisher": "Stacks",
  "name": "vscode-stx",
  "private": true,
  "displayName": "stx Language Support",
  "version": "0.2.423",
  "description": "Language support for stx templates: syntax highlighting, completions, hovers, diagnostics, go to definition and utility-class previews for .stx files.",
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "sponsor": {
    "url": "https://github.com/sponsors/chrisbbreuer"
  },
  "homepage": "https://github.com/stacksjs/stx/tree/main/packages/vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/stacksjs/stx.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stx/issues"
  },
  "keywords": [
    "stx",
    "stx templates",
    "templating",
    "blade",
    "syntax highlighting",
    "language server",
    "intellisense",
    "utility classes",
    "stacks",
    "stacksjs"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/extension.js",
      "types": "./src/index.ts"
    },
    "./extension": {
      "require": "./dist/extension.js"
    },
    "./plugin": {
      "require": "./dist/typescript-stx-plugin.js"
    }
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.stx",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "stx",
        "aliases": [
          "stx",
          "STX"
        ],
        "extensions": [
          ".stx"
        ],
        "configuration": "./src/languages/stx.configuration.json"
      }
    ],
    "commands": [
      {
        "command": "stx.sortClasses",
        "title": "Sort Utility Classes",
        "category": "stx"
      },
      {
        "command": "stx.reloadUtilityClasses",
        "title": "Reload Utility Class Configuration",
        "category": "stx"
      }
    ],
    "iconThemes": [
      {
        "id": "stx-icons",
        "label": "STX File Icons",
        "path": "./icons/stx-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "stx",
        "scopeName": "text.html.ts.stx",
        "path": "./src/syntaxes/stx.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript",
          "source.ts": "typescript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.line.typescript": "typescript",
          "meta.component.parameters.stx": "typescript"
        }
      }
    ],
    "snippets": [
      {
        "language": "stx",
        "path": "./src/snippets/stx.json"
      }
    ],
    "configuration": {
      "title": "stx",
      "properties": {
        "stxTypescriptPlugin.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Type-check the TypeScript in stx files (script blocks and template expressions) with the TypeScript server, and offer its hovers, completions and go to definition there"
        },
        "stx.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostics (errors and warnings) for stx files"
        },
        "stx.diagnostics.validateUnclosedDirectives": {
          "type": "boolean",
          "default": true,
          "description": "Validate unclosed directives like @if without @endif"
        },
        "stx.diagnostics.validateMismatchedDirectives": {
          "type": "boolean",
          "default": true,
          "description": "Validate mismatched directives like @if closed with @endforeach"
        },
        "stx.diagnostics.validateTemplatePaths": {
          "type": "boolean",
          "default": true,
          "description": "Validate that template paths in @include and @component directives exist"
        },
        "stx.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion for stx directives"
        },
        "stx.completion.showSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Show snippet completions with placeholders for directive parameters"
        },
        "stx.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover documentation for stx directives"
        },
        "stx.hover.showExamples": {
          "type": "boolean",
          "default": true,
          "description": "Show code examples in hover documentation"
        },
        "stx.codeActions.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable quick fixes and code actions"
        },
        "stx.folding.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable code folding for directive blocks"
        },
        "stx.semanticHighlighting.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic syntax highlighting for directives"
        },
        "stx.utilityClasses.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable utility class features (tooltips, color previews, sorting)"
        },
        "stx.utilityClasses.framework": {
          "type": "string",
          "enum": [
            "tailwind",
            "unocss",
            "auto"
          ],
          "default": "auto",
          "markdownDescription": "Utility CSS framework to use. `auto` will detect from config files"
        },
        "stx.utilityClasses.colorPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show inline color decorations for color utility classes"
        },
        "stx.utilityClasses.hoverPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show CSS output when hovering over utility classes"
        },
        "stx.utilityClasses.underline": {
          "type": "boolean",
          "default": true,
          "description": "Underline matched utility classes"
        },
        "stx.utilityClasses.sortOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically sort utility classes on file save"
        },
        "stx.utilityClasses.colorPreviewRadius": {
          "type": "string",
          "default": "0",
          "description": "Border radius for color preview blocks ('0' for square like Tailwind, '50%' for circle)"
        },
        "stx.utilityClasses.selectionStyle": {
          "type": "boolean",
          "default": false,
          "description": "Show CSS preview for selected utility classes"
        },
        "stx.utilityClasses.autocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable autocomplete for utility classes"
        },
        "stx.utilityClasses.remToPxRatio": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "markdownDescription": "Pixels per `rem` for the px values utility-class hovers show next to `rem` values. `0` hides them. Replaces `css.remToPxRatio`, which is still read when this is not set."
        }
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "@stacksjs/stx-typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": [
          "stx"
        ]
      }
    ]
  },
  "scripts": {
    "build": "bun build.ts",
    "vscode:prepublish": "bun run build",
    "package": "bun scripts/package.ts",
    "release": "bun scripts/package.ts --publish"
  },
  "galleryBanner": {
    "color": "#d7e4f5",
    "theme": "light"
  },
  "dependencies": {
    "@stacksjs/ts-css": "^0.3.7",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@types/vscode": "~1.109.0",
    "@vscode/vsce": "^3.7.2-13",
    "typescript": "^7.0.2",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-languageserver-types": "^3.18.4"
  }
}
