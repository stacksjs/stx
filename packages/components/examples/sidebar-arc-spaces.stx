<script server>
// Arc's spaces — the swipeable version of the sidebar.
//
// Each entry below is a whole scene: its own pinned tiles, its own folders and
// tabs, its own bottom action, and its own color. Swipe horizontally over the
// list (or click the rail at the bottom, or press ⌘⌥←/→) and the panel
// crossfades to the next one.
//
// Everything here is data. There is no per-space markup, no carousel wiring
// and no color bookkeeping — a space names one seed color and the panel,
// the text and the accent are all mixed from it.
export const spaces = [
  {
    id: 'personal',
