{
  "name": "@stacksjs/components",
  "type": "module",
  "version": "0.2.860",
  "description": "A modern component library built with STX, featuring headwind utility classes and TypeScript syntax highlighting.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/stx/tree/main/packages/components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/stx.git",
    "directory": "./packages/components"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/stx/issues"
  },
  "keywords": [
    "components",
    "ui",
    "stx",
    "headwind",
    "typescript",
    "bun",
    "component-library"
  ],
  "stx": {
    "components": [
      "./src/ui",
      "./src/components"
    ]
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "bun": "./dist/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./stx-plugin": {
      "bun": "./stx-plugin.ts",
      "import": "./stx-plugin.ts"
    },
    "./chat": {
      "types": "./dist/ui/chat/controller.d.ts",
      "bun": "./dist/chat/controller.js",
      "import": "./dist/chat/controller.js"
    },
    "./code-editor": {
      "types": "./dist/ui/code-editor/editor.d.ts",
      "bun": "./dist/code-editor/editor.js",
      "import": "./dist/code-editor/editor.js"
    },
    "./component-api": {
      "types": "./dist/utils/component-api.d.ts",
      "bun": "./dist/component-api/component-api.js",
      "import": "./dist/component-api/component-api.js"
    },
    "./context-menu": {
      "types": "./dist/ui/context-menu/context-menu.d.ts",
      "bun": "./dist/context-menu/context-menu.js",
      "import": "./dist/context-menu/context-menu.js"
    },
    "./data-grid": {
      "types": "./dist/ui/data-grid/data-grid.d.ts",
      "bun": "./dist/data-grid/data-grid.js",
      "import": "./dist/data-grid/data-grid.js"
    },
    "./graph-view": {
      "types": "./dist/ui/graph-view/graph-view.d.ts",
      "bun": "./dist/graph-view/graph-view.js",
      "import": "./dist/graph-view/graph-view.js"
    },
    "./json-tree": {
      "types": "./dist/ui/json-tree/json-tree.d.ts",
      "bun": "./dist/json-tree/json-tree.js",
      "import": "./dist/json-tree/json-tree.js"
    },
    "./preview-frame": {
      "types": "./dist/ui/preview-frame/preview-frame.d.ts",
      "bun": "./dist/preview-frame/preview-frame.js",
      "import": "./dist/preview-frame/preview-frame.js"
    },
    "./split-pane": {
      "types": "./dist/ui/split-pane/split-pane.d.ts",
      "bun": "./dist/split-pane/split-pane.js",
      "import": "./dist/split-pane/split-pane.js"
    },
    "./overlays": {
      "types": "./dist/utils/overlays.d.ts",
      "bun": "./dist/overlays/overlays.js",
      "import": "./dist/overlays/overlays.js"
    }
  },
  "module": "./dist/index.js",
  "browser": {
    "ts-syntax-highlighter": false
  },
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist",
    "src",
    "stx-plugin.ts"
  ],
  "scripts": {
    "build": "bun --bun build.ts",
    "dev": "bun --bun build.ts --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun x --bun pickier lint",
    "lint:fix": "bun x --bun pickier lint --fix",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@iconify-json/f7": "^1.2.2",
    "@stacksjs/ts-css": "^0.3.11",
    "@stacksjs/stx": "workspace:*",
    "bun-plugin-stx": "workspace:*",
    "ts-syntax-highlighter": "^0.2.20",
    "ts-video-player": "^0.1.11"
  },
  "devDependencies": {
    "better-dx": "^0.2.38"
  }
}
