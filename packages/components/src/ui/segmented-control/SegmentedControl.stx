<script server>
/*
 * A segmented control: a few mutually exclusive choices in one track, the
 * chosen one raised. The control iOS draws as UISegmentedControl and a phone
 * app reaches for whenever a list has two to five ways to be shown.
 *
 * It is what applications kept drawing for themselves. One app copied the
 * same track-and-segment markup into ten native screens and a stylesheet; the
 * other drew seven by hand on the web, each with its own roles, and on native
 * had none at all - a "Change the filter" button that cycled through the
 * choices one tap at a time, so nobody could see what the others were.
 *
 * The same source renders on both targets. Each segment is a button with
 * `aria-pressed`, inside a labelled group, which is what a toggle set is
 * (a radio group would promise arrow-key roving the segments do not need,
 * and tabs would promise panels). On a phone the host announces the chosen
 * segment as selected, from the same attribute.
 *
 *   <SegmentedControl v-model:value="period" label="Period" stretch
 *     :options="[{ value: 'week', label: 'This week' }, { value: 'all', label: 'All time' }]" />
 *
 * `options` takes strings or `{ value, label, accessibilityLabel?, disabled? }`;
 * it is reactive,
 * so a label carrying a count can change in place. The selection is a
 * `v-model:value`, or `:value` with `@change`, which receives the new value.
 * `testID` names the group, and each segment is `<testID>-<value>`.
 *
 * Use `size="lg"` for a 44px touch target, including the platform control.
 *
 * Colour and shape come from roles, so an app restyles it without touching
 * it: the track is `surface-sunken`, the chosen segment `panel` (one step
 * lighter than the track in dark mode, as iOS draws it), the words `fg` and
 * `fg-muted`, and both corners `rounded-control` - a pill-shaped app gets a
 * pill track by setting that one role.
 */
export const value = $props.value ?? ''
export const options = $props.options || []
export const label = $props.label || ''
export const stretch = $bool($props.stretch)
export const disabled = $bool($props.disabled)
export const size = $props.size === 'sm' ? 'sm' : $props.size === 'lg' ? 'lg' : 'md'
export const testID = $props.testID || ''
export const className = $props.className || ''
/*
 * `variant="mac"` draws the segmented control a Mac draws: a 24px capsule
 * track with the chosen segment raised in it. The buttons, `aria-pressed` and
 * the events are the ones below; only the classes change, to
 * `stx-mac-segmented`, which this file's <style> block draws from the
 * `--stx-mac-*` tokens. It has one size, so `size` is not read.
 */
export const mac = $props.variant === 'mac' && !$native

const sizeClasses = {
  sm: { segment: 'min-h-[28px] px-2.5 py-1', text: 'text-[13px]' },
  md: { segment: 'min-h-[32px] px-3 py-1.5', text: 'text-[13px]' },
  lg: { segment: 'min-h-[44px] px-3 py-2', text: 'text-[13px]' },
}
// Stretched segments share the track evenly, so their side padding comes out
// of each label's width: iOS keeps it small, or "Breakfast" in four quarters
// of a phone broke in two ("Breakfa / st").
const stretchedPadding = { sm: 'px-1', md: 'px-1.5', lg: 'px-1.5' }
export const sizing = sizeClasses[size]

// A block flex box already fills its column, so `stretch` needs no `w-full` -
// which beside a margin (`mx-4`) ran the track off the screen's edge.
const segmentSizing = stretch ? sizing.segment.replace(/\bpx-\S+/, stretchedPadding[size]) : sizing.segment
/*
 * On a native host ($native) the track and segments are UISegmentedControl's
 * own: a translucent grey track with 9pt corners, the chosen segment raised
 * white (#636366 in dark) with 7pt corners, every label in the label colour
 * and the chosen one semibold.
 */
export const trackClasses = $native
  ? `${stretch ? 'flex' : 'self-start'} flex-row gap-0.5 p-0.5 rounded-[9px] bg-[#767680]/12 dark:bg-[#767680]/24 ${className}`.replace(/\s+/g, ' ').trim()
  : mac
    ? `stx-mac-segmented ${stretch ? 'stx-mac-segmented-stretch' : ''} ${className}`.replace(/\s+/g, ' ').trim()
    : `${stretch ? 'flex' : 'inline-flex'} flex-row gap-0.5 p-0.5 rounded-control bg-surface-sunken ${className}`.replace(/\s+/g, ' ').trim()
export const segmentBase = $native
  ? `${stretch ? 'flex-1 min-w-0' : ''} items-center justify-center rounded-[7px] ${segmentSizing}`.replace(/\s+/g, ' ').trim()
  : `${stretch ? 'flex-1 min-w-0' : ''} items-center justify-center rounded-control transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${segmentSizing}`.replace(/\s+/g, ' ').trim()
export const segmentOn = $native ? 'bg-[#ffffff] dark:bg-[#636366] shadow-sm' : 'bg-panel dark:bg-neutral-600 shadow-sm'
export const segmentOff = $native ? 'opacity-50' : 'opacity-50 cursor-not-allowed'
export const labelOn = $native ? 'font-semibold text-[#000000] dark:text-[#ffffff]' : 'font-semibold text-fg'
export const labelOff = $native ? 'font-medium text-[#000000] dark:text-[#ffffff]' : 'font-medium text-fg-muted'
</script>

<script client>
const emit = defineEmits(['change'])
// Reactive, so a translated or counted name (`:label="t('range')"`) still names the group.
const groupLabel = useReactiveProp('label', {{ label }})
const selected = useModel('value', { default: {{ value }}, parse: v => v == null ? '' : String(v) })
const choices = useReactiveProp('options', {{ options }})
const isDisabled = useReactiveProp('disabled', {{ disabled }})
const segmentBase = {{ segmentBase }}
const textSize = {{ sizing.text }}
const groupID = {{ testID }}
const nativeSegments = typeof craft !== 'undefined' && craft.capabilities.nativePlatformControls === true
const segmentOn = {{ segmentOn }}
const segmentOff = {{ segmentOff }}
const labelOn = {{ labelOn }}
const labelOff = {{ labelOff }}
// The Mac look is drawn from `aria-pressed` and `disabled` in the stylesheet,
// so a segment's class does not change with its state.
const macLook = {{ mac }}

/** A choice as `{ value, label, disabled }`, whichever way it was written. */
function normalise(choice) {
  if (choice !== null && typeof choice === 'object') {
    const value = choice.value == null ? '' : String(choice.value)
    const label = choice.label == null ? value : String(choice.label)
    // What a reader hears, when the words on the segment are not enough:
    // "3" on a segment of day counts is "3 days" aloud.
    const spoken = choice.accessibilityLabel == null ? label : String(choice.accessibilityLabel)
    return { value, label, spoken, disabled: choice.disabled === true }
  }
  const value = choice == null ? '' : String(choice)
  return { value, label: value, spoken: value, disabled: false }
}

function segments() {
  const list = choices()
  return Array.isArray(list) ? list.map(normalise) : []
}

function isOn(segment) {
  return segment.value === selected()
}

function isOff(segment) {
  return isDisabled() || segment.disabled
}

function choose(segment) {
  if (isOff(segment) || isOn(segment)) return
  selected.set(segment.value)
  emit('change', segment.value)
}

function onNativeChange(event) {
  const value = event.value ?? event.nativeEvent?.value
  const segment = segments().find(choice => choice.value === value)
  if (segment) choose(segment)
}

function segmentClasses(segment) {
  if (macLook) return 'stx-mac-segment'
  const state = isOn(segment) ? segmentOn : 'bg-transparent'
  return `${segmentBase} ${state} ${isOff(segment) ? segmentOff : 'cursor-pointer'}`
}

function labelClasses(segment) {
  if (macLook) return 'stx-mac-segment-label'
  return `${textSize} ${isOn(segment) ? labelOn : labelOff}`
}

function segmentID(segment) {
  return groupID ? `${groupID}-${segment.value}` : ''
}

defineExpose({ selected })
</script>

@if($native)
<div :if="nativeSegments" data-native="SegmentedControl" data-stx-native-host-root data-stx-segmented-control
  @if(testID)testID="{{ testID }}"@endif
  :items="segments()" :value="selected()" :disabled="isDisabled()"
  :aria-label="groupLabel() || null"
  class="{{ size === 'lg' ? 'min-h-[44px]' : 'min-h-[32px]' }} text-fg {{ stretch ? '' : 'self-start' }} {{ className }}"
  @change="onNativeChange($event)"
></div>
@endif
<div
  @if($native):if="!nativeSegments"@endif
  role="group"
  @if(label)aria-label="{{ label }}"@endif
  :aria-label="groupLabel() || null"
  @if(testID)testID="{{ testID }}"@endif
  class="{{ trackClasses }}"
  data-stx-segmented-control
>
  <button
    :for="segment in segments()"
    :key="segment.value"
    type="button"
    :testID="segmentID(segment)"
    :aria-label="segment.spoken"
    :aria-pressed="isOn(segment) ? 'true' : 'false'"
    :aria-disabled="isOff(segment) ? 'true' : 'false'"
    :disabled="isOff(segment)"
    :class="segmentClasses(segment)"
    @click="choose(segment)"
  ><span class="truncate" :class="labelClasses(segment)" :text="segment.label"></span></button>
</div>

<style data-native-exclude>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
  --stx-mac-font-size: 13px;
  --stx-mac-font-size-small: 11px;
  --stx-mac-hairline: 0.5px;
  --stx-mac-focus-ring: 0 0 0 3px color-mix(in srgb, var(--stx-mac-accent) 35%, transparent);
  --stx-mac-card-radius: 12px;
  --stx-mac-control-radius: 6px;
  --stx-mac-row-height: 38px;
  --stx-mac-row-inset: 10px;
  --stx-mac-sidebar-width: 226px;
  --stx-mac-accent: var(--stx-accent, #007aff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(0, 0, 0, 0.85);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-tertiary: rgba(0, 0, 0, 0.26);
  --stx-mac-window: #ffffff;
  --stx-mac-sidebar: #f2f1f0;
  --stx-mac-card: rgba(0, 0, 0, 0.04);
  --stx-mac-separator: rgba(0, 0, 0, 0.1);
  --stx-mac-hover: rgba(0, 0, 0, 0.05);
  --stx-mac-selection-inactive: rgba(0, 0, 0, 0.08);
  --stx-mac-well: rgba(0, 0, 0, 0.07);
  --stx-mac-control: #ffffff;
  --stx-mac-control-line: rgba(0, 0, 0, 0.12);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  --stx-mac-switch-on: #34c759;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff3b30;
}
:where(.dark) {
  --stx-mac-accent: var(--stx-accent, #0a84ff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(255, 255, 255, 0.85);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.55);
  --stx-mac-ink-tertiary: rgba(255, 255, 255, 0.25);
  --stx-mac-window: #1e1e1e;
  --stx-mac-sidebar: #2a2a2a;
  --stx-mac-card: rgba(255, 255, 255, 0.05);
  --stx-mac-separator: rgba(255, 255, 255, 0.1);
  --stx-mac-hover: rgba(255, 255, 255, 0.06);
  --stx-mac-selection-inactive: rgba(255, 255, 255, 0.1);
  --stx-mac-well: rgba(255, 255, 255, 0.1);
  --stx-mac-control: rgba(255, 255, 255, 0.14);
  --stx-mac-control-line: rgba(255, 255, 255, 0.06);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.4), inset 0 0.5px 0 rgba(255, 255, 255, 0.12);
  --stx-mac-switch-on: #30d158;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff453a;
}
@media (max-resolution: 1.5dppx) {
:where(:root) {
  --stx-mac-hairline: 1px;
}
}
@media (prefers-contrast: more) {
:where(:root) {
  --stx-mac-separator: rgba(0, 0, 0, 0.4);
  --stx-mac-control-line: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.75);
  --stx-mac-hairline: 1px;
}
:where(.dark) {
  --stx-mac-separator: rgba(255, 255, 255, 0.45);
  --stx-mac-control-line: rgba(255, 255, 255, 0.5);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.8);
}
}

.stx-mac-segmented {
  display: inline-flex;
  box-sizing: border-box;
  height: 24px;
  padding: 2px;
  border-radius: 12px;
  background: var(--stx-mac-well);
  font-family: var(--stx-mac-font);
  font-size: var(--stx-mac-font-size);
  letter-spacing: -0.08px;
  -webkit-font-smoothing: antialiased;
  color: var(--stx-mac-ink);
  cursor: default;
  -webkit-user-select: none;
  user-select: none;
}

.stx-mac-segmented-stretch {
  display: flex;
}

.stx-mac-segment {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 20px;
  margin: 0;
  padding: 0 10px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  -webkit-appearance: none;
  appearance: none;
  cursor: default;
  outline: none;
  transition: background-color 150ms ease, box-shadow 150ms ease;
}

.stx-mac-segmented-stretch .stx-mac-segment {
  flex: 1 1 0;
}

.stx-mac-segment[aria-pressed='true'] {
  background: var(--stx-mac-control);
  box-shadow: var(--stx-mac-control-shadow);
}

.stx-mac-segment:focus-visible {
  box-shadow: var(--stx-mac-focus-ring);
}

.stx-mac-segment[aria-pressed='true']:focus-visible {
  box-shadow: var(--stx-mac-control-shadow), var(--stx-mac-focus-ring);
}

.stx-mac-segment:disabled {
  opacity: 0.5;
}

.stx-mac-segment-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .stx-mac-segment {
    transition: none;
  }
}

@media (prefers-contrast: more) {
  .stx-mac-segmented {
    box-shadow: inset 0 0 0 1px var(--stx-mac-control-line);
  }
}
</style>
