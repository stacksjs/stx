<script server cache>
export const variant = $props.variant || 'primary'
/*
 * `appearance="mac"` draws the push button a Mac draws: 22px tall, a capsule,
 * 13px words on a raised face. `variant` already says what a button is FOR
 * here, so the look has a prop of its own, and `variant` keeps meaning intent:
 * `primary` is the accent-filled default button, `danger` the destructive one
 * (red words on the plain face), `ghost` a button with no face until it is
 * pointed at, and anything else, including no variant at all, the plain push
 * button, because on a Mac most buttons are that. It has one size, so `size`
 * is not read. The <button>, its events and its states are the ones below;
 * only the classes change, to `stx-mac-button`, which this file's <style>
 * block draws from the `--stx-mac-*` tokens.
 */
export const mac = $props.appearance === 'mac'
const macIntents = { primary: 'primary', danger: 'destructive', ghost: 'plain' }
export const macIntent = macIntents[$props.variant] || 'default'
export const size = $props.size || 'md'
export const disabled = $bool($props.disabled)
export const loading = $bool($props.loading)
export const type = $props.type || 'button'
export const fullWidth = $bool($props.fullWidth)
/*
 * The label, as a prop, for a button whose text changes with its state.
 *
 * "Rotate" -> "Rotating..." is as common as disabling the button, and the slot
 * cannot express it: slot content is the CALLER's markup, interpolated in the
 * caller's scope at render time, so it is a snapshot like `disabled` used to
 * be. `:text` on the component tag is not the answer either - the runtime's
 * text binding writes textContent, which would erase the spinner and the icons
 * this button keeps inside itself.
 *
 * So the reactive spelling is a prop: `<Button :label="rotateLabel()">`. Given
 * one, the button renders it in a span that tracks the parent's binding; given
 * none, the slot behaves exactly as before. See stacksjs/stx#1997.
 */
/**
 * Desktop and native callers name a button's words `title` and its glyph
 * `symbol`, with `iconOnly` meaning "draw the glyph alone". Accepting them is
 * what lets such a call select this component rather than the native
 * primitive (stacksjs/stx#2091).
 *
 * `title` supplies the words ONLY when nothing else does. It is also the web's
 * tooltip attribute, so a caller writing both a tooltip and content keeps
 * both: folding it into the label unconditionally would replace the slot with
 * the tooltip text.
 */
export const symbol = $props.symbol || ''
export const iconOnly = $bool($props.iconOnly)
const slotWords = String($slots?.default ?? '').trim()
const titleWords = !$props.label && !slotWords ? ($props.title || '') : ''
export const label = $props.label || titleWords
export const hasLabel = label !== ''

/*
 * A server-rendered accessible name, for the one case the slot cannot cover.
 *
 * `:label` is client-categorised, so the server cannot see it: a
 * `<Button :label="confirmLabel()" />` with no slot content has no text and no
 * name in the markup actually served, and assistive technology reaching it
 * before hydration finds an unlabelled button. On a destructive confirmation
 * that is the worst case (stacksjs/stx#2034). Slot content is the better
 * answer where there is any, because it is visible as well as announced; this
 * is for a button that has neither.
 */
export const ariaLabel = $props.ariaLabel || $props['aria-label'] || ''
export const leftIcon = $props.leftIcon || ''
export const rightIcon = $props.rightIcon || ''
export const className = $props.className || ''

/*
 * Role tokens, not palette shades, so an app can re-theme the button by
 * meaning rather than by cancelling its classes (stacksjs/stx#1993).
 *
 * `className` was never an escape hatch for this: it is appended last in the
 * class ATTRIBUTE, and attribute order does not decide CSS. `bg-blue-500` and
 * `bg-accent` are both single-class selectors of equal specificity, so the
 * winner is whichever lands later in the generated stylesheet - not something
 * a call site can control.
 *
 * `bg-accent-solid` is `var(--stx-accent-solid, <blue-500>)`, so an app sets
 * one variable and primary buttons follow, dark mode included and with no
 * `dark:` anywhere. The solid/hover/ink triple exists because all three have
 * to move together: a themed fill needs its own hover step, and white text on
 * a light themed fill is unreadable.
 *
 * primary and danger are byte-for-byte the same colours as before. outline
 * moves one shade in light mode (its border and text were blue-500, `accent`
 * is blue-600) and its hover tint one step stronger, because a role for every
 * shade would be a palette with extra steps.
 */
const variantClasses = {
  primary: 'bg-accent-solid hover:bg-accent-solid-hover text-accent-ink shadow-md hover:shadow-lg',
  secondary: 'bg-surface-sunken hover:bg-surface-sunken-hover text-fg',
  outline: 'border-2 border-accent text-accent hover:bg-accent-soft',
  ghost: 'hover:bg-surface-hover text-fg-strong',
  danger: 'bg-danger-solid hover:bg-danger-solid-hover text-danger-ink shadow-md hover:shadow-lg',
}

/*
 * Padding decides the height, with no `h-*` to override it.
 *
 * Each size used to carry a fixed height beside its padding, which meant an app
 * passing its own `py-1.5` got the padding it asked for and the height it did
 * not - and `className` cannot win that fight, because `h-10` and `h-8` are
 * single-class selectors of equal specificity (stacksjs/stx#1993).
 *
 * The fixed heights were also wrong on three of five sizes. Measured against
 * the theme's own line-heights: xs declared 1.75rem around 1.5rem of content,
 * while lg declared 3rem around 3.25rem and xl 3.5rem around 3.75rem - so the
 * two largest sizes had been quietly eating a quarter-rem of their own padding.
 *
 * The padding below reproduces all five declared heights EXACTLY - 1.75, 2,
 * 2.5, 3 and 3.5rem - so nothing changes on screen while the height becomes
 * something a call site can actually set. xs, lg and xl needed a padding step
 * adjusted to land on the same number they claimed before.
 */
const sizeClasses = {
  xs: 'px-2.5 py-1.5 text-xs gap-1',
  sm: 'px-3 py-1.5 text-sm gap-1.5',
  md: 'px-4 py-2 text-base gap-2',
  lg: 'px-6 py-2.5 text-lg gap-2.5',
  xl: 'px-8 py-3.5 text-xl gap-3',
}

const iconSizeClasses = { xs: 'h-3 w-3', sm: 'h-4 w-4', md: 'h-5 w-5', lg: 'h-6 w-6', xl: 'h-7 w-7' }
/*
 * The focus ring follows the accent too. It was `ring-blue-500` with no dark
 * twin, so it stayed blue in a dark theme and in a rose-accented app alike;
 * the token's light value is that same blue-500 and its dark value is a step
 * darker, which is a ring that was missing rather than one that changed.
 */
const baseClasses = 'inline-flex items-center justify-center font-semibold rounded-control transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-panel focus:ring-accent disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none'
const widthClasses = fullWidth ? 'w-full' : ''
export const isDisabled = disabled || loading

export const buttonClasses = `${baseClasses} ${variantClasses[variant] || variantClasses.primary} ${sizeClasses[size] || sizeClasses.md} ${widthClasses} ${className}`.trim()
export const iconClasses = iconSizeClasses[size] || iconSizeClasses.md
export const spinnerClasses = `animate-spin ${iconClasses}`.trim()

/*
 * The button a phone app draws, for a native host ($native): iOS's filled
 * system-blue button for `primary`, its grey-filled tinted one for
 * `secondary`, a plain tinted label for `ghost`, and the system red for
 * `danger`, at the platform's control heights (44pt by default, 50pt for the
 * `lg` button at the end of a flow). The web's hover, shadow and focus ring
 * have nothing to draw on a device; the host dims the button while it is
 * pressed, and `disabled:` dims it while it is off.
 */
const nativeVariants = {
  primary: { box: 'bg-accent-solid', text: 'text-accent-ink' },
  secondary: { box: 'bg-[#767680]/12 dark:bg-[#767680]/24', text: 'text-accent' },
  outline: { box: 'border border-accent', text: 'text-accent' },
  ghost: { box: '', text: 'text-accent' },
  danger: { box: 'bg-danger-solid', text: 'text-danger-ink' },
}
const nativeSizes = {
  xs: { box: 'h-7 px-2.5 gap-1 rounded-[7px]', text: 'text-[13px]' },
  sm: { box: 'h-[34px] px-3 gap-1.5 rounded-[8px]', text: 'text-[15px]' },
  md: { box: 'h-11 px-4 gap-2 rounded-[10px]', text: 'text-[17px]' },
  lg: { box: 'h-[50px] px-5 gap-2 rounded-[12px]', text: 'text-[17px]' },
  xl: { box: 'h-14 px-6 gap-2.5 rounded-[14px]', text: 'text-[19px]' },
}
const nativeVariant = nativeVariants[variant] || nativeVariants.primary
const nativeSize = nativeSizes[size] || nativeSizes.md
export const nativeButtonClasses = `flex-row items-center justify-center ${nativeSize.box} ${nativeVariant.box} disabled:opacity-50 ${fullWidth ? 'w-full' : ''} ${className}`.replace(/\s+/g, ' ').trim()
export const nativeTextClasses = `font-semibold ${nativeSize.text} ${nativeVariant.text}`
export const legacyNativeTint = variant === 'primary' || variant === 'danger' ? '#ffffff' : '#007aff'
export const nativeTintClass = nativeVariant.text
</script>

<script client>
const emit = defineEmits()
const platformControls = typeof craft !== 'undefined' && craft.capabilities.nativePlatformControls === true
const legacyNativeTint = {{ $native ? legacyNativeTint : '' }}

/*
 * `disabled` and `loading` are read as live props, not as a server snapshot.
 *
 * This used to be `const disabledNow = {{ isDisabled }}` — a value computed
 * before the page was sent and never looked at again. So the most common piece
 * of button state in an application could not be expressed:
 *
 *     <Button :disabled="saving()" @click="save">Save</Button>
 *
 * `saving()` is a signal. On the server it is not yet meaningful, so the button
 * shipped enabled and STAYED enabled for the life of the page — through the
 * exact async action it was there to guard. Double submits, destructive
 * deletes and rotate-key confirmations all land on this.
 *
 * useReactiveProp wires the parent's binding into a local signal: the parent's
 * bindAttr writes the attribute on our root, a MutationObserver picks it up,
 * and the signal flips. Dialog already does this for `open` (#1704) and Switch
 * for `checked`, so this is the package's existing answer rather than a new one.
 *
 * See stacksjs/stx#1997.
 */
const labelProp = useReactiveProp('label', {{ label }}, { parse: value => value == null ? '' : String(value) })
// Preserve native Button's text prop when the same shared file is selected.
// Read it as a prop, not a root text binding that would erase icons/spinners.
const textProp = useReactiveProp('text', '', { parse: value => value == null ? '' : String(value) })
const labelText = derived(() => labelProp() || textProp())
const isLoading = useReactiveProp('loading', {{ loading }})
// The accessible name is live too. Read once on the server, a bound one
// (:ariaLabel="action.label" in a row of icon buttons) stayed on the boxless
// scope wrapper and never reached the button, which then had no name at all.
const ariaLabelProp = useReactiveProp('ariaLabel', {{ ariaLabel }}, { parse: value => value == null ? '' : String(value) })
const disabledProp = useReactiveProp('disabled', {{ disabled }})

// Loading implies disabled, the same combination the server computes for the
// initial render, so the two agree before and after hydration.
const isDisabled = derived(() => disabledProp() || isLoading())

function onClick(event) {
  // Read through the signal: a button disabled after render must stop guarding
  // on the live value, not on what was true when the page was built.
  if (isDisabled()) {
    event.preventDefault()
    return
  }
  emit('click', event)
}
</script>

@if($native)
<button
  type="{{ type }}"
  class="{{ nativeButtonClasses }}"
  activeOpacity="0.6"
  @if(symbol)symbol="{{ symbol }}"@endif
  @if(iconOnly)iconOnly="true"@endif
  @if(isDisabled)disabled@endif
  :disabled="isDisabled()"
  aria-busy="{{ loading ? 'true' : 'false' }}"
  :aria-busy="isLoading() ? 'true' : 'false'"
  @if(ariaLabel)aria-label="{{ ariaLabel }}"@endif
  :aria-label="String(ariaLabelProp() ?? '') || null"
  @click="onClick($event)"
>
  <div data-native="ActivityIndicator" :show="isLoading()" class="{{ nativeTintClass }}" :color="platformControls ? null : legacyNativeTint" role="status"></div>
  @if(leftIcon)
    <span :show="!isLoading()" class="{{ iconClasses }} {{ nativeTextClasses }}">{!! leftIcon !!}</span>
  @endif
  <span :if="!labelText()" class="{{ nativeTextClasses }}"><slot /></span>
  <span :if="labelText()" class="{{ nativeTextClasses }}" :text="labelText()">{{ label }}</span>
  @if(rightIcon)
    <span :show="!isLoading()" class="{{ iconClasses }} {{ nativeTextClasses }}">{!! rightIcon !!}</span>
  @endif
</button>
@elseif(mac)
<button
  type="{{ type }}"
  class="stx-mac-button {{ fullWidth ? 'stx-mac-button-full' : '' }} {{ className }}"
  data-intent="{{ macIntent }}"
  @if(isDisabled)disabled@endif
  :disabled="isDisabled()"
  aria-busy="{{ loading ? 'true' : 'false' }}"
  :aria-busy="isLoading() ? 'true' : 'false'"
  @if(ariaLabel)aria-label="{{ ariaLabel }}"@endif
  :aria-label="String(ariaLabelProp() ?? '') || null"
  @click="onClick($event)"
>
  <span :show="isLoading()" @if(!loading)x-cloak@endif class="stx-mac-button-spinner" aria-hidden="true"></span>

  @if(leftIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="stx-mac-button-icon">{!! leftIcon !!}</span>
  @endif

  {{-- The slot is the label's fallback and the label is decided on the
       client, exactly as in the default look below. --}}
  <span style="display:contents" :if="!labelText()"><slot /></span>

  <span
    :if="labelText()"
    @if(!hasLabel)x-cloak@endif
    :text="labelText()"
  >{{ label }}</span>

  @if(rightIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="stx-mac-button-icon">{!! rightIcon !!}</span>
  @endif
</button>
@else
<button
  type="{{ type }}"
  class="{{ buttonClasses }}"
  @if(isDisabled)disabled@endif
  :disabled="isDisabled()"
  aria-busy="{{ loading ? 'true' : 'false' }}"
  :aria-busy="isLoading() ? 'true' : 'false'"
  @if(ariaLabel)aria-label="{{ ariaLabel }}"@endif
  :aria-label="String(ariaLabelProp() ?? '') || null"
  @click="onClick($event)"
>
  {{-- The spinner is always in the DOM so `loading` can turn it on after render;
       it was inside an @if, which meant the only way to see it was to have been
       loading when the page was built. x-cloak only when the server says we are
       NOT loading, so a button rendered loading shows its spinner on first
       paint rather than waiting for hydration. --}}
  <svg
    :show="isLoading()"
    @if(!loading)x-cloak@endif
    class="{{ spinnerClasses }}"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
  >
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
  </svg>

  @if(leftIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="{{ iconClasses }}">{!! leftIcon !!}</span>
  @endif

  {{-- The slot is the label's FALLBACK, not its sibling (stacksjs/stx#2034).

       A reactive label is invisible to the server, so the only text a
       `<Button :label="confirmLabel()">Confirm</Button>` can serve is the slot
       content -- and it used to render it NEXT TO the label span, so once
       labelText() resolved the button read "ConfirmDelete project". An author
       had to choose between a server-rendered accessible name and a reactive
       one, which is why the reporting app kept a plain <button>.

       Wrapped rather than put on the slot itself: `<slot :if="...">` does not
       work, because the slot is replaced by the caller's markup at render time
       and the attribute goes with it. display:contents so the wrapper is not a
       box -- slot children stay direct flex items of the button, so the gap
       between them is unchanged.

       `:if` rather than `:show` for the same reason: `:show` writes
       style.display, which would fight the display:contents this needs. --}}
  <span style="display:contents" :if="!labelText()"><slot /></span>

  {{-- The label span is decided on the CLIENT, because the server cannot see a
       reactive prop at all: `:label="rotateLabel()"` is categorised as client
       reactive, so `$props.label` is undefined during render and only the
       root's data-stx-parent-bindings records that a binding exists.

       `:if` rather than always rendering it, because the button is a flex
       container with a gap: an empty span is still a flex item and would add a
       trailing gap to every button that uses the slot. x-cloak while the
       server has no label, so that gap is not visible for the frame before
       hydration - the same pairing the spinner above uses. --}}
  <span
    :if="labelText()"
    @if(!hasLabel)x-cloak@endif
    :text="labelText()"
  >{{ label }}</span>

  @if(rightIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="{{ iconClasses }}">{!! rightIcon !!}</span>
  @endif
</button>
@endif

<style data-native-exclude>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
  --stx-mac-font-size: 13px;
  --stx-mac-font-size-small: 11px;
  --stx-mac-hairline: 0.5px;
  --stx-mac-focus-ring: 0 0 0 3px color-mix(in srgb, var(--stx-mac-accent) 35%, transparent);
  --stx-mac-card-radius: 12px;
  --stx-mac-control-radius: 6px;
  --stx-mac-row-height: 38px;
  --stx-mac-row-inset: 10px;
  --stx-mac-sidebar-width: 226px;
  --stx-mac-accent: var(--stx-accent, rgb(0, 122, 255));
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(0, 0, 0, 0.85);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-tertiary: rgba(0, 0, 0, 0.26);
  --stx-mac-window: #ffffff;
  --stx-mac-sidebar: #f2f1f0;
  --stx-mac-card: rgba(0, 0, 0, 0.04);
  --stx-mac-separator: rgba(0, 0, 0, 0.1);
  --stx-mac-hover: rgba(0, 0, 0, 0.05);
  --stx-mac-selection-inactive: rgba(0, 0, 0, 0.08);
  --stx-mac-well: rgba(0, 0, 0, 0.07);
  --stx-mac-control: #ffffff;
  --stx-mac-control-line: rgba(0, 0, 0, 0.12);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  --stx-mac-switch-on: #34c759;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff3b30;
}
:where(.dark) {
  --stx-mac-accent: var(--stx-accent, #0a84ff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(255, 255, 255, 0.85);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.55);
  --stx-mac-ink-tertiary: rgba(255, 255, 255, 0.25);
  --stx-mac-window: #1e1e1e;
  --stx-mac-sidebar: #2a2a2a;
  --stx-mac-card: rgba(255, 255, 255, 0.05);
  --stx-mac-separator: rgba(255, 255, 255, 0.1);
  --stx-mac-hover: rgba(255, 255, 255, 0.06);
  --stx-mac-selection-inactive: rgba(255, 255, 255, 0.1);
  --stx-mac-well: rgba(255, 255, 255, 0.1);
  --stx-mac-control: rgba(255, 255, 255, 0.14);
  --stx-mac-control-line: rgba(255, 255, 255, 0.06);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.4), inset 0 0.5px 0 rgba(255, 255, 255, 0.12);
  --stx-mac-switch-on: #30d158;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff453a;
}
@media (max-resolution: 1.5dppx) {
:where(:root) {
  --stx-mac-hairline: 1px;
}
}
@media (prefers-contrast: more) {
:where(:root) {
  --stx-mac-separator: rgba(0, 0, 0, 0.4);
  --stx-mac-control-line: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.75);
  --stx-mac-hairline: 1px;
}
:where(.dark) {
  --stx-mac-separator: rgba(255, 255, 255, 0.45);
  --stx-mac-control-line: rgba(255, 255, 255, 0.5);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.8);
}
}

.stx-mac-button {
  --stx-mac-button-pressed: color-mix(in srgb, var(--stx-mac-ink) 8%, transparent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  box-sizing: border-box;
  height: 22px;
  margin: 0;
  padding: 0 12px;
  border: 0;
  border-radius: 11px;
  background-color: var(--stx-mac-control);
  box-shadow: var(--stx-mac-control-shadow);
  line-height: 16px;
  white-space: nowrap;
  -webkit-appearance: none;
  appearance: none;
  outline: none;
  transition: background-color 150ms ease, box-shadow 150ms ease, filter 150ms ease;
  font-family: var(--stx-mac-font);
  font-size: var(--stx-mac-font-size);
  letter-spacing: -0.08px;
  -webkit-font-smoothing: antialiased;
  color: var(--stx-mac-ink);
  cursor: default;
  -webkit-user-select: none;
  user-select: none;
}

.stx-mac-button-full {
  display: flex;
  width: 100%;
}

.stx-mac-button:active:not(:disabled) {
  background-image: linear-gradient(var(--stx-mac-button-pressed), var(--stx-mac-button-pressed));
}

.stx-mac-button[data-intent='primary'] {
  background-color: var(--stx-mac-accent);
  box-shadow: none;
  color: var(--stx-mac-accent-ink);
}

.stx-mac-button[data-intent='primary']:active:not(:disabled) {
  background-image: none;
  filter: brightness(0.9);
}

.stx-mac-button[data-intent='destructive'] {
  color: var(--stx-mac-danger);
}

.stx-mac-button[data-intent='plain'] {
  background-color: transparent;
  box-shadow: none;
}

.stx-mac-button[data-intent='plain']:hover:not(:disabled) {
  background-color: var(--stx-mac-hover);
}

.stx-mac-button:focus-visible {
  box-shadow: var(--stx-mac-control-shadow), var(--stx-mac-focus-ring);
}

.stx-mac-button[data-intent='primary']:focus-visible,
.stx-mac-button[data-intent='plain']:focus-visible {
  box-shadow: var(--stx-mac-focus-ring);
}

.stx-mac-button:disabled {
  opacity: 0.5;
}

.stx-mac-button-icon {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 13px;
  height: 13px;
}

.stx-mac-button-spinner {
  flex: none;
  box-sizing: border-box;
  width: 12px;
  height: 12px;
  border: 1.5px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: stx-mac-button-spin 0.7s linear infinite;
}

@keyframes stx-mac-button-spin {
  to {
    transform: rotate(360deg);
  }
}

/* A window that is not the key window gives up its default button's colour. */
:where([data-stx-window-active='false']) .stx-mac-button[data-intent='primary'],
:root[data-craft-window-active='false'] .stx-mac-button[data-intent='primary'] {
  background-color: var(--stx-mac-control);
  box-shadow: var(--stx-mac-control-shadow);
  color: var(--stx-mac-ink);
}

@media (prefers-reduced-motion: reduce) {
  .stx-mac-button {
    transition: none;
  }

  .stx-mac-button-spinner {
    animation-duration: 2.4s;
  }
}

@media (prefers-contrast: more) {
  .stx-mac-button:not([data-intent='primary']) {
    box-shadow: inset 0 0 0 1px var(--stx-mac-control-line);
  }

  .stx-mac-button:not([data-intent='primary']):focus-visible {
    box-shadow: inset 0 0 0 1px var(--stx-mac-control-line), var(--stx-mac-focus-ring);
  }
}
</style>
