<script server cache>
export const variant = $props.variant || 'primary'
export const size = $props.size || 'md'
export const disabled = $bool($props.disabled)
export const loading = $bool($props.loading)
export const type = $props.type || 'button'
export const fullWidth = $bool($props.fullWidth)
/*
 * The label, as a prop, for a button whose text changes with its state.
 *
 * "Rotate" -> "Rotating..." is as common as disabling the button, and the slot
 * cannot express it: slot content is the CALLER's markup, interpolated in the
 * caller's scope at render time, so it is a snapshot like `disabled` used to
 * be. `:text` on the component tag is not the answer either - the runtime's
 * text binding writes textContent, which would erase the spinner and the icons
 * this button keeps inside itself.
 *
 * So the reactive spelling is a prop: `<Button :label="rotateLabel()">`. Given
 * one, the button renders it in a span that tracks the parent's binding; given
 * none, the slot behaves exactly as before. See stacksjs/stx#1997.
 */
export const label = $props.label || ''
export const hasLabel = label !== ''
export const leftIcon = $props.leftIcon || ''
export const rightIcon = $props.rightIcon || ''
export const className = $props.className || ''

/*
 * Role tokens, not palette shades, so an app can re-theme the button by
 * meaning rather than by cancelling its classes (stacksjs/stx#1993).
 *
 * `className` was never an escape hatch for this: it is appended last in the
 * class ATTRIBUTE, and attribute order does not decide CSS. `bg-blue-500` and
 * `bg-accent` are both single-class selectors of equal specificity, so the
 * winner is whichever lands later in the generated stylesheet - not something
 * a call site can control.
 *
 * `bg-accent-solid` is `var(--stx-accent-solid, <blue-500>)`, so an app sets
 * one variable and primary buttons follow, dark mode included and with no
 * `dark:` anywhere. The solid/hover/ink triple exists because all three have
 * to move together: a themed fill needs its own hover step, and white text on
 * a light themed fill is unreadable.
 *
 * primary and danger are byte-for-byte the same colours as before. outline
 * moves one shade in light mode (its border and text were blue-500, `accent`
 * is blue-600) and its hover tint one step stronger, because a role for every
 * shade would be a palette with extra steps.
 */
const variantClasses = {
  primary: 'bg-accent-solid hover:bg-accent-solid-hover text-accent-ink shadow-md hover:shadow-lg',
  secondary: 'bg-surface-sunken hover:bg-surface-sunken-hover text-fg',
  outline: 'border-2 border-accent text-accent hover:bg-accent-soft',
  ghost: 'hover:bg-surface-hover text-fg-strong',
  danger: 'bg-danger-solid hover:bg-danger-solid-hover text-danger-ink shadow-md hover:shadow-lg',
}

/*
 * Padding decides the height, with no `h-*` to override it.
 *
 * Each size used to carry a fixed height beside its padding, which meant an app
 * passing its own `py-1.5` got the padding it asked for and the height it did
 * not - and `className` cannot win that fight, because `h-10` and `h-8` are
 * single-class selectors of equal specificity (stacksjs/stx#1993).
 *
 * The fixed heights were also wrong on three of five sizes. Measured against
 * the theme's own line-heights: xs declared 1.75rem around 1.5rem of content,
 * while lg declared 3rem around 3.25rem and xl 3.5rem around 3.75rem - so the
 * two largest sizes had been quietly eating a quarter-rem of their own padding.
 *
 * The padding below reproduces all five declared heights EXACTLY - 1.75, 2,
 * 2.5, 3 and 3.5rem - so nothing changes on screen while the height becomes
 * something a call site can actually set. xs, lg and xl needed a padding step
 * adjusted to land on the same number they claimed before.
 */
const sizeClasses = {
  xs: 'px-2.5 py-1.5 text-xs gap-1',
  sm: 'px-3 py-1.5 text-sm gap-1.5',
  md: 'px-4 py-2 text-base gap-2',
  lg: 'px-6 py-2.5 text-lg gap-2.5',
  xl: 'px-8 py-3.5 text-xl gap-3',
}

const iconSizeClasses = { xs: 'h-3 w-3', sm: 'h-4 w-4', md: 'h-5 w-5', lg: 'h-6 w-6', xl: 'h-7 w-7' }
/*
 * The focus ring follows the accent too. It was `ring-blue-500` with no dark
 * twin, so it stayed blue in a dark theme and in a rose-accented app alike;
 * the token's light value is that same blue-500 and its dark value is a step
 * darker, which is a ring that was missing rather than one that changed.
 */
const baseClasses = 'inline-flex items-center justify-center font-semibold rounded-control transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-panel focus:ring-accent disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none'
const widthClasses = fullWidth ? 'w-full' : ''
export const isDisabled = disabled || loading

export const buttonClasses = `${baseClasses} ${variantClasses[variant] || variantClasses.primary} ${sizeClasses[size] || sizeClasses.md} ${widthClasses} ${className}`.trim()
export const iconClasses = iconSizeClasses[size] || iconSizeClasses.md
export const spinnerClasses = `animate-spin ${iconClasses}`.trim()
</script>

<script client>
const emit = defineEmits()

/*
 * `disabled` and `loading` are read as live props, not as a server snapshot.
 *
 * This used to be `const disabledNow = {{ isDisabled }}` — a value computed
 * before the page was sent and never looked at again. So the most common piece
 * of button state in an application could not be expressed:
 *
 *     <Button :disabled="saving()" @click="save">Save</Button>
 *
 * `saving()` is a signal. On the server it is not yet meaningful, so the button
 * shipped enabled and STAYED enabled for the life of the page — through the
 * exact async action it was there to guard. Double submits, destructive
 * deletes and rotate-key confirmations all land on this.
 *
 * useReactiveProp wires the parent's binding into a local signal: the parent's
 * bindAttr writes the attribute on our root, a MutationObserver picks it up,
 * and the signal flips. Dialog already does this for `open` (#1704) and Switch
 * for `checked`, so this is the package's existing answer rather than a new one.
 *
 * See stacksjs/stx#1997.
 */
const labelText = useReactiveProp('label', {{ label }}, { parse: value => value == null ? '' : String(value) })
const isLoading = useReactiveProp('loading', {{ loading }})
const disabledProp = useReactiveProp('disabled', {{ disabled }})

// Loading implies disabled, the same combination the server computes for the
// initial render, so the two agree before and after hydration.
const isDisabled = derived(() => disabledProp() || isLoading())

function onClick(event) {
  // Read through the signal: a button disabled after render must stop guarding
  // on the live value, not on what was true when the page was built.
  if (isDisabled()) {
    event.preventDefault()
    return
  }
  emit('click', event)
}
</script>

<button
  type="{{ type }}"
  class="{{ buttonClasses }}"
  @if(isDisabled)disabled@endif
  :disabled="isDisabled()"
  aria-busy="{{ loading ? 'true' : 'false' }}"
  :aria-busy="isLoading() ? 'true' : 'false'"
  @click="onClick($event)"
>
  {{-- The spinner is always in the DOM so `loading` can turn it on after render;
       it was inside an @if, which meant the only way to see it was to have been
       loading when the page was built. x-cloak only when the server says we are
       NOT loading, so a button rendered loading shows its spinner on first
       paint rather than waiting for hydration. --}}
  <svg
    :show="isLoading()"
    @if(!loading)x-cloak@endif
    class="{{ spinnerClasses }}"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
  >
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
  </svg>

  @if(leftIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="{{ iconClasses }}">{!! leftIcon !!}</span>
  @endif

  <slot />

  {{-- The label span is decided on the CLIENT, because the server cannot see a
       reactive prop at all: `:label="rotateLabel()"` is categorised as client
       reactive, so `$props.label` is undefined during render and only the
       root's data-stx-parent-bindings records that a binding exists.

       `:if` rather than always rendering it, because the button is a flex
       container with a gap: an empty span is still a flex item and would add a
       trailing gap to every button that uses the slot. x-cloak while the
       server has no label, so that gap is not visible for the frame before
       hydration - the same pairing the spinner above uses. --}}
  <span
    :if="labelText()"
    @if(!hasLabel)x-cloak@endif
    :text="labelText()"
  >{{ label }}</span>

  @if(rightIcon)
    <span :show="!isLoading()" @if(loading)x-cloak@endif class="{{ iconClasses }}">{!! rightIcon !!}</span>
  @endif
</button>
