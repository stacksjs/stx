<script server>
export const headingText = $props.headingText || 'Two Factor Authentication'
export const labelText = $props.labelText || 'Authentication code'
export const instructionText = $props.instructionText || 'Open your Symantec 2FA app to view your authentication code.'
export const codeLength = $props.codeLength || 6
export const showRecoveryCode = $bool($props.showRecoveryCode, true)
export const className = $props.className || ''

export const containerClasses = `py-32 bg-page ${className}`.trim()
</script>

<script client>
const emit = defineEmits()
const codeLength = {{ codeLength }}

function onCodeInput(event, index) {
  const input = event.target
  const value = input.value
  if (!/^\d*$/.test(value)) {
    input.value = ''
    return
  }
  if (value.length === 1 && index < codeLength - 1) {
    document.getElementById(`code-${index + 1}`)?.focus()
  }
}

function onKeyDown(event, index) {
  if (event.key === 'Backspace' && !event.target.value && index > 0) {
    document.getElementById(`code-${index - 1}`)?.focus()
  }
}

function onSubmit(event) {
  event.preventDefault()
  const code = []
  for (let i = 0; i < codeLength; i++) {
    const input = document.getElementById(`code-${i}`)
    if (input?.value) code.push(input.value)
  }
  if (code.length === codeLength) {
    emit('submit', code.join(''))
  }
  else {
    emit('error', { message: 'Please enter all digits' })
  }
}

function onRecoveryCode(event) {
  event.preventDefault()
  emit('useRecoveryCode')
}
</script>

<div class="{{ containerClasses }}">
  <div class="mx-auto max-w-sm rounded-control px-8 py-4 shadow-md bg-panel">
    <div class="card-body">
      <div>
        <h3 class="text-center text-sm text-fg font-semibold">
          {{ headingText }}
        </h3>
        <label for="code-0" class="mt-4 block text-sm text-fg font-medium leading-6">
          {{ labelText }}
        </label>
        <form @submit="onSubmit($event)">
          <div class="mt-2 flex rounded-control shadow-sm space-x-2">
            @for(let i = 0; i < codeLength; i++)
              <input
                id="code-{{ i }}"
                type="text"
                maxlength="1"
                name="code-{{ i }}"
                placeholder="-"
                class="block w-full border-0 rounded-control px-2 py-2 text-center text-fg ring-1 ring-line-strong ring-inset sm:text-sm placeholder:text-fg-soft sm:leading-6 focus:ring-2 focus:ring-accent focus:ring-inset bg-field"
                @input="onCodeInput($event, {{ i }})"
                @keydown="onKeyDown($event, {{ i }})"
              />
            @endfor
          </div>
          <div class="py-4">
            <button
              type="submit"
              class="relative h-8 w-full flex items-center justify-center rounded-full bg-accent-solid px-4 text-accent-ink font-semibold hover:bg-accent-solid-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
            >
              Verify
            </button>
          </div>
        </form>
        <div>
          <p class="text-xs text-fg-strong font-semibold">
            {{ instructionText }}
          </p>
        </div>
        @if(showRecoveryCode)
          <div class="mt-4">
            <p class="text-xs text-fg-strong font-semibold">
              Having Problems?
            </p>
            <button
              type="button"
              @click="onRecoveryCode($event)"
              class="text-xs text-link hover:underline"
            >
              Use recovery code instead
            </button>
          </div>
        @endif
      </div>
    </div>
  </div>
</div>
