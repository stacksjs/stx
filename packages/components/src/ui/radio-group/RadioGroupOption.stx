<script server>
export const value = $props.value
export const disabled = $bool($props.disabled)
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative flex cursor-pointer rounded-panel px-5 py-4 shadow-md focus:outline-none transition-all bg-panel text-fg focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-panel'
const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : ''
/*
 * `variant="mac"`: the radio button a Mac draws, a 15px circle beside the
 * words. See RadioGroup, which takes the same prop for the group.
 */
export const mac = $props.variant === 'mac'
export const optionClasses = mac
  ? `stx-mac-radio ${className}`.trim()
  : `${baseClasses} ${disabledClasses} ${className}`.trim()
export const valueJson = JSON.stringify(value === undefined ? null : value)
</script>

<script client>
const isDisabled = {{ disabled }}
/*
 * JSON built on the server and emitted raw, rather than a 'null' sentinel
 * through an ordinary interpolation.
 *
 * A `value === undefined ? 'null' : value` ternary was meant to put the bare
 * token null into the script. An interpolation QUOTES a string, so what it
 * emitted was the four-character string "null" -- truthy, in the one place a
 * value is meant to be absent. JSON.stringify produces the correct literal for
 * every type, null included, and raw interpolation passes it through unquoted.
 * Calendar and DateRangePicker already avoid this sentinel and say why
 * (stacksjs/stx#1981).
 */
const optionValue = {!! valueJson !!}

function onClick(event) {
  if (isDisabled) return
  event.currentTarget.dispatchEvent(
    new CustomEvent('stx:radio-select', { bubbles: true, detail: optionValue }),
  )
}

function onKey(event) {
  if (isDisabled) return
  if (event.key === ' ' || event.key === 'Enter') {
    event.preventDefault()
    event.currentTarget.dispatchEvent(
      new CustomEvent('stx:radio-select', { bubbles: true, detail: optionValue }),
    )
  }
}
</script>

<component
  :is="{{ as }}"
  class="{{ optionClasses }}"
  data-stx-radio-option
  data-option-value="{{ valueJson }}"
  role="radio"
  aria-checked="false"
  @if(disabled)aria-disabled="true"@endif
  tabindex="{{ disabled ? '-1' : '0' }}"
  @click="onClick($event)"
  @keydown="onKey($event)"
>
  <slot :disabled="disabled" />
</component>

<style>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
  --stx-mac-font-size: 13px;
  --stx-mac-font-size-small: 11px;
  --stx-mac-hairline: 0.5px;
  --stx-mac-focus-ring: 0 0 0 3px color-mix(in srgb, var(--stx-mac-accent) 35%, transparent);
  --stx-mac-card-radius: 12px;
  --stx-mac-control-radius: 6px;
  --stx-mac-row-height: 38px;
  --stx-mac-row-inset: 10px;
  --stx-mac-sidebar-width: 226px;
  --stx-mac-accent: var(--stx-accent, #007aff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(0, 0, 0, 0.85);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-tertiary: rgba(0, 0, 0, 0.26);
  --stx-mac-window: #ffffff;
  --stx-mac-sidebar: #f2f1f0;
  --stx-mac-card: rgba(0, 0, 0, 0.04);
  --stx-mac-separator: rgba(0, 0, 0, 0.1);
  --stx-mac-hover: rgba(0, 0, 0, 0.05);
  --stx-mac-selection-inactive: rgba(0, 0, 0, 0.08);
  --stx-mac-well: rgba(0, 0, 0, 0.07);
  --stx-mac-control: #ffffff;
  --stx-mac-control-line: rgba(0, 0, 0, 0.12);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  --stx-mac-switch-on: #34c759;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff3b30;
}
:where(.dark) {
  --stx-mac-accent: var(--stx-accent, #0a84ff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(255, 255, 255, 0.85);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.55);
  --stx-mac-ink-tertiary: rgba(255, 255, 255, 0.25);
  --stx-mac-window: #1e1e1e;
  --stx-mac-sidebar: #2a2a2a;
  --stx-mac-card: rgba(255, 255, 255, 0.05);
  --stx-mac-separator: rgba(255, 255, 255, 0.1);
  --stx-mac-hover: rgba(255, 255, 255, 0.06);
  --stx-mac-selection-inactive: rgba(255, 255, 255, 0.1);
  --stx-mac-well: rgba(255, 255, 255, 0.1);
  --stx-mac-control: rgba(255, 255, 255, 0.14);
  --stx-mac-control-line: rgba(255, 255, 255, 0.06);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.4), inset 0 0.5px 0 rgba(255, 255, 255, 0.12);
  --stx-mac-switch-on: #30d158;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff453a;
}
@media (max-resolution: 1.5dppx) {
:where(:root) {
  --stx-mac-hairline: 1px;
}
}
@media (prefers-contrast: more) {
:where(:root) {
  --stx-mac-separator: rgba(0, 0, 0, 0.4);
  --stx-mac-control-line: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.75);
  --stx-mac-hairline: 1px;
}
:where(.dark) {
  --stx-mac-separator: rgba(255, 255, 255, 0.45);
  --stx-mac-control-line: rgba(255, 255, 255, 0.5);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.8);
}
}

[data-stx-radio-option][data-checked="true"] {
  background-color: rgb(30 58 138 / 0.75);
  color: white;
}
.dark [data-stx-radio-option][data-checked="true"] {
  background-color: rgb(30 64 175 / 1);
}

/* The chosen-card fill above is not a Mac radio's: the circle says it. */
.stx-mac-radio.stx-mac-radio[data-stx-radio-option][data-checked='true'] {
  background-color: transparent;
  color: var(--stx-mac-ink);
}

.stx-mac-radio-group {
  display: flex;
  flex-direction: column;
  font-family: var(--stx-mac-font);
  font-size: var(--stx-mac-font-size);
  letter-spacing: -0.08px;
  -webkit-font-smoothing: antialiased;
  color: var(--stx-mac-ink);
  cursor: default;
  -webkit-user-select: none;
  user-select: none;
}

.stx-mac-radio.stx-mac-radio {
  --stx-mac-radio-inactive: color-mix(in srgb, var(--stx-mac-ink) 16%, transparent);
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 8px;
  box-sizing: border-box;
  min-height: 22px;
  padding: 3px 0;
  line-height: 16px;
  background: transparent;
  outline: none;
  font-family: var(--stx-mac-font);
  font-size: var(--stx-mac-font-size);
  letter-spacing: -0.08px;
  -webkit-font-smoothing: antialiased;
  color: var(--stx-mac-ink);
  cursor: default;
  -webkit-user-select: none;
  user-select: none;
}

/* The circle: sunk when off, the accent around a white dot when on. */
.stx-mac-radio::before {
  content: '';
  flex: none;
  box-sizing: border-box;
  width: 15px;
  height: 15px;
  margin-top: 0.5px;
  border-radius: 50%;
  background-color: var(--stx-mac-well);
  transition: background-color 150ms ease;
}

.stx-mac-radio[aria-checked='true']::before {
  background-color: var(--stx-mac-accent);
  background-image: radial-gradient(circle, var(--stx-mac-accent-ink) 0 2.5px, transparent 3px);
}

.stx-mac-radio:focus-visible::before {
  box-shadow: var(--stx-mac-focus-ring);
}

.stx-mac-radio[aria-disabled='true'] {
  opacity: 0.5;
}

.stx-mac-radio-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.stx-mac-radio-description {
  font-size: var(--stx-mac-font-size-small);
  line-height: 14px;
  letter-spacing: 0;
  color: var(--stx-mac-ink-secondary);
}

/* A window that is not the key window draws its controls without colour. */
:where([data-stx-window-active='false']) .stx-mac-radio[aria-checked='true']::before,
:root[data-craft-window-active='false'] .stx-mac-radio[aria-checked='true']::before {
  background-color: var(--stx-mac-radio-inactive);
  background-image: radial-gradient(circle, var(--stx-mac-ink) 0 2.5px, transparent 3px);
}

@media (prefers-reduced-motion: reduce) {
  .stx-mac-radio::before {
    transition: none;
  }
}

@media (prefers-contrast: more) {
  .stx-mac-radio:not([aria-checked='true'])::before {
    box-shadow: inset 0 0 0 1px var(--stx-mac-control-line);
  }
}
</style>
