<script server>
export const value = $props.value
export const disabled = $bool($props.disabled)
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative flex cursor-pointer rounded-panel px-5 py-4 shadow-md focus:outline-none transition-all bg-panel text-fg focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-panel'
const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : ''
export const optionClasses = `${baseClasses} ${disabledClasses} ${className}`.trim()
export const valueJson = JSON.stringify(value === undefined ? null : value)
</script>

<script client>
const isDisabled = {{ disabled }}
/*
 * JSON built on the server and emitted raw, rather than a 'null' sentinel
 * through an ordinary interpolation.
 *
 * A `value === undefined ? 'null' : value` ternary was meant to put the bare
 * token null into the script. An interpolation QUOTES a string, so what it
 * emitted was the four-character string "null" -- truthy, in the one place a
 * value is meant to be absent. JSON.stringify produces the correct literal for
 * every type, null included, and raw interpolation passes it through unquoted.
 * Calendar and DateRangePicker already avoid this sentinel and say why
 * (stacksjs/stx#1981).
 */
const optionValue = {!! valueJson !!}

function onClick(event) {
  if (isDisabled) return
  event.currentTarget.dispatchEvent(
    new CustomEvent('stx:radio-select', { bubbles: true, detail: optionValue }),
  )
}

function onKey(event) {
  if (isDisabled) return
  if (event.key === ' ' || event.key === 'Enter') {
    event.preventDefault()
    event.currentTarget.dispatchEvent(
      new CustomEvent('stx:radio-select', { bubbles: true, detail: optionValue }),
    )
  }
}
</script>

<component
  :is="{{ as }}"
  class="{{ optionClasses }}"
  data-stx-radio-option
  data-option-value="{{ valueJson }}"
  role="radio"
  aria-checked="false"
  @if(disabled)aria-disabled="true"@endif
  tabindex="{{ disabled ? '-1' : '0' }}"
  @click="onClick($event)"
  @keydown="onKey($event)"
>
  <slot :disabled="disabled" />
</component>

<style>
[data-stx-radio-option][data-checked="true"] {
  background-color: rgb(30 58 138 / 0.75);
  color: white;
}
.dark [data-stx-radio-option][data-checked="true"] {
  background-color: rgb(30 64 175 / 1);
}
</style>
