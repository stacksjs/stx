<script server>
/*
 * 29 hand-built empty states across six apps (stacksjs/stx#1981): icon,
 * heading, one line of explanation, optional action. `Card` and `Button` both
 * exist; the composition did not.
 *
 * Low complexity, high repetition - which is exactly why it ends up subtly
 * inconsistent across a suite: everyone writes their own, and the padding, the
 * heading level and the gap all drift.
 */
export const title = $props.title || ''
export const description = $props.description || ''
/*
 * Raw SVG markup, not an icon name. Naming would mean this component owning a
 * registry, and the library's icons are 200k Iconify entries across generated
 * packages - so `<EmptyState>` takes the markup or the `icon` slot and stays
 * out of that decision.
 */
export const icon = $props.icon || ''
export const as = $props.as || 'div'
/** `panel` draws the bordered card; `bare` is for something already in one. */
export const variant = $props.variant === 'bare' ? 'bare' : 'panel'
export const align = $props.align === 'left' ? 'left' : 'center'
export const className = $props.className || ''
export const testID = $props.testID || ''

const panel = variant === 'panel' ? 'bg-panel rounded-panel ring-1 ring-line' : ''
const alignment = align === 'left' ? 'items-start text-left' : 'items-center text-center'
export const rootClasses = `flex flex-col ${alignment} gap-3 px-6 py-12 ${panel} ${className}`.trim()
export const iconWrapClasses = 'flex items-center justify-center h-12 w-12 rounded-full bg-surface-sunken text-fg-soft'
export const titleClasses = 'text-base font-semibold text-fg'
export const descriptionClasses = 'max-w-sm text-sm text-fg-muted'
export const actionClasses = 'mt-2 flex flex-wrap items-center gap-2'
export const hasIcon = icon !== ''
</script>

<script client>
/*
 * The words follow their props after the first paint. They were fixed when the
 * server rendered them, so an app whose empty state names a filter or a count,
 * or speaks the viewer's language, drew the shape itself instead
 * (stacksjs/stx#1981 follow-up).
 */
const heading = useReactiveProp('title', {{ title }})
const explanation = useReactiveProp('description', {{ description }})
</script>

<component :is="{{ as }}" class="{{ rootClasses }}" @if(testID)testID="{{ testID }}"@endif data-stx-empty-state>
  {{-- Only when there is one: an empty state without an icon would otherwise
       carry a floating grey disc. A named slot is not offered because stx
       cannot tell an empty slot from an absent one at render time, so the
       circle would render either way - the prop is the honest shape, and a
       caller wanting a whole <Icon /> composes it with variant="bare". --}}
  @if(hasIcon)
    <div class="{{ iconWrapClasses }}">{!! icon !!}</div>
  @endif

  {{-- Always present and shown by value, so a title that arrives later has a
       node to land in; the server text is the first paint. --}}
  <h3 :show="heading()" :text="heading()" class="{{ titleClasses }}">{{ title }}</h3>
  <p :show="explanation()" :text="explanation()" class="{{ descriptionClasses }}">{{ description }}</p>

  <div class="{{ actionClasses }}">
    <slot />
  </div>
</component>
