<script server>
// Two modes (see stacksjs/stx#1703):
//   1. Legacy prop API — pass `tabs={[{label, content, icon}, …]}` for
//      simple string-content tabs (kept for backward compatibility with
//      existing visual snapshots and consumers).
//   2. Slot API — drop `<TabPanel label="…">` children for arbitrary
//      content (components, forms, tables, etc.). The parent enumerates
//      [data-stx-tab-panel] descendants on mount and builds the tab list
//      dynamically.
export const tabs = $props.tabs || []
export const defaultTab = $num($props.defaultTab) || 0
export const orientation = $props.orientation || 'horizontal'
export const variant = $props.variant || 'line'
export const className = $props.className || ''

/*
 * This tab set's own id, so the ids it mints for slot-mode tabs and panels
 * cannot collide with a second <Tabs> on the same page. Same idiom as Dialog.
 */
export const tabsInstanceId = $uid

const orientationClasses = {
  horizontal: 'flex-col',
  vertical: 'flex-row',
}

const tabListOrientationClasses = {
  horizontal: 'flex-row border-b',
  vertical: 'flex-col border-r',
}

const variantClasses = {
  line: 'border-line',
  pills: 'gap-2 border-0 bg-surface-raised p-1 rounded-panel',
  enclosed: 'border-line',
}

export const containerClasses = `flex ${orientationClasses[orientation] || orientationClasses.horizontal} ${className}`.trim()
/*
 * On a native host ($native) a horizontal strip is the phone's segmented
 * control: a grey track, the selected tab raised (getTabClasses).
 */
export const nativeTabs = $native && orientation !== 'vertical'
// Empty on the web, so its stylesheet never meets them.
export const nativeTabBase = nativeTabs ? 'flex-1 min-h-[30px] px-3 items-center justify-center rounded-[7px]' : ''
export const nativeTabOn = nativeTabs ? 'bg-[#ffffff] dark:bg-[#636366] shadow-sm' : ''
export const tabListClasses = nativeTabs
  ? 'flex-row gap-0.5 p-0.5 rounded-[9px] bg-[#767680]/12 dark:bg-[#767680]/24'
  : `flex ${tabListOrientationClasses[orientation] || tabListOrientationClasses.horizontal} ${variantClasses[variant] || variantClasses.line}`.trim()
export const tabPanelClasses = `p-4 focus:outline-none`.trim()
// True when the parent passes a non-empty `tabs` array — switches to the
// legacy render path, preserving the existing prop-array API.
export const hasPropTabs = Array.isArray(tabs) && tabs.length > 0
</script>

<script client>
const emit = defineEmits()
const tabsInstanceId = {{ tabsInstanceId }}
const tabs = {{ tabs }}
const variant = {{ variant }}
const orientation = {{ orientation }}
const hasPropTabs = {{ hasPropTabs }}
const nativeTabs = {{ nativeTabs }}
const nativeTabBase = {{ nativeTabBase }}
const nativeTabOn = {{ nativeTabOn }}
// useRef takes the NAME the x-ref attribute uses. Called with no
// argument it read $refs[undefined], which nothing ever fills, so
// containerRef.value was null forever - the mount hook found no panels,
// the list stayed empty, and the component rendered nothing.
// stacksjs/stx#1979
const containerRef = useRef('containerRef')
const tree = window.stx._host
const panelKeys = new WeakMap()
let nextPanelKey = 0
let stopObserving = null
// In slot mode, `discoveredTabs` is populated from child <TabPanel> data
// attributes on mount. In prop mode, it mirrors the `tabs` prop so the
// rendering loop works the same in both modes.
const discoveredTabs = state(hasPropTabs ? tabs : [])
const activeTab = state({{ defaultTab }})
/*
 * Whether the mount hook has run.
 *
 * The effect below reaches into the DOM through containerRef, and an effect's
 * first run happens while the setup function is still executing - before
 * hydration has wired x-ref, so containerRef.value is null and the query can
 * only come back empty. Nothing else it reads ever changed afterwards, so it
 * never ran again and the DOM was never touched: every panel kept the hidden
 * attribute it was served with, forever. Reading this makes the effect re-run
 * once the DOM is actually reachable. stacksjs/stx#1979
 */
const mounted = state(false)


function owner(node) {
  for (let current = node; current; current = tree.parent(current)) {
    if (tree.getAttribute(current, 'data-stx-tabs') != null) return current
  }
  return null
}

// Walk [data-stx-tab-panel] descendants of THIS container, not nested Tabs'.
function findOwnPanels() {
  const root = containerRef.value
  if (!root) return []
  return tree.descendants(root).filter(panel =>
    tree.getAttribute(panel, 'data-stx-tab-panel') != null && owner(panel) === root)
}

function syncPanels() {
  const panels = findOwnPanels()
  const previous = discoveredTabs()
  const selectedId = previous[activeTab()]?.panelId
  const list = panels.map(panel => {
    // Keys belong to panel identity, not its current index. Inserting a panel
    // before the selected one must not recreate its tab or change selection.
    if (!panelKeys.has(panel)) panelKeys.set(panel, nextPanelKey++)
    const key = panelKeys.get(panel)
    const panelId = tree.getAttribute(panel, 'id') || `${tabsInstanceId}-panel-${key}`
    const tabId = `${tabsInstanceId}-tab-${key}`
    if (tree.getAttribute(panel, 'id') !== panelId) tree.setAttribute(panel, 'id', panelId)
    if (tree.getAttribute(panel, 'aria-labelledby') !== tabId) tree.setAttribute(panel, 'aria-labelledby', tabId)
    return {
      label: tree.getAttribute(panel, 'data-label') || '',
      icon: tree.getAttribute(panel, 'data-icon') || '',
      panelId,
      tabId,
    }
  })
  // Our own tab loop also changes the child tree. Do not feed those changes
  // back into another render when the discovered panels are unchanged.
  if (list.length === previous.length && list.every((tab, i) =>
    tab.panelId === previous[i].panelId && tab.tabId === previous[i].tabId
    && tab.label === previous[i].label && tab.icon === previous[i].icon)) return
  const retained = list.findIndex(tab => tab.panelId === selectedId)
  batch(() => {
    activeTab.set(retained >= 0 ? retained : Math.max(0, Math.min(activeTab(), list.length - 1)))
    discoveredTabs.set(list)
  })
}

onMount(() => {
  if (hasPropTabs) return
  syncPanels()
  mounted.set(true)
  if (containerRef.value) stopObserving = tree.observeChildren(containerRef.value, syncPanels)
})

onDestroy(() => {
  if (stopObserving) stopObserving()
  stopObserving = null
  mounted.set(false)
})

// In slot mode, toggle each panel's `hidden` attribute as activeTab changes.
// Prop mode is handled inline by the @foreach loop's :show binding below.
effect(() => {
  if (hasPropTabs) return
  if (!mounted()) return
  discoveredTabs()
  const panels = findOwnPanels()
  const idx = activeTab()
  panels.forEach((p, i) => {
    if (i === idx) tree.removeAttribute(p, 'hidden')
    else tree.setAttribute(p, 'hidden', '')
    tree.setVisible(p, i === idx)
  })
})

function selectTab(index) {
  activeTab.set(index)
  const list = discoveredTabs()
  emit('change', { index, tab: list[index] })
}

function isActive(index) {
  return activeTab() === index
}

function getTabClasses(index) {
  const isActiveTab = isActive(index)
  if (nativeTabs)
    return `${nativeTabBase} ${isActiveTab ? nativeTabOn : ''}`
  const base = 'px-4 py-2 font-medium text-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-panel'
  if (variant === 'line') {
    const border = orientation === 'horizontal' ? 'border-b-2' : 'border-r-2'
    return `${base} ${border} ${isActiveTab ? 'border-accent text-accent' : 'border-transparent text-fg-muted hover:text-fg hover:border-line-strong'}`
  }
  if (variant === 'pills') {
    return `${base} rounded-control ${isActiveTab ? 'bg-field text-fg shadow-sm' : 'text-fg-muted hover:text-fg'}`
  }
  if (variant === 'enclosed') {
    const borders = orientation === 'horizontal' ? 'border-t border-l border-r rounded-t-control' : 'border-t border-l border-b rounded-l-control'
    return `${base} ${borders} ${isActiveTab ? 'bg-panel border-line -mb-px' : 'bg-surface border-transparent hover:border-line'}`
  }
  return base
}

function onTabKey(event, index) {
  const tabCount = discoveredTabs().length
  if (!tabCount) return
  let next = index
  if (orientation === 'horizontal') {
    if (event.key === 'ArrowRight') { event.preventDefault(); next = (index + 1) % tabCount }
    else if (event.key === 'ArrowLeft') { event.preventDefault(); next = (index - 1 + tabCount) % tabCount }
  }
  else {
    if (event.key === 'ArrowDown') { event.preventDefault(); next = (index + 1) % tabCount }
    else if (event.key === 'ArrowUp') { event.preventDefault(); next = (index - 1 + tabCount) % tabCount }
  }
  if (event.key === 'Home') { event.preventDefault(); next = 0 }
  else if (event.key === 'End') { event.preventDefault(); next = tabCount - 1 }
  if (next !== index) {
    selectTab(next)
    // Both modes number tabs per instance. Search only this component's tree
    // so another tab set cannot receive the focus intended for this one.
    const id = hasPropTabs ? `${tabsInstanceId}-tab-${next}` : discoveredTabs()[next]?.tabId
    const tab = tree.descendants(containerRef.value).find(node => tree.getAttribute(node, 'id') === id)
    if (tab && typeof tab.focus === 'function') tab.focus()
    else if (tab) console.warn('[stx:Tabs] This host cannot move keyboard focus; touch selection is supported. Native focus requires craft-native/craft#373.')
  }
}

defineExpose({ activeTab, selectTab })
</script>

<div x-ref="containerRef" data-stx-tabs class="{{ containerClasses }}">
  <div
    class="{{ tabListClasses }}"
    role="tablist"
    aria-orientation="{{ orientation }}"
  >
    @if(hasPropTabs)
      {{-- Legacy mode: server-side iterate the prop tabs array. Buttons --}}
      {{-- retain their original prop-driven classes and content.        --}}
      @foreach(tab in tabs)
        <button
          type="button"
          :class="getTabClasses({{ $loop.index }})"
          role="tab"
          :aria-selected="isActive({{ $loop.index }}) ? 'true' : 'false'"
          aria-controls="{{ tabsInstanceId }}-panel-{{ $loop.index }}"
          id="{{ tabsInstanceId }}-tab-{{ $loop.index }}"
          :tabindex="isActive({{ $loop.index }}) ? '0' : '-1'"
          @click="selectTab({{ $loop.index }})"
          @keydown="onTabKey($event, {{ $loop.index }})"
        >
          @if(tab.icon)
            <span class="inline-flex items-center gap-2">
              <span x-html="{!! JSON.stringify(tab.icon) !!}"></span>
              <span>{{ tab.label }}</span>
            </span>
          @else
            {{ tab.label }}
          @endif
        </button>
      @endforeach
    @else
      {{-- Slot mode: render the tab list dynamically from --}}
      {{-- discoveredTabs() which is populated in onMount. --}}
      <button
        :for="(tab, idx) in discoveredTabs()"
        :key="tab.tabId"
        type="button"
        x-class="getTabClasses(idx)"
        role="tab"
        :aria-selected="isActive(idx) ? 'true' : 'false'"
        :aria-controls="tab.panelId"
        :id="tab.tabId"
        :tabindex="isActive(idx) ? 0 : -1"
        @click="selectTab(idx)"
        @keydown="onTabKey($event, idx)"
      >
        <span :if="tab.icon" class="inline-flex items-center gap-2" x-html="tab.icon"></span>
        <span :text="tab.label"></span>
      </button>
    @endif
  </div>

  @if(hasPropTabs)
    @foreach(tab in tabs)
      <div
        :show="isActive({{ $loop.index }})"
        id="{{ tabsInstanceId }}-panel-{{ $loop.index }}"
        class="{{ tabPanelClasses }}"
        role="tabpanel"
        aria-labelledby="{{ tabsInstanceId }}-tab-{{ $loop.index }}"
        tabindex="0"
      >
        {!! tab.content !!}
      </div>
    @endforeach
  @else
    <slot />
  @endif
</div>
