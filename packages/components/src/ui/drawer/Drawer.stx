<script server>
export const open = $bool($props.open)
export const position = $props.position || 'right'
export const title = $props.title || ''
/** Set `closeOnEscape="false"` for a drawer that must be answered, not dismissed. */
export const closeOnEscape = $bool($props.closeOnEscape, true)
/** The same, for a click on the backdrop. */
export const closeOnBackdrop = $bool($props.closeOnBackdrop, true)
export const className = $props.className || ''

/*
 * The surface, left to the app.
 *
 * The panel painted itself `bg-panel` and offered no way
 * to say otherwise, so a drawer in an app with its own palette arrived as a
 * white rectangle with the app's colours inside it - the one element on the
 * screen that belongs to no theme. `className` did not help: it lands on the
 * positioned wrapper, which is transparent, while the colour is on the
 * scrolling container within.
 *
 * `panelStyle` rather than only a class because an app whose palette lives in
 * CSS variables has nothing to name in a utility class.
 */
export const panelClass = $props.panelClass || ''
export const panelStyle = $props.panelStyle || ''
export const backdropClass = $props.backdropClass || 'bg-neutral-500/75 dark:bg-neutral-900/75'

const positionClasses = {
  right: 'inset-y-0 right-0 pl-10 sm:pl-16',
  left: 'inset-y-0 left-0 pr-10 sm:pr-16',
  top: 'inset-x-0 top-0 pb-10',
  bottom: 'inset-x-0 bottom-0 pt-10',
}

/*
 * `size` widens a side drawer without the app having to know that the width
 * lives on the wrapper rather than the panel. Ignored for top/bottom, which
 * are constrained by height instead.
 *
 * Spelled out as a map because the class name has to exist as a literal in
 * this file. It was built by interpolation - `max-w-${size}` - which means the
 * string `max-w-xl` appeared nowhere in the source tree, so a content-scanning
 * CSS engine never saw it and emitted no rule for it. The panel then fell back
 * to `w-screen`: full width, the one thing `size` is there to prevent. The
 * default worked, because `'max-w-md'` was a literal in that same expression,
 * so the prop was broken only once you passed it (stacksjs/stx#2002).
 */
export const size = $props.size || 'md'

const widthClasses = {
  xs: 'max-w-xs',
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  full: 'max-w-full',
}

const width = widthClasses[size] || widthClasses.md

const sizeClasses = {
  right: `${width} w-screen`,
  left: `${width} w-screen`,
  top: 'max-h-[90vh] w-full',
  bottom: 'max-h-[90vh] w-full',
}

const closeButtonPosition = {
  right: 'left-0 -ml-8 sm:-ml-10',
  left: 'right-0 -mr-8 sm:-mr-10',
  top: 'right-0 -mr-8',
  bottom: 'right-0 -mr-8',
}

export const containerClasses = `pointer-events-none fixed ${positionClasses[position] || positionClasses.right} flex max-w-full`.trim()
export const panelClasses = `pointer-events-auto relative ${sizeClasses[position] || sizeClasses.right} ${className}`.trim()
export const closeButtonClasses = `absolute top-0 ${closeButtonPosition[position] || closeButtonPosition.right} flex pt-4 pr-2 sm:pr-4`.trim()

/*
 * Which slide-in to run, decided here rather than in the stylesheet.
 *
 * There was one `@keyframes slideIn` whose `from` transform was a mustache
 * over `position`. A component style block is lifted out of the source before
 * expressions run, so that mustache shipped verbatim, the declaration was
 * invalid, and the browser dropped it - leaving an empty 0% frame. The panel
 * did not slide in from its edge, it appeared in place, and nothing reported
 * it (stacksjs/stx#1982). `fadeIn` in the same block was fine, because it had
 * nothing to interpolate.
 *
 * So the four offsets are four static keyframes and the choice is an animation
 * NAME in a style attribute, which is an ordinary attribute and does
 * interpolate.
 */
const slideAnimations = {
  right: 'slideInRight',
  left: 'slideInLeft',
  top: 'slideInTop',
  bottom: 'slideInBottom',
}

export const slideAnimation = slideAnimations[position] || slideAnimations.right

/*
 * This drawer's own id.
 *
 * The focus move looked the panel up with a document-wide query, which finds
 * the first drawer on the page rather than the one that just opened. With two
 * on a page - a cart and the item being added to it - opening the second
 * focused the first, which is hidden, so focus went nowhere and the retry
 * spent its ten frames failing. Same idiom as Dropdown and Popover.
 */
export const drawerInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const drawerInstanceId = {{ drawerInstanceId }}
// useReactiveProp lets the parent drive `open` via signals
// (`:open="drawerOpen()"`) instead of the prop being captured once.
// See stacksjs/stx#1704.
const isOpen = useReactiveProp('open', {{ open }})
const rootRef = useRef('rootRef')
const panelRef = useRef('panelRef')
const mounted = state(false)
onMount(() => mounted.set(true))

const closeOnEscape = {{ closeOnEscape }}
const closeOnBackdrop = {{ closeOnBackdrop }}

function close() {
  isOpen.set(false)
  emit('close')
}

function onBackdropClick() {
  if (closeOnBackdrop && window.stx.overlays.isTop(drawerInstanceId)) close()
}

function panelEl() {
  return panelRef.value
}

/*
 * Open means on the page's overlay stack (window.stx.overlays), shared with
 * Dialog, stxConfirm and the app's own overlays: the page held still from the
 * first overlay to the last, focus moved in and back out, Escape for the
 * topmost only, and Tab trapped in the panel - which this drawer did not do at
 * all before, so Tab walked out of an aria-modal panel into the page behind
 * it. It also bound its own Escape, so one Escape closed a drawer and the
 * dialog over it together (stacksjs/stx#2057).
 */
effect(() => {
  if (!mounted()) return
  if (isOpen()) {
    window.stx.overlays.open(drawerInstanceId, {
      panel: panelEl,
      root: rootRef.value,
      onEscape: closeOnEscape ? close : null,
      onBackdrop: closeOnBackdrop ? close : null,
    })
  }
  else {
    window.stx.overlays.close(drawerInstanceId)
  }
})

onDestroy(() => {
  window.stx.overlays.close(drawerInstanceId)
})

defineExpose({
  open: () => isOpen.set(true),
  close,
  isOpen,
})
</script>

<div x-ref="rootRef" data-native="Modal" data-stx-drawer="{{ drawerInstanceId }}" :show="isOpen()">
  <div
    class="fixed inset-0 z-50 {{ backdropClass }} transition-opacity duration-500"
    style="animation: fadeIn 0.5s ease-in-out"
    aria-hidden="true"
    @click="onBackdropClick()"
  ></div>

  <div class="fixed inset-0 z-50 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="{{ containerClasses }}">
        <div
          class="{{ panelClasses }}"
          style="animation: {{ slideAnimation }} 0.5s ease-in-out"
          data-stx-drawer-panel="{{ drawerInstanceId }}"
          x-ref="panelRef"
          role="dialog"
          aria-modal="true"
          aria-label="{{ title }}"
          tabindex="-1"
        >
          <div class="{{ closeButtonClasses }}">
            <button
              type="button"
              class="relative rounded-control text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              @click="close()"
            >
              <span class="absolute -inset-2.5"></span>
              <span class="sr-only">Close panel</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="relative flex h-full flex-col overflow-y-auto {{ panelClass || 'bg-panel' }} py-6 shadow-xl" style="{{ panelStyle }}">
            @if(title)
              <div class="px-4 sm:px-6">
                <h2 class="text-base font-semibold text-fg">
                  {{ title }}
                </h2>
              </div>
            @endif
            <div class="relative mt-6 flex-1 px-4 sm:px-6">
              <slot />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* One per edge, so nothing in here needs interpolating. A mustache inside a
   component style block is always dead: it is extracted before
   expressions run. */
@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translate(0, 0); }
}

@keyframes slideInLeft {
  from { transform: translateX(-100%); }
  to { transform: translate(0, 0); }
}

@keyframes slideInTop {
  from { transform: translateY(-100%); }
  to { transform: translate(0, 0); }
}

@keyframes slideInBottom {
  from { transform: translateY(100%); }
  to { transform: translate(0, 0); }
}
</style>
