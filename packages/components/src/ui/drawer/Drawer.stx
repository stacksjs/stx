<script server>
export const open = $props.open ?? false
export const position = $props.position || 'right'
export const title = $props.title || ''
export const className = $props.className || ''

/*
 * The surface, left to the app.
 *
 * The panel painted itself `bg-white dark:bg-blue-gray-800` and offered no way
 * to say otherwise, so a drawer in an app with its own palette arrived as a
 * white rectangle with the app's colours inside it - the one element on the
 * screen that belongs to no theme. `className` did not help: it lands on the
 * positioned wrapper, which is transparent, while the colour is on the
 * scrolling container within.
 *
 * `panelStyle` rather than only a class because an app whose palette lives in
 * CSS variables has nothing to name in a utility class.
 */
export const panelClass = $props.panelClass || ''
export const panelStyle = $props.panelStyle || ''
export const backdropClass = $props.backdropClass || 'bg-gray-500/75 dark:bg-gray-900/75'

const positionClasses = {
  right: 'inset-y-0 right-0 pl-10 sm:pl-16',
  left: 'inset-y-0 left-0 pr-10 sm:pr-16',
  top: 'inset-x-0 top-0 pb-10',
  bottom: 'inset-x-0 bottom-0 pt-10',
}

// `size` widens a side drawer without the app having to know that the width
// lives on the wrapper rather than the panel. Ignored for top/bottom, which
// are constrained by height instead.
const width = $props.size ? `max-w-${$props.size}` : 'max-w-md'

const sizeClasses = {
  right: `${width} w-screen`,
  left: `${width} w-screen`,
  top: 'max-h-[90vh] w-full',
  bottom: 'max-h-[90vh] w-full',
}

const closeButtonPosition = {
  right: 'left-0 -ml-8 sm:-ml-10',
  left: 'right-0 -mr-8 sm:-mr-10',
  top: 'right-0 -mr-8',
  bottom: 'right-0 -mr-8',
}

export const containerClasses = `pointer-events-none fixed ${positionClasses[position]} flex max-w-full`.trim()
export const panelClasses = `pointer-events-auto relative ${sizeClasses[position]} ${className}`.trim()
export const closeButtonClasses = `absolute top-0 ${closeButtonPosition[position]} flex pt-4 pr-2 sm:pr-4`.trim()

/*
 * This drawer's own id.
 *
 * The focus move looked the panel up with a document-wide query, which finds
 * the first drawer on the page rather than the one that just opened. With two
 * on a page - a cart and the item being added to it - opening the second
 * focused the first, which is hidden, so focus went nowhere and the retry
 * spent its ten frames failing. Same idiom as Dropdown and Popover.
 */
export const drawerInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const drawerInstanceId = {{ drawerInstanceId }}
// useReactiveProp lets the parent drive `open` via signals
// (`:open="drawerOpen()"`) instead of the prop being captured once.
// See stacksjs/stx#1704.
const isOpen = useReactiveProp('open', {{ open }})

function close() {
  isOpen.set(false)
  emit('close')
}

function onBackdropClick() {
  close()
}

function onPanelKey(event) {
  if (event.key === 'Escape') close()
}

/*
 * Escape closes it from anywhere, not just from inside the panel.
 *
 * The keydown handler on the panel only fires when focus is already in it, and
 * opening a drawer does not move focus - so the very first Escape, pressed
 * while focus is still on whatever opened it, did nothing. Bound on the
 * document instead, and only while open.
 */
function onDocumentKey(event) {
  if (event.key === 'Escape' && isOpen()) close()
}

/*
 * Hold the page still behind the drawer.
 *
 * Without this the page scrolls under an open drawer, which on a phone means a
 * drag inside the cart scrolls the restaurant behind it and the cart stays
 * put. The scrollbar's width is replaced as padding so the page does not jump
 * sideways when it disappears.
 */
let restoreScroll = null

function lockScroll() {
  if (restoreScroll) return

  const gap = window.innerWidth - document.documentElement.clientWidth
  const previous = { overflow: document.body.style.overflow, paddingRight: document.body.style.paddingRight }

  document.body.style.overflow = 'hidden'
  if (gap > 0) document.body.style.paddingRight = `${gap}px`

  restoreScroll = () => {
    document.body.style.overflow = previous.overflow
    document.body.style.paddingRight = previous.paddingRight
    restoreScroll = null
  }
}

function unlockScroll() {
  if (restoreScroll) restoreScroll()
}

/*
 * Focus moves in on open and back on close.
 *
 * A drawer that leaves focus behind is unreachable by keyboard: Tab walks the
 * page underneath it, and a screen reader never learns anything opened. Focus
 * returns to whatever opened it on the way out, so closing does not dump the
 * user at the top of the document.
 */
let opener = null

/*
 * Retried across frames, because focus is refused before the panel is shown.
 *
 * `:show` toggles the drawer's display, and that has not happened yet on the
 * frame the effect runs: `focus()` on a `display: none` element is a silent
 * no-op, so a single attempt left focus on the body every time. Nothing
 * throws, and the drawer looks right - it is only unreachable by keyboard.
 *
 * So the attempt repeats until `document.activeElement` proves it landed,
 * rather than assuming any one frame is late enough. Bounded, so a panel with
 * nothing focusable in it cannot spin; the panel itself carries `tabindex=-1`
 * and takes focus in that case. It also stops if the drawer closed in the
 * meantime, so a drawer opened and shut inside those few frames does not
 * pull focus back afterwards.
 */
/*
 * The next chance to try, whichever comes first.
 *
 * `requestAnimationFrame` is the right signal when the page is painting, and
 * it is suspended entirely when the page is not - a background tab, or a
 * window the compositor has parked. A drawer opened in that state would never
 * take focus, and would still not have it when the reader came back, because
 * the one scheduled callback fires long after everything else has moved on.
 * So a timer races the frame and the first to arrive wins.
 */
function soon(callback) {
  let done = false

  const once = () => {
    if (done) return
    done = true
    callback()
  }

  requestAnimationFrame(once)
  setTimeout(once, 32)
}

function focusFirst(attempts) {
  if (!isOpen()) return

  const panel = document.querySelector(`[data-stx-drawer-panel="${drawerInstanceId}"]`)
  if (!panel) return

  const target = panel.querySelector('[autofocus]') || panel.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])') || panel

  target.focus?.()

  if (document.activeElement === target) return
  if (attempts > 0) soon(() => focusFirst(attempts - 1))
}

function captureFocus() {
  opener = document.activeElement

  soon(() => focusFirst(10))
}

function releaseFocus() {
  const target = opener
  opener = null
  if (target && typeof target.focus === 'function') target.focus()
}

effect(() => {
  if (isOpen()) {
    lockScroll()
    captureFocus()
    document.addEventListener('keydown', onDocumentKey)
  }
  else {
    unlockScroll()
    releaseFocus()
    document.removeEventListener('keydown', onDocumentKey)
  }
})

onDestroy(() => {
  // A drawer removed while open would otherwise leave the page locked, with no
  // drawer left to unlock it.
  unlockScroll()
  document.removeEventListener('keydown', onDocumentKey)
})

defineExpose({
  open: () => isOpen.set(true),
  close,
  isOpen,
})
</script>

<div :show="isOpen()">
  <div
    class="fixed inset-0 z-50 {{ backdropClass }} transition-opacity duration-500"
    style="animation: fadeIn 0.5s ease-in-out"
    aria-hidden="true"
    @click="onBackdropClick()"
  ></div>

  <div class="fixed inset-0 z-50 overflow-hidden" @keydown="onPanelKey($event)">
    <div class="absolute inset-0 overflow-hidden">
      <div class="{{ containerClasses }}">
        <div
          class="{{ panelClasses }}"
          style="animation: slideIn 0.5s ease-in-out"
          data-stx-drawer-panel="{{ drawerInstanceId }}"
          role="dialog"
          aria-modal="true"
          {{ title ? 'aria-label="' + title + '"' : '' }}
          tabindex="-1"
        >
          <div class="{{ closeButtonClasses }}">
            <button
              type="button"
              class="relative rounded-md text-gray-300 dark:text-gray-400 hover:text-white dark:hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
              @click="close()"
            >
              <span class="absolute -inset-2.5"></span>
              <span class="sr-only">Close panel</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="relative flex h-full flex-col overflow-y-auto {{ panelClass || 'bg-white dark:bg-blue-gray-800' }} py-6 shadow-xl" style="{{ panelStyle }}">
            @if(title)
              <div class="px-4 sm:px-6">
                <h2 class="text-base font-semibold text-fg">
                  {{ title }}
                </h2>
              </div>
            @endif
            <div class="relative mt-6 flex-1 px-4 sm:px-6">
              <slot />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideIn {
  from {
    transform: {{ position === 'right' ? 'translateX(100%)' : position === 'left' ? 'translateX(-100%)' : position === 'top' ? 'translateY(-100%)' : 'translateY(100%)' }};
  }
  to {
    transform: translate(0, 0);
  }
}
</style>
