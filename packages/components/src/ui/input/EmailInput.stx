<script server>
export const value = $props.value || ''
export const placeholder = $props.placeholder || 'Enter your email'
export const disabled = $bool($props.disabled)
export const readonly = $bool($props.readonly)
export const size = $props.size || 'md'
export const error = $bool($props.error)
export const label = $props.label || ''
export const helperText = $props.helperText || ''
export const required = $bool($props.required)
export const className = $props.className || ''

export const emailIcon = '<svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>'
/*
 * Forwarded to the TextInput this renders (stacksjs/stx#2043).
 *
 * A wrapper that does not pass them through is as unsubmittable as a control
 * that never accepted them: the inner input is the one that lands in FormData.
 * `type` is the wrapper's own business, but `name`, `autocomplete` and `form`
 * belong to the caller.
 */
export const name = $props.name || ''
export const autocomplete = $props.autocomplete || $props.autoComplete || ''
export const form = $props.form || ''
export const inputMode = $props.inputMode || $props.inputmode || ''
export const enterKeyHint = $props.enterKeyHint || $props.enterkeyhint || ''

/*
 * On a native host ($native) the field is the platform's: no envelope glyph
 * and no monospace, which iOS mail fields do without. type="email" brings the
 * email keyboard, no capitals and the person's addresses as autofill there
 * (text-entry.ts).
 */
export const fieldIcon = $native ? '' : emailIcon
export const fieldFont = $native ? '' : 'font-mono'
</script>

{{-- type="email": served as text, an email field got no email keyboard on a
     phone and no email check from the browser. --}}
<TextInput
  type="email"
  :name="name"
  :autocomplete="autocomplete"
  :form="form"
  :inputMode="inputMode"
  :enterKeyHint="enterKeyHint"
  :value="value"
  :placeholder="placeholder"
  :disabled="disabled"
  :readonly="readonly"
  :size="size"
  :error="error"
  :label="label"
  :helperText="helperText"
  :required="required"
  :leftIcon="fieldIcon"
  :clearable="true"
  :className="className"
  :inputClassName="fieldFont"
/>
