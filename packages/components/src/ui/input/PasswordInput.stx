<script server>
export const value = $props.value || ''
export const placeholder = $props.placeholder || 'Enter your password'
export const disabled = $bool($props.disabled)
export const readonly = $bool($props.readonly)
export const size = $props.size || 'md'
export const error = $bool($props.error)
export const label = $props.label || ''
/*
 * Ids unique to this instance.
 *
 * These were derived from the LABEL or hardcoded outright, so two of these on
 * one page -- an ordinary form -- emitted the same id twice. `<label for>`
 * then activated the FIRST field from every label, and `aria-describedby`
 * pointed every field's description at the first one's helper text. A label
 * containing a space also produced an invalid id, `input-First name`, which
 * getElementById and querySelector cannot address at all.
 *
 * `$uid` is unique per instance and stable across renders, which is what an id
 * has to be (utils.ts explains why a render that changes its own bytes is
 * uncacheable). The `id` prop overrides it, for a caller that needs to point
 * its own `for` or `aria-describedby` at this control.
 */
export const inputId = $props.id || `password-input-${$uid}`
export const helperId = `${inputId}-helper`
export const helperText = $props.helperText || ''
export const required = $bool($props.required)
export const showStrength = $bool($props.showStrength)
export const className = $props.className || ''
export const inputClassName = $props.inputClassName || ''
/*
 * `variant="mac"` draws the secure field a Mac draws: TextInput's Mac field
 * (24px, 6px corners, a raised face inside a hairline) with the reveal button
 * inside its trailing edge. Same <input>, same attributes and events; only
 * the classes change, to `stx-mac-field`, which this file's <style> block
 * draws from the `--stx-mac-*` tokens. `size` is not read.
 */
export const mac = $props.variant === 'mac'

/*
 * Padding decides the height here too, with no `h-*` to override it: an app
 * passing its own `py-1.5` got the padding it asked for and the height it did
 * not, and `className` cannot beat `h-10` at equal specificity
 * (stacksjs/stx#1993).
 *
 * `lg` also needed a padding step adjusted - py-3 around a 1.75rem line-height
 * is 3.25rem of content inside a declared 3rem box - so py-2.5 lands on the
 * 3rem it always claimed. sm and md were already exact.
 */
/*
 * md -- the size nearly every form uses -- reads the density roles, so an
 * app sets its own field size with --stx-control-px, --stx-control-py,
 * --stx-control-text and --stx-control-leading instead of a className
 * that ties with py-2 on specificity. The fallbacks are px-4 / py-2 /
 * text-base, so nothing moves by default (stacksjs/stx#1993).
 */
const sizeClasses = { sm: 'px-3 py-1.5 text-sm', md: 'px-control-x py-control-y text-control', lg: 'px-5 py-2.5 text-lg' }
const iconSizeClasses = { sm: 'h-4 w-4', md: 'h-5 w-5', lg: 'h-6 w-6' }

const baseClasses = 'block w-full border-0 rounded-control shadow-sm ring-1 ring-inset transition-colors duration-200 focus:ring-2 focus:ring-inset bg-field pr-10'
const stateClasses = error
  ? 'ring-danger-line text-danger-fg placeholder-danger focus:ring-danger-focus'
  : 'ring-line-strong text-fg placeholder-fg-soft focus:ring-accent'
const disabledClasses = disabled
  ? 'opacity-50 cursor-not-allowed bg-surface'
  : readonly
    ? 'bg-surface cursor-default'
    : 'bg-field'

export const inputClasses = `${baseClasses} ${sizeClasses[size] || sizeClasses.md} ${stateClasses} ${disabledClasses} ${inputClassName}`.trim()
export const labelClasses = `block text-sm font-medium leading-6 mb-2 ${error ? 'text-danger' : 'text-fg'}`.trim()
export const helperClasses = `mt-2 text-sm ${error ? 'text-danger' : 'text-fg-soft'}`.trim()
export const iconClasses = iconSizeClasses[size] || iconSizeClasses.md
/*
 * The attributes that make this a form control (stacksjs/stx#2043).
 *
 * A control with no `name` is not a form control in the HTML sense: it is left
 * out of FormData, out of form.elements.namedItem(), and out of an ordinary
 * non-JS POST. A form built from these components submitted nothing for every
 * field, silently -- which is how six apps read their forms.
 *
 * `autocomplete` is separate and just as load-bearing: it is how the browser
 * and a password manager identify a field, so a password input without
 * `autocomplete="current-password"` is never offered for autofill and is not
 * recognised as part of a sign-in form at all.
 *
 * Emitted only when given, so a control that passes none of them renders
 * exactly the markup it did before.
 */
export const name = $props.name || ''
export const autocomplete = $props.autocomplete || $props.autoComplete || ''
export const form = $props.form || ''
export const inputMode = $props.inputMode || $props.inputmode || ''
export const enterKeyHint = $props.enterKeyHint || $props.enterkeyhint || ''

/*
 * The field on a native host ($native), as TextInput draws it there: 48pt,
 * filled, the system placeholder grey. Secure entry follows the reveal
 * button through `:type` (text-entry.ts), and a field that names no
 * autocomplete is the sign-in password, so the platform offers the saved one.
 */
export const nativeAutocomplete = autocomplete || 'current-password'
export const nativeFieldClasses = `h-12 pl-4 pr-11 text-[17px] text-[#000000] dark:text-[#ffffff] bg-[#767680]/12 dark:bg-[#767680]/24 rounded-[10px] border-0 ${error ? 'border border-[#ff3b30] dark:border-[#ff453a]' : ''} ${disabled ? 'opacity-50' : ''} ${inputClassName}`.replace(/\s+/g, ' ').trim()
export const nativeLabelClasses = 'mb-1.5 px-4 text-[13px] uppercase text-[#6d6d72] dark:text-[#8d8d93]'
export const nativeHelperClasses = `mt-1.5 px-4 text-[13px] ${error ? 'text-[#ff3b30] dark:text-[#ff453a]' : 'text-[#6d6d72] dark:text-[#8d8d93]'}`
</script>

<script client>
// A bound placeholder follows its source (a translation, a loaded value)
// instead of being read once on the server; see TextInput.
const placeholderText = useReactiveProp('placeholder', {{ placeholder }})
const emit = defineEmits()
const showPassword = state(false)
// Reactive prop binding — parent can drive value via signals. See #1704.
const inputValue = useReactiveProp('value', {{ value }}, { parse: (v) => v == null ? '' : String(v) })

function onInput(event) {
  inputValue.set(event.target.value)
  emit('input', inputValue())
}

function toggleVisibility() {
  showPassword.set(!showPassword())
}

function calcStrength(pw) {
  if (!pw) return 0
  let s = 0
  if (pw.length >= 8) s += 25
  if (pw.length >= 12) s += 25
  if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) s += 25
  if (/\d/.test(pw)) s += 15
  if (/[^a-zA-Z\d]/.test(pw)) s += 10
  return Math.min(s, 100)
}

const strength = derived(() => calcStrength(inputValue()))
const strengthText = derived(() => {
  const s = strength()
  return s < 40 ? 'Weak' : s < 70 ? 'Medium' : 'Strong'
})
const strengthColor = derived(() => {
  const s = strength()
  return s < 40 ? 'bg-danger-solid' : s < 70 ? 'bg-warning-solid' : 'bg-success-solid'
})
const strengthLabelColor = derived(() => {
  const s = strength()
  return s < 40 ? 'text-danger' : s < 70 ? 'text-warning' : 'text-success'
})
const inputType = derived(() => showPassword() ? 'text' : 'password')
const toggleAriaLabel = derived(() => showPassword() ? 'Hide password' : 'Show password')
// The Mac look colours its strength bar from this word rather than a class.
const strengthLevel = derived(() => strengthText().toLowerCase())

defineExpose({ value: inputValue })
</script>

@if($native)
<div class="w-full {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="{{ nativeLabelClasses }}">{{ label }}</label>
  @endif
  <div class="relative justify-center">
    <input
      data-stx-native-host-root
      @if(name)name="{{ name }}"@endif
      autocomplete="{{ nativeAutocomplete }}"
      @if(form)form="{{ form }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      type="password"
      :type="inputType()"
      id="{{ inputId }}"
      class="{{ nativeFieldClasses }}"
      placeholderTextColor="#8e8e93"
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      @if(readonly)readonly@endif
      @if(required)required@endif
      @input="onInput($event)"
      aria-invalid="{{ error ? 'true' : 'false' }}"
    />
    <button
      type="button"
      @click="toggleVisibility()"
      class="absolute top-0 right-0 h-12 w-11 items-center justify-center"
      :aria-label="toggleAriaLabel()"
    >
      <i :show="showPassword()" class="i-lucide-eye-off h-5 w-5 text-[#8e8e93]"></i>
      <i :show="!showPassword()" class="i-lucide-eye h-5 w-5 text-[#8e8e93]"></i>
    </button>
  </div>
  @if(showStrength)
    <div :show="inputValue().length > 0" class="mt-2 px-4">
      <div class="flex-row items-center justify-between mb-1">
        <span class="text-[13px] text-[#6d6d72] dark:text-[#8d8d93]">Password strength</span>
        <span class="text-[13px] font-medium" :class="strengthLabelColor()" :text="strengthText()"></span>
      </div>
      <div class="w-full h-1.5 bg-[#767680]/12 dark:bg-[#767680]/24 rounded-full overflow-hidden">
        <div class="h-full rounded-full" :class="strengthColor()" :style="`width: ${strength()}%`"></div>
      </div>
    </div>
  @endif
  @if(helperText)
    <p id="{{ helperId }}" class="{{ nativeHelperClasses }}">{{ helperText }}</p>
  @endif
</div>
@elseif(mac)
<div class="stx-mac-field-wrap {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="stx-mac-field-label" @if(error)data-error="true"@endif>
      {{ label }}
      @if(required)
        <span class="stx-mac-field-required">*</span>
      @endif
    </label>
  @endif

  <div class="stx-mac-field-box">
    <input
      @if(name)name="{{ name }}"@endif
      @if(autocomplete)autocomplete="{{ autocomplete }}"@endif
      @if(form)form="{{ form }}"@endif
      @if(inputMode)inputmode="{{ inputMode }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      :type="inputType()"
      id="{{ inputId }}"
      class="stx-mac-field stx-mac-field-secure {{ inputClassName }}"
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      @if(readonly)readonly@endif
      @if(required)required@endif
      @input="onInput($event)"
      :aria-invalid="{{ error ? 'true' : 'false' }}"
      @if(helperText)aria-describedby="{{ helperId }}"@endif
    />

    <button
      type="button"
      @click="toggleVisibility()"
      class="stx-mac-field-reveal"
      :aria-label="toggleAriaLabel()"
    >
      <i :show="showPassword()" class="i-f7-eye-slash stx-mac-field-glyph"></i>
      <i :show="!showPassword()" class="i-f7-eye stx-mac-field-glyph"></i>
    </button>
  </div>

  @if(showStrength)
    <div :show="inputValue().length > 0" class="stx-mac-field-strength" :data-level="strengthLevel()">
      <div class="stx-mac-field-strength-head">
        <span>Password strength</span>
        <span class="stx-mac-field-strength-word" x-text="strengthText()"></span>
      </div>
      <div class="stx-mac-field-strength-track">
        <div class="stx-mac-field-strength-bar" :style="`width: ${strength()}%`"></div>
      </div>
    </div>
  @endif

  @if(helperText)
    <p id="{{ helperId }}" class="stx-mac-field-helper" @if(error)data-error="true"@endif>
      {{ helperText }}
    </p>
  @endif
</div>
@else
<div class="w-full {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="{{ labelClasses }}">
      {{ label }}
      @if(required)
        <span class="text-danger ml-1">*</span>
      @endif
    </label>
  @endif

  <div class="relative">
    <input
      @if(name)name="{{ name }}"@endif
      @if(autocomplete)autocomplete="{{ autocomplete }}"@endif
      @if(form)form="{{ form }}"@endif
      @if(inputMode)inputmode="{{ inputMode }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      :type="inputType()"
      id="{{ inputId }}"
      class="{{ inputClasses }}"

      {{-- The served value, alongside the binding that takes over on hydration.
      
           An HTML `value` attribute is the DEFAULT value: it is what the field shows
           on first paint and what an ordinary non-JS POST submits, while the runtime
           drives the live `value` PROPERTY afterwards. With only `:value`, a
           server-rendered `value="a@b.c"` reached the browser as an empty box that
           posted an empty string -- the field arrived under its name carrying
           nothing, which is the same silent shape as the missing name itself
           (stacksjs/stx#2043). The two do not fight: attribute and property are
           different things. --}}
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      @if(readonly)readonly@endif
      @if(required)required@endif
      @input="onInput($event)"
      :aria-invalid="{{ error ? 'true' : 'false' }}"
      @if(helperText)aria-describedby="{{ helperId }}"@endif
    />

    <div class="absolute inset-y-0 right-0 flex items-center pr-3">
      <button
        type="button"
        @click="toggleVisibility()"
        class="text-fg-soft hover:text-fg-strong focus:outline-none"
        :aria-label="toggleAriaLabel()"
      >
        <svg :show="showPassword()" class="{{ iconClasses }}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
        </svg>
        <svg :show="!showPassword()" class="{{ iconClasses }}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      </button>
    </div>
  </div>

  @if(showStrength)
    <div :show="inputValue().length > 0" class="mt-2">
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-fg-muted">Password strength</span>
        <span class="text-xs font-medium" :class="strengthLabelColor()" x-text="strengthText()"></span>
      </div>
      <div class="w-full h-1.5 bg-surface-sunken rounded-full overflow-hidden">
        <div
          class="h-full transition-all duration-300 rounded-full"
          :class="strengthColor()"
          :style="`width: ${strength()}%`"
        ></div>
      </div>
    </div>
  @endif

  @if(helperText)
    <p id="{{ helperId }}" class="{{ helperClasses }}">
      {{ helperText }}
    </p>
  @endif
</div>
@endif

<style data-native-exclude>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
  --stx-mac-font-size: 13px;
  --stx-mac-font-size-small: 11px;
  --stx-mac-hairline: 0.5px;
  --stx-mac-focus-ring: 0 0 0 3px color-mix(in srgb, var(--stx-mac-accent) 35%, transparent);
  --stx-mac-card-radius: 12px;
  --stx-mac-control-radius: 6px;
  --stx-mac-row-height: 38px;
  --stx-mac-row-inset: 10px;
  --stx-mac-sidebar-width: 226px;
  --stx-mac-accent: var(--stx-accent, #007aff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(0, 0, 0, 0.85);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-tertiary: rgba(0, 0, 0, 0.26);
  --stx-mac-window: #ffffff;
  --stx-mac-sidebar: #f2f1f0;
  --stx-mac-card: rgba(0, 0, 0, 0.04);
  --stx-mac-separator: rgba(0, 0, 0, 0.1);
  --stx-mac-hover: rgba(0, 0, 0, 0.05);
  --stx-mac-selection-inactive: rgba(0, 0, 0, 0.08);
  --stx-mac-well: rgba(0, 0, 0, 0.07);
  --stx-mac-control: #ffffff;
  --stx-mac-control-line: rgba(0, 0, 0, 0.12);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  --stx-mac-switch-on: #34c759;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff3b30;
}
:where(.dark) {
  --stx-mac-accent: var(--stx-accent, #0a84ff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(255, 255, 255, 0.85);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.55);
  --stx-mac-ink-tertiary: rgba(255, 255, 255, 0.25);
  --stx-mac-window: #1e1e1e;
  --stx-mac-sidebar: #2a2a2a;
  --stx-mac-card: rgba(255, 255, 255, 0.05);
  --stx-mac-separator: rgba(255, 255, 255, 0.1);
  --stx-mac-hover: rgba(255, 255, 255, 0.06);
  --stx-mac-selection-inactive: rgba(255, 255, 255, 0.1);
  --stx-mac-well: rgba(255, 255, 255, 0.1);
  --stx-mac-control: rgba(255, 255, 255, 0.14);
  --stx-mac-control-line: rgba(255, 255, 255, 0.06);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.4), inset 0 0.5px 0 rgba(255, 255, 255, 0.12);
  --stx-mac-switch-on: #30d158;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff453a;
}
@media (max-resolution: 1.5dppx) {
:where(:root) {
  --stx-mac-hairline: 1px;
}
}
@media (prefers-contrast: more) {
:where(:root) {
  --stx-mac-separator: rgba(0, 0, 0, 0.4);
  --stx-mac-control-line: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.75);
  --stx-mac-hairline: 1px;
}
:where(.dark) {
  --stx-mac-separator: rgba(255, 255, 255, 0.45);
  --stx-mac-control-line: rgba(255, 255, 255, 0.5);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.8);
}
}

.stx-mac-field-wrap {
  display: block;
  width: var(--stx-mac-field-width, 100%);
  max-width: 100%;
  font-family: var(--stx-mac-font);
  font-size: var(--stx-mac-font-size);
  letter-spacing: -0.08px;
  -webkit-font-smoothing: antialiased;
  color: var(--stx-mac-ink);
  cursor: default;
}

.stx-mac-field-label {
  display: block;
  margin-bottom: 4px;
  line-height: 16px;
  -webkit-user-select: none;
  user-select: none;
}

.stx-mac-field-label[data-error='true'],
.stx-mac-field-required,
.stx-mac-field-helper[data-error='true'] {
  color: var(--stx-mac-danger);
}

.stx-mac-field-box {
  position: relative;
  display: flex;
  align-items: center;
}

.stx-mac-field {
  --stx-mac-field-line: inset 0 0 0 var(--stx-mac-hairline) var(--stx-mac-control-line);
  display: block;
  flex: 1 1 auto;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 24px;
  margin: 0;
  padding: 0 7px;
  border: 0;
  border-radius: var(--stx-mac-control-radius);
  background: var(--stx-mac-control);
  box-shadow: var(--stx-mac-field-line);
  color: var(--stx-mac-ink);
  font: inherit;
  letter-spacing: inherit;
  -webkit-appearance: none;
  appearance: none;
  outline: none;
  transition: box-shadow 150ms ease;
}

.stx-mac-field::placeholder {
  color: var(--stx-mac-ink-tertiary);
}

.stx-mac-field:focus-visible {
  box-shadow: var(--stx-mac-field-line), var(--stx-mac-focus-ring);
}

.stx-mac-field[aria-invalid='true'] {
  --stx-mac-field-line: inset 0 0 0 1px var(--stx-mac-danger);
}

.stx-mac-field:disabled {
  opacity: 0.5;
}

.stx-mac-field-helper {
  margin: 4px 0 0;
  font-size: var(--stx-mac-font-size-small);
  line-height: 14px;
  letter-spacing: 0;
  color: var(--stx-mac-ink-secondary);
}

@media (prefers-reduced-motion: reduce) {
  .stx-mac-field {
    transition: none;
  }
}

/* Two classes, so these win over the plain field's rules whichever component's stylesheet the page loads last. */
.stx-mac-field.stx-mac-field-secure {
  padding-right: 26px;
}

.stx-mac-field-reveal {
  position: absolute;
  top: 3px;
  right: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: var(--stx-mac-ink-secondary);
  -webkit-appearance: none;
  appearance: none;
  cursor: default;
  outline: none;
}

.stx-mac-field-reveal:hover {
  color: var(--stx-mac-ink);
}

.stx-mac-field-reveal:focus-visible {
  box-shadow: var(--stx-mac-focus-ring);
}

.stx-mac-field-glyph {
  width: 13px;
  height: 13px;
}

.stx-mac-field-strength {
  --stx-mac-field-strength: var(--stx-mac-danger);
  margin-top: 6px;
  font-size: var(--stx-mac-font-size-small);
  letter-spacing: 0;
  color: var(--stx-mac-ink-secondary);
  -webkit-user-select: none;
  user-select: none;
}

.stx-mac-field-strength[data-level='medium'] {
  --stx-mac-field-strength: #ff9500;
}

.stx-mac-field-strength[data-level='strong'] {
  --stx-mac-field-strength: var(--stx-mac-switch-on);
}

.stx-mac-field-strength-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 3px;
}

.stx-mac-field-strength-word {
  color: var(--stx-mac-field-strength);
}

.stx-mac-field-strength-track {
  height: 4px;
  overflow: hidden;
  border-radius: 2px;
  background: var(--stx-mac-well);
}

.stx-mac-field-strength-bar {
  height: 100%;
  border-radius: 2px;
  background: var(--stx-mac-field-strength);
  transition: width 150ms ease;
}

@media (prefers-reduced-motion: reduce) {
  .stx-mac-field-strength-bar {
    transition: none;
  }
}
</style>
