<script server>
export const value = $props.value || ''
export const placeholder = $props.placeholder || ''
export const disabled = $bool($props.disabled)
export const readonly = $bool($props.readonly)
export const size = $props.size || 'md'
export const error = $bool($props.error)
export const label = $props.label || ''
export const helperText = $props.helperText || ''
export const required = $bool($props.required)
export const leftIcon = $props.leftIcon || ''
export const rightIcon = $props.rightIcon || ''
export const clearable = $bool($props.clearable)
export const maxLength = $props.maxLength ?? $props.maxlength
export const showCount = $bool($props.showCount)
export const className = $props.className || ''
export const inputClassName = $props.inputClassName || ''
/*
 * `variant="mac"` draws the text field a Mac draws: 24px tall with 6px
 * corners, a raised face inside a hairline, 13px text, and the accent's ring
 * while it has the keyboard. It is the same <input> with the same attributes
 * and events; only the classes change, to `stx-mac-field`, which this file's
 * <style> block draws from the `--stx-mac-*` tokens. It has one size, so
 * `size` is not read, and it is as wide as `--stx-mac-field-width` (the
 * whole of its container when that is unset).
 */
export const mac = $props.variant === 'mac'
export const macFieldClasses = `stx-mac-field ${leftIcon ? 'stx-mac-field-leading' : ''} ${rightIcon || clearable ? 'stx-mac-field-trailing' : ''} ${inputClassName}`.replace(/\s+/g, ' ').trim()

/*
 * Padding decides the height here too, with no `h-*` to override it: an app
 * passing its own `py-1.5` got the padding it asked for and the height it did
 * not, and `className` cannot beat `h-10` at equal specificity
 * (stacksjs/stx#1993).
 *
 * `lg` also needed a padding step adjusted - py-3 around a 1.75rem line-height
 * is 3.25rem of content inside a declared 3rem box - so py-2.5 lands on the
 * 3rem it always claimed. sm and md were already exact.
 */
/*
 * md -- the size nearly every form uses -- reads the density roles, so an
 * app sets its own field size with --stx-control-px, --stx-control-py,
 * --stx-control-text and --stx-control-leading instead of a className
 * that ties with py-2 on specificity. The fallbacks are px-4 / py-2 /
 * text-base, so nothing moves by default (stacksjs/stx#1993).
 */
const sizeClasses = { sm: 'px-3 py-1.5 text-sm', md: 'px-control-x py-control-y text-control', lg: 'px-5 py-2.5 text-lg' }
const iconSizeClasses = { sm: 'h-4 w-4', md: 'h-5 w-5', lg: 'h-6 w-6' }

const baseClasses = 'block w-full border-0 rounded-control shadow-sm ring-1 ring-inset transition-colors duration-200 focus:ring-2 focus:ring-inset'
/*
 * The two halves of the validity state, exported so the CLIENT can swap them
 * (stacksjs/stx#2047).
 *
 * `error` was read once on the server, like `disabled` and `loading` used to
 * be -- and validity is the clearest case of state that is not known at render
 * time: a form posted with fetch learns it after the submit, with no
 * re-render. So a field could never BECOME invalid, which made the component a
 * step backwards from a plain <input> for exactly the forms it is for.
 *
 * Toggled as an object binding rather than a whole class string, because a
 * reactive class string MERGES with the static one -- measured, the element
 * ends up carrying `ring-line-strong` and `ring-danger-line` at once, and
 * which wins is then CSS source order rather than anything this file controls.
 * Per-class toggling removes one set as it adds the other.
 */
export const stateInvalidClasses = 'ring-danger-line text-danger-fg placeholder-danger focus:ring-danger-focus'
export const stateValidClasses = 'ring-line-strong text-fg placeholder-fg-soft focus:ring-accent'
const stateClasses = error ? stateInvalidClasses : stateValidClasses
const disabledClasses = disabled
  ? 'opacity-50 cursor-not-allowed bg-surface'
  : readonly
    ? 'bg-surface cursor-default'
    : 'bg-field'
const paddingClasses = leftIcon ? 'pl-10' : rightIcon || clearable ? 'pr-10' : ''

export const inputClasses = `${baseClasses} ${sizeClasses[size] || sizeClasses.md} ${stateClasses} ${disabledClasses} ${paddingClasses} ${inputClassName}`.trim()
export const labelClasses = `block text-sm font-medium leading-6 mb-2 ${error ? 'text-danger' : 'text-fg'}`.trim()
export const helperClasses = `mt-2 text-sm ${error ? 'text-danger' : 'text-fg-soft'}`.trim()
export const iconClasses = iconSizeClasses[size] || iconSizeClasses.md
/*
 * Ids unique to this instance.
 *
 * These were derived from the LABEL or hardcoded outright, so two of these on
 * one page -- an ordinary form -- emitted the same id twice. `<label for>`
 * then activated the FIRST field from every label, and `aria-describedby`
 * pointed every field's description at the first one's helper text. A label
 * containing a space also produced an invalid id, `input-First name`, which
 * getElementById and querySelector cannot address at all.
 *
 * `$uid` is unique per instance and stable across renders, which is what an id
 * has to be (utils.ts explains why a render that changes its own bytes is
 * uncacheable). The `id` prop overrides it, for a caller that needs to point
 * its own `for` or `aria-describedby` at this control.
 */
export const inputId = $props.id || `input-${$uid}`
export const helperId = `${inputId}-helper`
/*
 * The attributes that make this a form control (stacksjs/stx#2043).
 *
 * A control with no `name` is not a form control in the HTML sense: it is left
 * out of FormData, out of form.elements.namedItem(), and out of an ordinary
 * non-JS POST. A form built from these components submitted nothing for every
 * field, silently -- which is how six apps read their forms.
 *
 * `autocomplete` is separate and just as load-bearing: it is how the browser
 * and a password manager identify a field, so a password input without
 * `autocomplete="current-password"` is never offered for autofill and is not
 * recognised as part of a sign-in form at all.
 *
 * Emitted only when given, so a control that passes none of them renders
 * exactly the markup it did before.
 */
export const name = $props.name || ''
export const autocomplete = $props.autocomplete || $props.autoComplete || ''
export const form = $props.form || ''
export const inputMode = $props.inputMode || $props.inputmode || ''
export const enterKeyHint = $props.enterKeyHint || $props.enterkeyhint || ''

/*
 * The text-like input types (stacksjs/stx#2059).
 *
 * `type` was hard-coded to text, so a form with a date, a time, a URL or a
 * phone number in it had to mix library and native controls -- the
 * inconsistency the library exists to remove. email, number and password have
 * components of their own but are accepted here too. Anything else (checkbox,
 * file, range...) is not a text field, and is served as text rather than as a
 * control this markup was not drawn for.
 */
const TEXT_TYPES = ['text', 'date', 'time', 'datetime-local', 'month', 'week', 'url', 'tel', 'color', 'search', 'email', 'number', 'password']
export const type = TEXT_TYPES.includes(String($props.type)) ? String($props.type) : 'text'

/*
 * The constraint attributes, each emitted only when given AND only on the
 * types HTML applies it to, so a control renders exactly the markup it did
 * before unless the caller asked for something it can use: min/max/step
 * bound the date, time and number types; pattern, minlength, maxlength and
 * size the free-text ones; list every type but password.
 */
const RANGED_TYPES = ['date', 'time', 'datetime-local', 'month', 'week', 'number']
const FREE_TEXT_TYPES = ['text', 'search', 'url', 'tel', 'email', 'password']
const given = (v) => v !== undefined && v !== null && v !== '' && v !== false
const ranged = RANGED_TYPES.includes(type)
export const freeText = FREE_TEXT_TYPES.includes(type)
export const min = ranged && given($props.min) ? String($props.min) : ''
export const max = ranged && given($props.max) ? String($props.max) : ''
export const step = ranged && given($props.step) ? String($props.step) : ''
export const pattern = freeText && given($props.pattern) ? String($props.pattern) : ''
export const minLength = freeText && given($props.minLength ?? $props.minlength) ? String($props.minLength ?? $props.minlength) : ''
/*
 * The HTML `size` attribute (a width in characters). Not `size`, which is
 * already this component's sm / md / lg.
 */
export const htmlSize = freeText && given($props.htmlSize) ? String($props.htmlSize) : ''
export const list = type !== 'password' && given($props.list) ? String($props.list) : ''
export const autofocus = $bool($props.autofocus)

/*
 * The field a phone app draws, for a native host ($native): 48pt tall, the
 * 17pt body size, a filled rounded box that reads on a grouped background and
 * a plain one alike, and the system's placeholder grey. The web's rings,
 * shadow and density roles have nothing to draw on a device, and its icon
 * slot is a web flourish iOS fields do without. An invalid field gets the
 * system red outline, a disabled one dims as UIKit's do.
 */
export const nativeFieldClasses = `h-12 px-4 text-[17px] text-[#000000] dark:text-[#ffffff] bg-[#767680]/12 dark:bg-[#767680]/24 rounded-[10px] border-0 ${inputClassName}`.trim()
export const nativeLabelClasses = 'mb-1.5 px-4 text-[13px] uppercase text-[#6d6d72] dark:text-[#8d8d93]'
export const nativeHelperClasses = `mt-1.5 px-4 text-[13px] ${error ? 'text-[#ff3b30] dark:text-[#ff453a]' : 'text-[#6d6d72] dark:text-[#8d8d93]'}`
</script>

<script client>
// Reserve value events before the first edit: lazy input must not leak its
// bubbling DOM/native event object to a caller expecting the committed value.
const emit = defineEmits(['input', 'clear', 'focus', 'blur', 'submit', 'submit-editing'])
// Validity is live, for the same reason `disabled` is: a form posted with
// fetch learns it after the submit, and nothing re-renders (#2047).
const nativeClear = typeof craft !== 'undefined' && craft.capabilities.nativePlatformControls === true
const isError = useReactiveProp('error', {{ error }})
// Keep the physical control and its affordances live on both web and native.
const isDisabled = useReactiveProp('disabled', {{ disabled }})
const isReadonly = useReactiveProp('readonly', {{ readonly }})
// The hint is words, and words change after the first render: a translated
// placeholder follows the language, and one naming a loaded value follows the
// load. Read once on the server it could do neither, and on a native host a
// bound placeholder never reached the field at all, because a prop this
// component reads is not one the host forwards for it.
const placeholderText = useReactiveProp('placeholder', {{ placeholder }})
// v-model:value supports modifiers; @input remains available to existing callers.
const inputValue = useModel('value', { default: {{ value }}, parse: (v) => v == null ? '' : String(v) })
let lastNativeCommit = String(inputValue() ?? '')
let lastInputText = lastNativeCommit

function onNativeFocus(event) {
  lastNativeCommit = String(event.text ?? event.target.value ?? '')
  lastInputText = lastNativeCommit
  onFocus(event)
}

// Focus/blur do not bubble from the physical input to the component scope.
// Forward the original event so browser FocusEvent methods and native payloads survive.
function onFocus(event) {
  if (!isDisabled() && event.target.isConnected !== false) emit('focus', event)
}

function onBlur(event) {
  if (event.target.isConnected !== false) emit('blur', event)
}

// Native return-key callbacks use submit-editing (with submit as an alias).
// Do not commit lazy models here: end-editing owns that, and browser form
// submission remains the form's event rather than a synthetic input event.
function onNativeSubmit(event) {
  if (isDisabled() || event.target.isConnected === false) return
  emit('submit-editing', event)
  emit('submit', event)
}

function onNativeChange(event) {
  if (isDisabled() || isReadonly()) {
    event.target.value = inputValue()
    return
  }
  lastNativeCommit = String(event.target.value ?? '')
  onChange(event)
  emit('change', { ...event, type: 'change' })
}

// Craft commits text with onEndEditing, not a picker's onValueChange.
// Keep the shared @change event-shaped and @input value-shaped; the legacy
// primitive still exposes its original native payload without this adapter.
function onNativeEndEditing(event) {
  if (isDisabled() || isReadonly()) {
    event.target.value = inputValue()
    return
  }
  const text = String(event.text ?? event.nativeEvent?.text ?? event.target.value ?? '')
  if (text === lastNativeCommit) return
  lastNativeCommit = text
  event.target.value = text
  if (inputValue.modifiers.lazy) onChange(event)
  else if (lastInputText !== text) onInput(event)
  emit('change', { ...event, type: 'change' })
}

function onInput(event) {
  if (event.clear === true || event.nativeEvent?.clear === true) { onClear(); return }
  if (isDisabled() || isReadonly()) {
    event.target.value = inputValue()
    return
  }
  lastInputText = String(event.target.value ?? '')
  inputValue.input(event.target.value)
  if (!inputValue.modifiers.lazy) emit('input', inputValue())
}

function onChange(event) {
  if (isDisabled() || isReadonly()) {
    event.target.value = inputValue()
    return
  }
  inputValue.change(event.target.value)
  if (inputValue.modifiers.lazy) emit('input', inputValue())
}

function onClear() {
  if (isDisabled() || isReadonly()) return
  inputValue.set('')
  lastNativeCommit = ''
  lastInputText = ''
  emit('input', '')
  emit('clear')
}

const hasValue = derived(() => String(inputValue()).length > 0)
const charCount = derived(() => `${String(inputValue()).length} / {{ maxLength || 0 }}`)

defineExpose({ value: inputValue, clear: onClear })
</script>

@if($native)
<div class="w-full {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="{{ nativeLabelClasses }}">{{ label }}</label>
  @endif
  <div class="relative justify-center">
    <input
      data-stx-native-host-root
      @if(name)name="{{ name }}"@endif
      @if(autocomplete)autocomplete="{{ autocomplete }}"@endif
      @if(form)form="{{ form }}"@endif
      @if(inputMode)inputmode="{{ inputMode }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      type="{{ type }}"
      @if(autofocus)autofocus@endif
      id="{{ inputId }}"
      class="{{ nativeFieldClasses }}"
      placeholderTextColor="#8e8e93"
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      :disabled="isDisabled()"
      @if(readonly)readonly@endif
      :readonly="isReadonly()"
      @if(required)required@endif
      @if(maxLength && freeText)maxlength="{{ maxLength }}"@endif
      @input="onInput($event)"
      @change="onNativeChange($event)"
      @focus="onNativeFocus($event)"
      @blur="onBlur($event)"
      @submit-editing="onNativeSubmit($event)"
      @end-editing="onNativeEndEditing($event)"
      aria-invalid="{{ error ? 'true' : 'false' }}"
      :aria-invalid="isError() ? 'true' : 'false'"
      :class="{ 'border border-[#ff3b30] dark:border-[#ff453a]': isError(), 'opacity-50': isDisabled() }"
      @if(clearable):clearButtonMode="nativeClear ? 'while-editing' : 'never'" :style="nativeClear ? null : { paddingRight: 40 }"@endif
    />

    @if(clearable)
      <button :if="!nativeClear" type="button" :show="hasValue() && !isDisabled() && !isReadonly()"
        @click="onClear()" class="absolute top-0 right-0 h-12 w-10 items-center justify-center" aria-label="Clear input"
      ><i class="i-lucide-circle-x h-[17px] w-[17px] text-[#c4c4c7] dark:text-[#5b5b5f]"></i></button>
    @endif
  </div>
  @if(helperText)
    <p id="{{ helperId }}" class="{{ nativeHelperClasses }}">{{ helperText }}</p>
  @endif
  @if(showCount && maxLength)
    <p class="mt-1.5 px-4 text-right text-[13px] text-[#6d6d72] dark:text-[#8d8d93]" :text="charCount()"></p>
  @endif
</div>
@elseif(mac)
<div class="stx-mac-field-wrap {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="stx-mac-field-label" @if(error)data-error="true"@endif>
      {{ label }}
      @if(required)
        <span class="stx-mac-field-required">*</span>
      @endif
    </label>
  @endif

  <div class="stx-mac-field-box">
    @if(leftIcon)
      <span class="stx-mac-field-icon stx-mac-field-icon-leading" aria-hidden="true">{!! leftIcon !!}</span>
    @endif

    <input
      data-stx-native-host-root
      @if(name)name="{{ name }}"@endif
      @if(autocomplete)autocomplete="{{ autocomplete }}"@endif
      @if(form)form="{{ form }}"@endif
      @if(inputMode)inputmode="{{ inputMode }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      type="{{ type }}"
      @if(min)min="{{ min }}"@endif
      @if(max)max="{{ max }}"@endif
      @if(step)step="{{ step }}"@endif
      @if(pattern)pattern="{{ pattern }}"@endif
      @if(minLength)minlength="{{ minLength }}"@endif
      @if(htmlSize)size="{{ htmlSize }}"@endif
      @if(list)list="{{ list }}"@endif
      @if(autofocus)autofocus@endif
      id="{{ inputId }}"
      class="{{ macFieldClasses }}"
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      :disabled="isDisabled()"
      @if(readonly)readonly@endif
      :readonly="isReadonly()"
      @if(required)required@endif
      @if(maxLength && freeText)maxlength="{{ maxLength }}"@endif
      @input="onInput($event)"
      @change="onChange($event)"
      @focus="onFocus($event)"
      @blur="onBlur($event)"
      aria-invalid="{{ error ? 'true' : 'false' }}"
      :aria-invalid="isError() ? 'true' : 'false'"
      @if(helperText)aria-describedby="{{ helperId }}"@endif
    />

    @if(clearable)
      <button
        type="button"
        :show="hasValue() && !isDisabled() && !isReadonly()"
        @click="onClear()"
        class="stx-mac-field-clear"
        aria-label="Clear input"
      ></button>
    @endif
    @if(rightIcon && !clearable)
      <span class="stx-mac-field-icon stx-mac-field-icon-trailing" aria-hidden="true">{!! rightIcon !!}</span>
    @endif
  </div>

  @if(helperText || (showCount && maxLength))
    <div class="stx-mac-field-foot">
      @if(helperText)
        <p id="{{ helperId }}" class="stx-mac-field-helper" @if(error)data-error="true"@endif>
          {{ helperText }}
        </p>
      @else
        <span></span>
      @endif

      @if(showCount && maxLength)
        <p class="stx-mac-field-helper" x-text="charCount()"></p>
      @endif
    </div>
  @endif
</div>
@else
<div class="w-full {{ className }}">
  @if(label)
    <label for="{{ inputId }}" class="{{ labelClasses }}">
      {{ label }}
      @if(required)
        <span class="text-danger ml-1">*</span>
      @endif
    </label>
  @endif

  <div class="relative">
    @if(leftIcon)
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
        <span class="{{ iconClasses }} text-fg-soft">{!! leftIcon !!}</span>
      </div>
    @endif

    <input
      data-stx-native-host-root
      @if(name)name="{{ name }}"@endif
      @if(autocomplete)autocomplete="{{ autocomplete }}"@endif
      @if(form)form="{{ form }}"@endif
      @if(inputMode)inputmode="{{ inputMode }}"@endif
      @if(enterKeyHint)enterkeyhint="{{ enterKeyHint }}"@endif
      type="{{ type }}"
      @if(min)min="{{ min }}"@endif
      @if(max)max="{{ max }}"@endif
      @if(step)step="{{ step }}"@endif
      @if(pattern)pattern="{{ pattern }}"@endif
      @if(minLength)minlength="{{ minLength }}"@endif
      @if(htmlSize)size="{{ htmlSize }}"@endif
      @if(list)list="{{ list }}"@endif
      @if(autofocus)autofocus@endif
      id="{{ inputId }}"
      class="{{ inputClasses }}"

      {{-- The served value, alongside the binding that takes over on hydration.
      
           An HTML `value` attribute is the DEFAULT value: it is what the field shows
           on first paint and what an ordinary non-JS POST submits, while the runtime
           drives the live `value` PROPERTY afterwards. With only `:value`, a
           server-rendered `value="a@b.c"` reached the browser as an empty box that
           posted an empty string -- the field arrived under its name carrying
           nothing, which is the same silent shape as the missing name itself
           (stacksjs/stx#2043). The two do not fight: attribute and property are
           different things. --}}
      value="{{ value }}"
      :value="inputValue()"
      placeholder="{{ placeholder }}"
      :placeholder="String(placeholderText() ?? '')"
      @if(disabled)disabled@endif
      :disabled="isDisabled()"
      @if(readonly)readonly@endif
      :readonly="isReadonly()"
      @if(required)required@endif
      @if(maxLength && freeText)maxlength="{{ maxLength }}"@endif
      @input="onInput($event)"
      @change="onChange($event)"
      @focus="onFocus($event)"
      @blur="onBlur($event)"
      aria-invalid="{{ error ? 'true' : 'false' }}"
      :aria-invalid="isError() ? 'true' : 'false'"
      :class="{ '{{ stateInvalidClasses }}': isError(), '{{ stateValidClasses }}': !isError(), 'opacity-50 cursor-not-allowed': isDisabled(), 'bg-surface': isDisabled() || isReadonly(), 'bg-field': !isDisabled() && !isReadonly(), 'cursor-default': !isDisabled() && isReadonly() }"
      @if(helperText)aria-describedby="{{ helperId }}"@endif
    />

    @if(clearable)
      <div :show="hasValue() && !isDisabled() && !isReadonly()" class="absolute inset-y-0 right-0 flex items-center pr-3">
        <button
          type="button"
          @click="onClear()"
          class="text-fg-soft hover:text-fg-strong focus:outline-none"
          aria-label="Clear input"
        >
          <svg class="{{ iconClasses }}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    @endif
    @if(rightIcon && !clearable)
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
        <span class="{{ iconClasses }} text-fg-soft">{!! rightIcon !!}</span>
      </div>
    @endif
  </div>

  @if(helperText || (showCount && maxLength))
    <div class="flex items-center justify-between mt-2">
      @if(helperText)
        <p id="{{ helperId }}" class="{{ helperClasses }}">
          {{ helperText }}
        </p>
      @else
        <span></span>
      @endif

      @if(showCount && maxLength)
        <p class="text-sm text-fg-soft" x-text="charCount()"></p>
      @endif
    </div>
  @endif
</div>
@endif

<style data-native-exclude>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
  --stx-mac-font-size: 13px;
  --stx-mac-font-size-small: 11px;
  --stx-mac-hairline: 0.5px;
  --stx-mac-focus-ring: 0 0 0 3px color-mix(in srgb, var(--stx-mac-accent) 35%, transparent);
  --stx-mac-card-radius: 12px;
  --stx-mac-control-radius: 6px;
  --stx-mac-row-height: 38px;
  --stx-mac-row-inset: 10px;
  --stx-mac-sidebar-width: 226px;
  --stx-mac-accent: var(--stx-accent, #007aff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(0, 0, 0, 0.85);
  --stx-mac-ink-secondary: rgba(0, 0, 0, 0.5);
  --stx-mac-ink-tertiary: rgba(0, 0, 0, 0.26);
  --stx-mac-window: #ffffff;
  --stx-mac-sidebar: #f2f1f0;
  --stx-mac-card: rgba(0, 0, 0, 0.04);
  --stx-mac-separator: rgba(0, 0, 0, 0.1);
  --stx-mac-hover: rgba(0, 0, 0, 0.05);
  --stx-mac-selection-inactive: rgba(0, 0, 0, 0.08);
  --stx-mac-well: rgba(0, 0, 0, 0.07);
  --stx-mac-control: #ffffff;
  --stx-mac-control-line: rgba(0, 0, 0, 0.12);
  --stx-mac-control-shadow: 0 0.5px 1.5px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  --stx-mac-switch-on: #34c759;
  --stx-mac-knob: #ffffff;
  --stx-mac-danger: #ff3b30;
}
:where(.dark) {
  --stx-mac-accent: var(--stx-accent, #0a84ff);
  --stx-mac-accent-ink: #ffffff;
  --stx-mac-ink: rgba(255, 255, 255, 0.85);
  --stx-mac-ink-secondary: rgba(255, 255, 255, 0.55);
  --stx-mac-ink-tertiary: rgba(255, 255, 255, 0.25);
  --stx-mac-window: #1e1e1e;
  --stx-mac-sidebar: #2a2a2a;
