<script server>
/**
 * A titled group of rows on a rounded card — the "My Work" pattern.
 *
 * The title sits *outside* the card. That is the whole convention: the card is
 * the group, the heading names it, and putting the heading inside makes the
 * first row look like a header and every subsequent group look like a
 * continuation of the one above it.
 *
 * Dividers are drawn by the card rather than by the rows, via
 * `divide-y`, so a row does not have to know whether it is last — which is how
 * a trailing hairline ends up under the final item of every list.
 */
export const title = $props.title || ''
/** Right-aligned control beside the title — "See all", a menu glyph. */
export const action = $props.action || ''
export const actionHref = $props.actionHref || ''
export const className = $props.className || ''

export const cardClasses = `
  overflow-hidden rounded-2xl border border-line bg-surface-raised
  divide-y divide-line
`.replace(/\s+/g, ' ').trim()

/*
 * Whether the router should own this link.
 *
 * The SPA router intercepts `[data-stx-link]` and nothing else, so a plain
 * `<a href>` here was a full document load: the runtime rebooted, every signal
 * and store was discarded, and the screen flashed white. On a phone this is
 * the primary navigation control, so the app's main interaction was its worst
 * one - the single largest reason a wrapped build feels like a browser rather
 * than an app. stacksjs/stx#1988
 *
 * An absolute URL, a scheme (mailto:, tel:), a protocol-relative URL and a
 * bare fragment are left to the browser: the router does not handle those, and
 * claiming them would break a tab that points off-site.
 */
function routerOwns(url) {
  if (!url || url === '#') return false
  return !/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(url)
}

export const actionRouterOwned = routerOwns(actionHref)
</script>

<section class="{{ className }}" data-stx-section-card>
  @if (title || action)
    <header class="flex items-baseline justify-between px-1 pb-2">
      @if (title)
        <h2 class="text-2xl font-bold tracking-tight text-fg-strong">{{ title }}</h2>
      @endif

      @if (action)
        <a
          href="{{ actionHref }}"
          class="text-sm font-medium text-accent"
          @if (actionRouterOwned)
            data-stx-link
          @endif
        >{{ action }}</a>
      @endif
    </header>
  @endif

  <div class="{{ cardClasses }}">
    <slot />
  </div>
</section>
