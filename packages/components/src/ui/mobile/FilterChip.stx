<script server>
/** One pill. See `FilterChips` for why a menu chip is not a toggle chip. */
export const label = $props.label || ''
export const href = $props.href || '#'
export const active = $bool($props.active)
/** Opens a picker rather than toggling in place — draws a chevron. */
export const menu = $bool($props.menu)
export const count = $props.count || ''

export const hasCount = count !== '' && count !== 0 && count !== '0'

/*
 * `shrink-0`, because the row scrolls.
 *
 * Without it flexbox distributes the overflow by squeezing every chip, and a
 * row of filters that cannot overflow instead renders as a row of ellipses.
 */
export const chipClasses = `
  inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-4 py-2
  text-sm font-medium transition-colors
  ${active
    ? 'border-transparent bg-fg text-surface'
    : 'border-line bg-surface-raised text-fg hover:bg-surface-sunken'}
`.replace(/\s+/g, ' ').trim()

/*
 * Whether the router should own this link.
 *
 * The SPA router intercepts `[data-stx-link]` and nothing else, so a plain
 * `<a href>` here was a full document load: the runtime rebooted, every signal
 * and store was discarded, and the screen flashed white. On a phone this is
 * the primary navigation control, so the app's main interaction was its worst
 * one - the single largest reason a wrapped build feels like a browser rather
 * than an app. stacksjs/stx#1988
 *
 * An absolute URL, a scheme (mailto:, tel:), a protocol-relative URL and a
 * bare fragment are left to the browser: the router does not handle those, and
 * claiming them would break a tab that points off-site.
 */
function routerOwns(url) {
  if (!url || url === '#') return false
  return !/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(url)
}

export const routerOwned = routerOwns(href)
</script>

<a
  href="{{ href }}"
  class="{{ chipClasses }}"
  data-stx-filter-chip
  @if (routerOwned)
    data-stx-link
  @endif
  @if (active)
    aria-current="true"
  @endif
>
  <span>{{ label }}</span>

  @if (hasCount)
    <span class="rounded-full bg-surface-sunken px-1.5 text-xs font-semibold text-fg-muted">{{ count }}</span>
  @endif

  @if (menu)
    {{--
      The chevron is the whole difference between "this filters the list" and
      "this opens a picker", so it is drawn rather than implied.
    --}}
    <svg class="h-4 w-4 opacity-60" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  @endif
</a>
