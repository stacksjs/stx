<script server>
export const value = $props.value || null
/*
 * `range` is the mode four apps were missing (stacksjs/stx#1981).
 *
 * `<Calendar>` was single-date only, so every app that needed "last 7 days /
 * custom range" built its own picker - four near-identical copies, hand-ported
 * between repos, four copies of the same bugs. Range selection is the half an
 * app cannot reasonably compose from what exists; the preset row is a Button
 * loop, which is why `<DateRangePicker>` sits on top of this rather than
 * replacing it.
 */
export const mode = $props.mode === 'range' ? 'range' : 'single'
export const start = $props.start || null
export const end = $props.end || null
export const minDate = $props.minDate || null
export const maxDate = $props.maxDate || null
export const disabledDates = $props.disabledDates || []
export const locale = $props.locale || 'en-US'
export const firstDayOfWeek = $props.firstDayOfWeek || 0
export const showToday = $props.showToday !== false
export const className = $props.className || ''
export const highlightToday = $props.highlightToday !== false

const baseClasses = 'bg-panel rounded-panel shadow-lg p-4 w-full max-w-sm'
export const calendarClasses = `${baseClasses} ${className}`.trim()
export const headerClasses = 'flex items-center justify-between mb-4'
export const monthYearClasses = 'text-lg font-semibold text-fg'
export const buttonClasses = 'p-2 hover:bg-surface-hover rounded-control transition-colors'
export const weekdaysClasses = 'grid grid-cols-7 gap-1 mb-2'
export const weekdayClasses = 'text-center text-xs font-medium text-fg-muted py-2'
export const daysGridClasses = 'grid grid-cols-7 gap-1'

const valueIso = value ? new Date(value).toISOString() : null
export const initialValueIso = valueIso
export const initialStartIso = start ? new Date(start).toISOString() : null
export const initialEndIso = end ? new Date(end).toISOString() : null
const minIso = minDate ? new Date(minDate).toISOString() : null
const maxIso = maxDate ? new Date(maxDate).toISOString() : null
export const minIsoValue = minIso
export const maxIsoValue = maxIso
export const disabledIsoList = disabledDates.map(d => new Date(d).toISOString())
</script>

<script client>
const emit = defineEmits()
const locale = {{ locale }}
const firstDayOfWeek = {{ firstDayOfWeek }}
const highlightToday = {{ highlightToday }}
/*
 * The ISO strings are interpolated and guarded in JS, not inlined twice through
 * a `=== null ? 'null' : …` ternary (stacksjs/stx#1981).
 *
 * That ternary produced the STRING "null", because `{{ }}` in a client script
 * emits a JSON literal - so the guard `"null" ? …` was always true and every
 * one of these became `new Date("null")`, an Invalid Date. With no props at all
 * `<Calendar />` rendered a header reading "Invalid Date NaN" and 42 cells of
 * Invalid Date: it has never worked without an explicit `value`, which is some
 * of why four apps hand-rolled a picker rather than composing this one.
 *
 * A server-side `null` interpolates as the `null` literal, so the guard means
 * what it says.
 */
const minIso = {{ minIsoValue }}
const maxIso = {{ maxIsoValue }}
const minDate = minIso ? new Date(minIso) : null
const maxDate = maxIso ? new Date(maxIso) : null
const disabledDates = ({{ disabledIsoList }}).map(s => new Date(s))
const initialValueIso = {{ initialValueIso }}
const initialValue = initialValueIso ? new Date(initialValueIso) : null

const mode = {{ mode }}
const startIso = {{ initialStartIso }}
const endIso = {{ initialEndIso }}
const initialStart = startIso ? new Date(startIso) : null
const initialEnd = endIso ? new Date(endIso) : null

const today = new Date()
const currentMonth = state(new Date(initialStart || initialValue || today))
const selectedDate = state(initialValue)
const rangeStart = state(initialStart)
const rangeEnd = state(initialEnd)
/*
 * The day under the cursor while a range is half-made, so the span previews
 * before the second click. Without it a range picker gives no feedback between
 * the two clicks, which is the moment a user is deciding.
 */
const hoverDate = state(null)

function isSameDay(d1, d2) {
  if (!d1 || !d2) return false
  return d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth() && d1.getDate() === d2.getDate()
}

function isToday(d) { return isSameDay(d, today) }

function isDisabled(d) {
  if (minDate && d < minDate) return true
  if (maxDate && d > maxDate) return true
  return disabledDates.some(x => isSameDay(x, d))
}

function getDaysInMonth(d) { return new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate() }
function getFirstDayOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1).getDay() }

const monthYearLabel = derived(() => {
  const m = currentMonth()
  return `${m.toLocaleDateString(locale, { month: 'long' })} ${m.getFullYear()}`
})

const dayNames = (() => {
  const days = []
  const baseDate = new Date(2024, 0, firstDayOfWeek)
  for (let i = 0; i < 7; i++) {
    const day = new Date(baseDate)
    day.setDate(baseDate.getDate() + i)
    days.push(day.toLocaleDateString(locale, { weekday: 'short' }))
  }
  return days
})()

const calendarDays = derived(() => {
  const month = currentMonth()
  const daysInMonth = getDaysInMonth(month)
  const firstDay = (getFirstDayOfMonth(month) - firstDayOfWeek + 7) % 7
  const days = []
  const prev = new Date(month.getFullYear(), month.getMonth() - 1, 1)
  const daysInPrev = getDaysInMonth(prev)
  for (let i = firstDay - 1; i >= 0; i--) {
    days.push({ date: new Date(prev.getFullYear(), prev.getMonth(), daysInPrev - i), isCurrentMonth: false })
  }
  for (let i = 1; i <= daysInMonth; i++) {
    days.push({ date: new Date(month.getFullYear(), month.getMonth(), i), isCurrentMonth: true })
  }
  const remaining = 42 - days.length
  const next = new Date(month.getFullYear(), month.getMonth() + 1, 1)
  for (let i = 1; i <= remaining; i++) {
    days.push({ date: new Date(next.getFullYear(), next.getMonth(), i), isCurrentMonth: false })
  }
  return days
})

function previousMonth() {
  const m = currentMonth()
  currentMonth.set(new Date(m.getFullYear(), m.getMonth() - 1, 1))
}

function nextMonthFn() {
  const m = currentMonth()
  currentMonth.set(new Date(m.getFullYear(), m.getMonth() + 1, 1))
}

/** Midnight, so a comparison is about the DAY rather than the time of day. */
function atMidnight(d) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate())
}

function selectDate(date) {
  if (isDisabled(date)) return

  if (mode !== 'range') {
    selectedDate.set(date)
    emit('change', date)
    return
  }

  const day = atMidnight(date)
  const from = rangeStart()
  const to = rangeEnd()

  // A complete range, or none at all, starts a new one. Otherwise this click
  // closes the open one.
  if (!from || to) {
    rangeStart.set(day)
    rangeEnd.set(null)
    hoverDate.set(null)
    emit('change', { start: day, end: null })
    return
  }

  // Clicking before the start reads as "I meant to begin here", which is what
  // every range picker does rather than refusing the click.
  const ordered = day < from ? { start: day, end: from } : { start: from, end: day }
  rangeStart.set(ordered.start)
  rangeEnd.set(ordered.end)
  hoverDate.set(null)
  emit('change', ordered)
}

/** The span to paint: the chosen range, or the one the cursor is proposing. */
function spanNow() {
  const from = rangeStart()
  if (!from) return null
  const to = rangeEnd() || hoverDate()
  if (!to) return { start: from, end: from }
  return to < from ? { start: to, end: from } : { start: from, end: to }
}

function onDayHover(date) {
  if (mode !== 'range' || !rangeStart() || rangeEnd()) return
  hoverDate.set(atMidnight(date))
}

function isRangeEnd(date) {
  const day = atMidnight(date)
  const from = rangeStart()
  const to = rangeEnd()
  return (!!from && day.getTime() === from.getTime()) || (!!to && day.getTime() === to.getTime())
}

function isInSpan(date) {
  const span = spanNow()
  if (!span) return false
  const t = atMidnight(date).getTime()
  return t >= span.start.getTime() && t <= span.end.getTime()
}

function goToToday() {
  currentMonth.set(new Date(today))
  selectDate(today)
}

/*
 * Joined on a space rather than concatenated.
 *
 * Every branch here appended straight onto the previous string, so the class
 * either side of each join was destroyed: a day cell rendered
 * `transition-colorstext-fgcursor-pointer` and
 * `hover:bg-surface-hoverbg-accent-solid`. Five classes were lost that way,
 * including `bg-accent-solid` - so the SELECTED day had no background at all,
 * in every app shipping this component. Building a list and joining it is the
 * shape that cannot have the bug (stacksjs/stx#1981).
 */
function dayClasses(day) {
  const inRange = mode === 'range' && isInSpan(day.date)
  const isEndpoint = mode === 'range' && isRangeEnd(day.date)
  const isSelected = mode === 'range' ? isEndpoint : isSameDay(day.date, selectedDate())
  const isTodayDate = isToday(day.date)
  const disabled = isDisabled(day.date)

  const parts = ['flex items-center justify-center h-10 w-10 text-sm transition-colors']

  // Square middles, rounded ends: a run of rounded cells reads as separate
  // chips rather than one span.
  parts.push(inRange && !isEndpoint ? 'rounded-none' : 'rounded-control')
  parts.push(day.isCurrentMonth ? 'text-fg' : 'text-fg-subtle')
  parts.push(disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer hover:bg-surface-hover')

  if (isSelected)
    parts.push('bg-accent-solid text-accent-ink hover:bg-accent-solid-hover')
  else if (inRange)
    parts.push('bg-accent-soft text-accent-soft-ink')

  if (isTodayDate && highlightToday && !isSelected)
    parts.push('border-2 border-accent')

  return parts.join(' ')
}

defineExpose({ selectedDate, currentMonth, selectDate, rangeStart, rangeEnd })
</script>

<div class="{{ calendarClasses }}">
  <div class="{{ headerClasses }}">
    <button
      type="button"
      class="{{ buttonClasses }}"
      @click="previousMonth()"
      aria-label="Previous month"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <div class="{{ monthYearClasses }}" x-text="monthYearLabel()"></div>

    <button
      type="button"
      class="{{ buttonClasses }}"
      @click="nextMonthFn()"
      aria-label="Next month"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <div class="{{ weekdaysClasses }}">
    <div :for="d in dayNames" :key="d" class="{{ weekdayClasses }}" x-text="d"></div>
  </div>

  <div class="{{ daysGridClasses }}">
    <button
      :for="day in calendarDays()"
      :key="day.date.toISOString()"
      type="button"
      :class="dayClasses(day)"
      @click="selectDate(day.date)"
      @mouseenter="onDayHover(day.date)"
      :aria-label="day.date.toLocaleDateString(locale)"
      :aria-selected="isRangeEnd(day.date)"
      :disabled="isDisabled(day.date)"
      x-text="day.date.getDate()"
    ></button>
  </div>

  @if(showToday)
    <div class="mt-4 flex justify-center">
      <button
        type="button"
        class="px-4 py-2 text-sm font-medium text-accent hover:bg-surface-hover rounded-control transition-colors"
        @click="goToToday()"
      >
        Today
      </button>
    </div>
  @endif
</div>
