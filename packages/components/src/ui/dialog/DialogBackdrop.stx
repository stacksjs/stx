<script server>
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'fixed inset-0 bg-black/25 dark:bg-black/50 transition-opacity'
const backdropClasses = `${baseClasses} ${className}`.trim()
</script>

<!-- The marker is what Dialog reads to tell a backdrop click from a click
     inside the panel: the backdrop is behind the panel, so comparing the
     click target against the panel is not the same question. -->
<component :is="{{ as }}" class="{{ backdropClasses }}" data-stx-dialog-backdrop aria-hidden="true" />
