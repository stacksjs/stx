<script server>
import { deliveredImage, getImagePlaceholder } from '@stacksjs/stx'

export const webpSrc = $props.webpSrc || ''
export const webpSrcSet = $props.webpSrcSet || ''
export const originalSrc = $props.src || ''

/**
 * The optimized variants stx prepared for this image, unless the caller wrote
 * sources of their own.
 *
 * A dev server or build that serves the public directory encodes every local
 * raster into AVIF and WebP at several widths. stx's builtin `<StxImage>` reads
 * that catalog itself; this component used to ignore it. Since stx registers
 * this package on its own whenever it is installed, this `<Image>` is the one
 * a bare `<Image>` tag resolves to, and every image in the app went out as the
 * original full-size file.
 */
const explicitSources = Array.isArray($props.sources) ? $props.sources : []
const explicitSrcSet = $props.srcSet || $props.srcset || ''
const delivered = !explicitSrcSet && !explicitSources.length && !webpSrc && !webpSrcSet ? deliveredImage($props.src || '') : undefined

export const src = delivered ? delivered.src : ($props.src || '')
export const srcSet = delivered ? delivered.srcset : explicitSrcSet
// Width descriptors mean nothing without `sizes`; 100vw is what a browser
// assumes anyway, said out loud.
export const sizes = $props.sizes || (delivered ? '100vw' : '')
export const sources = explicitSources.length ? explicitSources : (delivered ? delivered.sources : [])
export const decorative = $bool($props.decorative)
if (!decorative && !$props.alt?.trim())
  throw new TypeError('Image alt text is required unless decorative is true')
// Keep the authored text for a decorative image that becomes meaningful later.
export const originalAlt = $props.alt ?? ''
export const alt = decorative ? '' : originalAlt
export const width = $props.width || delivered?.width
export const height = $props.height || delivered?.height
export const priority = $bool($props.priority)
export const lazy = $bool($props.lazy, true)
export const loading = priority ? 'eager' : ($props.loading || (lazy ? 'lazy' : 'eager'))
export const decoding = $props.decoding || 'async'
export const fetchpriority = priority ? 'high' : ($props.fetchpriority || 'auto')

/**
 * A CSS value painted behind the image while it arrives - a colour, a
 * gradient, or `url("data:image/...")` for a low-quality preview. Anything
 * `background` accepts.
 *
 * Behind, not on the image itself: a background set on an `<img>` shows
 * through anything transparent in it and stays there once it has loaded,
 * which is a permanent artefact on every PNG with an alpha channel.
 */
const placeholderMode = $props.placeholder
// Stacks' former default accepted a preview URL; keep CSS backgrounds too.
const customPlaceholder = typeof placeholderMode === 'string' && /^(?:data:image\/|https?:\/\/|\/|\.{1,2}\/)/i.test(placeholderMode)
  ? `url(${JSON.stringify(placeholderMode)})` : placeholderMode
const imagePlaceholder = getImagePlaceholder($props.src || '')
const placeholderColor = $props.placeholderColor || imagePlaceholder?.color || '#e5e7eb'
const preview = delivered?.placeholder || imagePlaceholder?.dataUrl
export const placeholder = placeholderMode === 'empty' || placeholderMode === 'none' ? ''
  : placeholderMode === 'color' ? (imagePlaceholder?.transparent ? '' : placeholderColor)
    : placeholderMode === 'blur' || placeholderMode === 'thumbhash' ? (imagePlaceholder?.transparent ? '' : preview ? `url("${preview}")` : placeholderColor)
      : customPlaceholder || (delivered?.placeholder ? `url("${delivered.placeholder}")` : '')
export const aspectRatio = $props.aspectRatio
export const authoredObjectFit = $props.objectFit || ''
export const authoredFit = $props.fit || ''
export const objectFit = authoredObjectFit || authoredFit || 'cover'
export const authoredObjectPosition = $props.objectPosition || ''
export const authoredPosition = $props.position || ''
export const objectPosition = authoredObjectPosition || authoredPosition || 'center'
export const rounded = $bool($props.rounded)
export const zoomOnHover = $bool($props.zoomOnHover)
export const className = $props.className || $props.class || ''

export const hasWebP = !!(webpSrc || webpSrcSet)

const RADII = {
  true: '0.5rem',
  full: '9999px',
  sm: '0.125rem',
  md: '0.375rem',
  lg: '0.5rem',
  xl: '0.75rem',
  '2xl': '1rem',
}

const radius = rounded ? (RADII[String(rounded)] || RADII.true) : ''

/**
 * Styles inline rather than as utility classes.
 *
 * This component ships in a library and renders inside applications that do
 * not necessarily use a utility CSS framework - and even where one is present,
 * its scanner has to be pointed at `node_modules` to see class names written
 * here, which is not the default anywhere. It previously emitted `relative`,
 * `block`, `overflow-hidden`, `h-full`, `w-full` and `bg-stone-100`, and in an
 * app whose scanner never saw this file not one of those rules existed: every
 * image rendered at its intrinsic size inside an unstyled wrapper.
 *
 * Width and height at 100% make the wrapper transparent to layout. Against a
 * parent with a definite height it passes that height down; against one
 * without, it resolves to `auto` and the image's own ratio decides. Both
 * matter, because a stylesheet may size either the box or the image.
 */
export const frameStyle = [
  'position: relative',
  'display: block',
  'width: 100%',
  'height: 100%',
  'overflow: hidden',
  /*
   * Only when asked for. Deriving a ratio from the intrinsic width and height
   * looks like free layout stability and is really an override: an app that
   * sets its own crop in CSS finds this silently winning, and its images come
   * out the wrong shape. `width` and `height` on the <img> already reserve
   * the right space wherever CSS says nothing.
   */
  aspectRatio ? `aspect-ratio: ${aspectRatio}` : '',
  radius ? `border-radius: ${radius}` : '',
  placeholder ? `background: ${placeholder} center / cover no-repeat` : '',
].filter(Boolean).join('; ')

export const imageStyle = [
  'display: block',
  'width: 100%',
  'height: 100%',
  `object-fit: ${objectFit}`,
  `object-position: ${objectPosition}`,
  radius ? `border-radius: ${radius}` : '',
  zoomOnHover ? 'transition: transform 0.3s ease-in-out' : '',
].filter(Boolean).join('; ')
</script>

<script client>
const imageSrc = useReactiveProp('src', {{ originalSrc }})
const liveAlt = useReactiveProp('alt', {{ originalAlt }})
const liveDecorative = useReactiveProp('decorative', {{ decorative }})
// Typed parent writes can bypass DOM parsing; keep the server $bool contract.
const isDecorative = derived(() => {
  const value = liveDecorative()
  if (value == null) return false
  if (typeof value === 'string') return !['false', '0', 'off', 'no'].includes(value.trim().toLowerCase())
  return Boolean(value)
})
const imageAlt = derived(() => isDecorative() ? '' : (liveAlt() == null ? '' : String(liveAlt())))
// Keep the documented alias live without letting it override objectFit.
const primaryFit = useReactiveProp('objectFit', {{ authoredObjectFit }})
const fallbackFit = useReactiveProp('fit', {{ authoredFit }})
const imageFit = derived(() => primaryFit() || fallbackFit() || 'cover')
const primaryPosition = useReactiveProp('objectPosition', {{ authoredObjectPosition }})
const fallbackPosition = useReactiveProp('position', {{ authoredPosition }})
const imagePosition = derived(() => primaryPosition() || fallbackPosition() || 'center')
const imageWidth = useReactiveProp('width', {{ width ?? null }})
const imageHeight = useReactiveProp('height', {{ height ?? null }})
const liveRatio = useReactiveProp('aspectRatio', {{ aspectRatio ?? null }})
const nativeImage = !!window.stx._host.isNative
const emit = defineEmits(['load', 'error'])
// Image load/error events do not bubble to the picture/component root.
// Forward the original browser event or host payload, never a lossy copy.
function forwardImageEvent(name, event) {
  if (event.target?.isConnected !== false) emit(name, event)
}
const imageRatio = derived(() => {
  const value = String(liveRatio() ?? '').trim()
  if (!nativeImage) return value || null
  // Hosts take a finite number, not CSS's "width / height" syntax. No
  // authored ratio means auto layout; never infer one from intrinsic size.
  if (!/^\d+(?:\.\d+)?(?:\s*\/\s*\d+(?:\.\d+)?)?$/.test(value)) return null
  const [width, height = 1] = value.split('/').map(Number)
  const ratio = width / height
  return width > 0 && height > 0 && Number.isFinite(ratio) ? ratio : null
})
// Preserve the delivered URL/candidates at hydration. A replacement URL must
// not keep selecting a responsive candidate belonging to the previous image.
const currentSrc = derived(() => imageSrc() === {{ originalSrc }} ? {{ src }} : (imageSrc() == null ? '' : String(imageSrc())))
const keepInitialSources = derived(() => !!currentSrc() && imageSrc() === {{ originalSrc }})
const initialBackground = {{ placeholder ? `${placeholder} center / cover no-repeat` : '' }}
</script>

<picture class="{{ className }}" style="{{ frameStyle }}" :style="{ aspectRatio: imageRatio()@if(placeholder), background: keepInitialSources() ? initialBackground : 'none'@endif }">
  @foreach(sources as source)
    <source
      @if(source.type)type="{{ source.type }}"@endif
      @if(source.media)media="{{ source.media }}"@endif
      srcset="{{ source.srcset }}"
      :srcset="keepInitialSources() ? {{ JSON.stringify(source.srcset) }} : null"
      @if(source.sizes || sizes)sizes="{{ source.sizes || sizes }}"@endif
    />
  @endforeach
  @if(hasWebP)
    <source
      type="image/webp"
      @if(webpSrcSet)srcset="{{ webpSrcSet }}"@endif
      @if(webpSrc && !webpSrcSet)srcset="{{ webpSrc }}"@endif
      :srcset="keepInitialSources() ? {{ JSON.stringify(webpSrcSet || webpSrc) }} : null"
      @if(sizes)sizes="{{ sizes }}"@endif
    />
  @endif
  {{--
    One <img>, always carrying its real `src`.

    What was here before put a grey SVG in `src`, moved the real URL to
    `data-src`, and swapped them from an IntersectionObserver on mount. That
    meant no image at all without JavaScript - for a crawler, for a reader
    view, for anyone on a failed bundle - while `loading="lazy"` was sitting
    on the same tag already doing the job natively, in every browser since
    2020, without blocking the parser or double-fetching through a probe.
  --}}
  <img
    @if(src)src="{{ src }}"@endif
    data-stx-native-host-root
    :src="currentSrc() || null"
    @load="forwardImageEvent('load', $event)"
    @error="forwardImageEvent('error', $event)"
    @if(srcSet)srcset="{{ srcSet }}"@endif
    :srcset="keepInitialSources() ? {{ JSON.stringify(srcSet) }} || null : null"
    @if(sizes)sizes="{{ sizes }}"@endif
    alt="{{ alt }}"
    :alt="imageAlt()"
    @if(width)width="{{ width }}"@endif
    @if(height)height="{{ height }}"@endif
    :width="imageWidth() ?? null"
    :height="imageHeight() ?? null"
    loading="{{ loading }}"
    @if(decorative)aria-hidden="true"@endif
    :aria-hidden="isDecorative() ? 'true' : null"
    decoding="{{ decoding }}"
    fetchpriority="{{ fetchpriority }}"
    style="{{ imageStyle }}"
    :style="{ objectFit: imageFit(), objectPosition: imagePosition() }"
  />
</picture>
