<script server>
import { deliveredImage } from '@stacksjs/stx'

export const webpSrc = $props.webpSrc || ''
export const webpSrcSet = $props.webpSrcSet || ''

/**
 * The optimized variants stx prepared for this image, unless the caller wrote
 * sources of their own.
 *
 * A dev server or build that serves the public directory encodes every local
 * raster into AVIF and WebP at several widths. stx's builtin `<StxImage>` reads
 * that catalog itself; this component used to ignore it. Since stx registers
 * this package on its own whenever it is installed, this `<Image>` is the one
 * a bare `<Image>` tag resolves to, and every image in the app went out as the
 * original full-size file.
 */
const delivered = !$props.srcSet && !webpSrc && !webpSrcSet ? deliveredImage($props.src || '') : undefined

export const src = delivered ? delivered.src : ($props.src || '')
export const srcSet = delivered ? delivered.srcset : ($props.srcSet || '')
// Width descriptors mean nothing without `sizes`; 100vw is what a browser
// assumes anyway, said out loud.
export const sizes = $props.sizes || (delivered ? '100vw' : '')
export const sources = delivered ? delivered.sources : []
export const alt = $props.alt || ''
export const width = $props.width || delivered?.width
export const height = $props.height || delivered?.height
export const priority = $bool($props.priority)
export const lazy = priority ? false : $bool($props.lazy, true)
export const decoding = $props.decoding || 'async'
export const fetchpriority = priority ? 'high' : ($props.fetchpriority || 'auto')

/**
 * A CSS value painted behind the image while it arrives - a colour, a
 * gradient, or `url("data:image/...")` for a low-quality preview. Anything
 * `background` accepts.
 *
 * Behind, not on the image itself: a background set on an `<img>` shows
 * through anything transparent in it and stays there once it has loaded,
 * which is a permanent artefact on every PNG with an alpha channel.
 */
export const placeholder = $props.placeholder || (delivered?.placeholder ? `url("${delivered.placeholder}")` : '')
export const aspectRatio = $props.aspectRatio
export const objectFit = $props.objectFit || 'cover'
export const objectPosition = $props.objectPosition || 'center'
export const rounded = $bool($props.rounded)
export const zoomOnHover = $bool($props.zoomOnHover)
export const className = $props.className || ''

export const hasWebP = !!(webpSrc || webpSrcSet)

const RADII = {
  true: '0.5rem',
  full: '9999px',
  sm: '0.125rem',
  md: '0.375rem',
  lg: '0.5rem',
  xl: '0.75rem',
  '2xl': '1rem',
}

const radius = rounded ? (RADII[String(rounded)] || RADII.true) : ''

/**
 * Styles inline rather than as utility classes.
 *
 * This component ships in a library and renders inside applications that do
 * not necessarily use a utility CSS framework - and even where one is present,
 * its scanner has to be pointed at `node_modules` to see class names written
 * here, which is not the default anywhere. It previously emitted `relative`,
 * `block`, `overflow-hidden`, `h-full`, `w-full` and `bg-stone-100`, and in an
 * app whose scanner never saw this file not one of those rules existed: every
 * image rendered at its intrinsic size inside an unstyled wrapper.
 *
 * Width and height at 100% make the wrapper transparent to layout. Against a
 * parent with a definite height it passes that height down; against one
 * without, it resolves to `auto` and the image's own ratio decides. Both
 * matter, because a stylesheet may size either the box or the image.
 */
export const frameStyle = [
  'position: relative',
  'display: block',
  'width: 100%',
  'height: 100%',
  'overflow: hidden',
  /*
   * Only when asked for. Deriving a ratio from the intrinsic width and height
   * looks like free layout stability and is really an override: an app that
   * sets its own crop in CSS finds this silently winning, and its images come
   * out the wrong shape. `width` and `height` on the <img> already reserve
   * the right space wherever CSS says nothing.
   */
  aspectRatio ? `aspect-ratio: ${aspectRatio}` : '',
  radius ? `border-radius: ${radius}` : '',
  placeholder ? `background: ${placeholder} center / cover no-repeat` : '',
].filter(Boolean).join('; ')

export const imageStyle = [
  'display: block',
  'width: 100%',
  'height: 100%',
  `object-fit: ${objectFit}`,
  `object-position: ${objectPosition}`,
  radius ? `border-radius: ${radius}` : '',
  zoomOnHover ? 'transition: transform 0.3s ease-in-out' : '',
].filter(Boolean).join('; ')
</script>

<picture class="{{ className }}" style="{{ frameStyle }}">
  @foreach(sources as source)
    <source type="{{ source.type }}" srcset="{{ source.srcset }}" sizes="{{ sizes }}" />
  @endforeach
  @if(hasWebP)
    <source
      type="image/webp"
      @if(webpSrcSet)srcset="{{ webpSrcSet }}"@endif
      @if(webpSrc && !webpSrcSet)srcset="{{ webpSrc }}"@endif
      @if(sizes)sizes="{{ sizes }}"@endif
    />
  @endif
  {{--
    One <img>, always carrying its real `src`.

    What was here before put a grey SVG in `src`, moved the real URL to
    `data-src`, and swapped them from an IntersectionObserver on mount. That
    meant no image at all without JavaScript - for a crawler, for a reader
    view, for anyone on a failed bundle - while `loading="lazy"` was sitting
    on the same tag already doing the job natively, in every browser since
    2020, without blocking the parser or double-fetching through a probe.
  --}}
  <img
    src="{{ src }}"
    @if(srcSet)srcset="{{ srcSet }}"@endif
    @if(sizes)sizes="{{ sizes }}"@endif
    alt="{{ alt }}"
    @if(width)width="{{ width }}"@endif
    @if(height)height="{{ height }}"@endif
    loading="{{ lazy ? 'lazy' : 'eager' }}"
    decoding="{{ decoding }}"
    fetchpriority="{{ fetchpriority }}"
    style="{{ imageStyle }}"
  />
</picture>
