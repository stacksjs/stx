<script server cache>
export const variant = $props.variant || 'default'
export const padding = $props.padding || 'default'
export const hover = $bool($props.hover)
export const clickable = $bool($props.clickable)
export const image = $props.image || ''
export const imageAlt = $props.imageAlt || ''
export const className = $props.className || ''

const variantClasses = {
  default: 'bg-panel border border-line',
  outlined: 'bg-transparent border-2 border-line-strong',
  elevated: 'bg-panel shadow-lg border-0',
  flat: 'bg-surface border-0',
}

const paddingClasses = { none: 'p-0', sm: 'p-3', default: 'p-6', lg: 'p-8' }
const hoverClasses = hover ? 'transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5' : ''
const clickableClasses = clickable ? 'cursor-pointer' : ''

export const cardClasses = `rounded-panel overflow-hidden ${variantClasses[variant] || variantClasses.default} ${paddingClasses[image ? 'none' : padding] || paddingClasses.default} ${hoverClasses} ${clickableClasses} ${className}`.trim()
export const imageClasses = `w-full h-48 object-cover`.trim()
export const contentClasses = `${image ? paddingClasses[padding] || paddingClasses.default : ''}`.trim()
</script>

<script client>
const emit = defineEmits()
const isClickable = {{ clickable }}

function onClick(event) {
  if (!isClickable) return
  emit('click', event)
}

function onKey(event) {
  if (!isClickable) return
  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault()
    emit('click', event)
  }
}
</script>

@if(clickable)
  <div
    class="{{ cardClasses }}"
    @click="onClick($event)"
    @keydown="onKey($event)"
    role="button"
    tabindex="0"
  >
    @if(image)
      <img src="{{ image }}" alt="{{ imageAlt }}" class="{{ imageClasses }}" />
    @endif
    <div class="{{ contentClasses }}">
      <slot />
    </div>
  </div>
@else
  <div class="{{ cardClasses }}">
    @if(image)
      <img src="{{ image }}" alt="{{ imageAlt }}" class="{{ imageClasses }}" />
    @endif
    <div class="{{ contentClasses }}">
      <slot />
    </div>
  </div>
@endif
