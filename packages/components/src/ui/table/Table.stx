<script server>
export const className = $props.className || ''
export const striped = $bool($props.striped)
export const hoverable = $bool($props.hoverable, true)

const baseClasses = 'min-w-full divide-y divide-line'
const tableClasses = `${baseClasses} ${className}`.trim()
</script>

<div class="overflow-x-auto">
  <table class="{{ tableClasses }}">
    <slot :striped="striped" :hoverable="hoverable" />
  </table>
</div>
