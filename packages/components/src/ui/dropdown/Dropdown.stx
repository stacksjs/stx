<script server>
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative inline-block text-left'
export const dropdownClasses = `${baseClasses} ${className}`.trim()
export const dropdownInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const dropdownInstanceId = {{ dropdownInstanceId }}
const isOpen = state(false)
let rootEl = null
let outsideHandler = null

/*
 * The trigger carries the open state for assistive tech. `isOpen` already
 * drove `data-state` on the root, which styles the panel but says nothing to a
 * screen reader: the button announced itself as a plain button, with no
 * indication that it opens anything or whether it is open right now.
 */
function syncExpanded() {
  if (!rootEl) return
  const trigger = rootEl.querySelector('[data-stx-dropdown-button]')
  if (!trigger) return
  trigger.setAttribute('aria-expanded', isOpen() ? 'true' : 'false')
  const panel = rootEl.querySelector('[data-stx-dropdown-items]')
  if (!panel) return
  if (!panel.id) panel.id = 'stx-dropdown-panel-' + dropdownInstanceId
  trigger.setAttribute('aria-controls', panel.id)
}

function toggle() {
  isOpen.set(!isOpen())
  emit('change', isOpen())
  syncExpanded()
}

function open() {
  if (isOpen()) return
  isOpen.set(true)
  emit('change', true)
  syncExpanded()
}

function close() {
  if (!isOpen()) return
  isOpen.set(false)
  emit('change', false)
  syncExpanded()
}

function onItemSelect(event) {
  event.stopPropagation()
  emit('select', event.detail)
  close()
}

function onToggle(event) { event.stopPropagation(); toggle() }
function onOpen(event) { event.stopPropagation(); open() }
function onClose(event) { event.stopPropagation(); close() }

/*
 * Escape dismisses it, from anywhere rather than only from inside the panel.
 *
 * Opening one of these does not move focus, so a keydown bound on the panel
 * never sees the first Escape - focus is still on whatever opened it. Drawer
 * reached the same conclusion and binds on the document; this follows it, and
 * only acts while open so one open popup does not swallow Escape for the page.
 *
 * Focus goes back to the trigger, but only if it had moved into the panel:
 * otherwise this would steal it from wherever the user actually is.
 */
function onDocumentKey(event) {
  if (event.key !== 'Escape' || !isOpen()) return
  close()
  if (!rootEl) return
  const active = rootEl.ownerDocument && rootEl.ownerDocument.activeElement
  if (!active || !rootEl.contains(active)) return
  const trigger = rootEl.querySelector('[data-stx-dropdown-button]')
  if (trigger && trigger.focus) trigger.focus()
}

/*
 * Roving focus over the menu items.
 *
 * `role="menuitem"` on a div is not focusable on its own, so the items carry
 * tabindex="-1" and focus is moved programmatically -- the APG menu-button
 * arrangement. Only the items are in the ring; a disabled one is skipped
 * rather than focused and ignored, because landing on something inert reads as
 * the menu being broken.
 */
function menuItems() {
  if (!rootEl) return []
  const all = rootEl.querySelectorAll('[data-stx-dropdown-item]')
  return Array.prototype.filter.call(all, item => item.getAttribute('aria-disabled') !== 'true')
}

function focusItemAt(index) {
  const items = menuItems()
  if (!items.length) return
  const target = items[(index + items.length) % items.length]
  if (target && target.focus) target.focus()
}

function focusedItemIndex() {
  const doc = rootEl && rootEl.ownerDocument
  return doc ? menuItems().indexOf(doc.activeElement) : -1
}

/*
 * Keys are handled only while the event comes from inside this dropdown.
 * Bound on the document so Escape works before focus has moved into the panel,
 * which means an unguarded ArrowDown here would hijack scrolling for the whole
 * page.
 */
function onMenuKey(event) {
  if (!rootEl || !rootEl.contains(event.target)) return
  const key = event.key

  if (!isOpen()) {
    // ArrowDown opens and lands on the first item; ArrowUp on the last, which
    // is how a menu button reached from below behaves.
    if (key !== 'ArrowDown' && key !== 'ArrowUp') return
    event.preventDefault()
    open()
    focusItemAt(key === 'ArrowDown' ? 0 : menuItems().length - 1)
    return
  }

  if (key === 'ArrowDown' || key === 'ArrowUp') {
    event.preventDefault()
    const current = focusedItemIndex()
    if (current === -1) focusItemAt(key === 'ArrowDown' ? 0 : menuItems().length - 1)
    else focusItemAt(current + (key === 'ArrowDown' ? 1 : -1))
    return
  }

  if (key === 'Home' || key === 'End') {
    event.preventDefault()
    focusItemAt(key === 'Home' ? 0 : menuItems().length - 1)
    return
  }

  if (key === 'Enter' || key === ' ') {
    // The item is a div, so Enter does not activate it the way it would a
    // button. Clicking it runs the handler the item already has.
    const current = focusedItemIndex()
    if (current === -1) return
    event.preventDefault()
    menuItems()[current].click()
    return
  }

  // Tabbing out of an open menu closes it, rather than leaving it hanging
  // over the content the user has moved to.
  if (key === 'Tab') close()
}

onMount(() => {
  rootEl = document.querySelector(`[data-dropdown-id="${dropdownInstanceId}"]`)
  syncExpanded()
  outsideHandler = (event) => {
    if (!isOpen()) return
    if (rootEl && !rootEl.contains(event.target)) close()
  }
  document.addEventListener('click', outsideHandler, true)
  document.addEventListener('keydown', onDocumentKey)
  document.addEventListener('keydown', onMenuKey)
})

onDestroy(() => {
  if (outsideHandler) document.removeEventListener('click', outsideHandler, true)
  document.removeEventListener('keydown', onDocumentKey)
  document.removeEventListener('keydown', onMenuKey)
})

const dataState = derived(() => isOpen() ? 'open' : 'closed')
const dataExpanded = derived(() => isOpen() ? 'true' : 'false')

defineExpose({ isOpen, toggle, open, close })
</script>

<component
  :is="{{ as }}"
  class="{{ dropdownClasses }}"
  data-stx-dropdown
  data-dropdown-id="{{ dropdownInstanceId }}"
  :data-state="dataState()"
  :data-expanded="dataExpanded()"
  @stx:dropdown-toggle="onToggle($event)"
  @stx:dropdown-open="onOpen($event)"
  @stx:dropdown-close="onClose($event)"
  @stx:dropdown-select="onItemSelect($event)"
>
  <slot />
</component>

<style>
[data-stx-dropdown][data-state="closed"] [data-stx-dropdown-items] {
  display: none;
}
</style>
