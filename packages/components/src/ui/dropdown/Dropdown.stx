<script server>
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative inline-block text-left'
export const dropdownClasses = `${baseClasses} ${className}`.trim()
export const dropdownInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const dropdownInstanceId = {{ dropdownInstanceId }}
const isOpen = state(false)
let rootEl = null
let outsideHandler = null

/*
 * The trigger carries the open state for assistive tech. `isOpen` already
 * drove `data-state` on the root, which styles the panel but says nothing to a
 * screen reader: the button announced itself as a plain button, with no
 * indication that it opens anything or whether it is open right now.
 */
function syncExpanded() {
  if (!rootEl) return
  const trigger = rootEl.querySelector('[data-stx-dropdown-button]')
  if (!trigger) return
  trigger.setAttribute('aria-expanded', isOpen() ? 'true' : 'false')
  const panel = rootEl.querySelector('[data-stx-dropdown-items]')
  if (!panel) return
  if (!panel.id) panel.id = 'stx-dropdown-panel-' + dropdownInstanceId
  trigger.setAttribute('aria-controls', panel.id)
}

function toggle() {
  isOpen.set(!isOpen())
  emit('change', isOpen())
  syncExpanded()
}

function open() {
  if (isOpen()) return
  isOpen.set(true)
  emit('change', true)
  syncExpanded()
}

function close() {
  if (!isOpen()) return
  isOpen.set(false)
  emit('change', false)
  syncExpanded()
}

function onItemSelect(event) {
  event.stopPropagation()
  emit('select', event.detail)
  close()
}

function onToggle(event) { event.stopPropagation(); toggle() }
function onOpen(event) { event.stopPropagation(); open() }
function onClose(event) { event.stopPropagation(); close() }

onMount(() => {
  rootEl = document.querySelector(`[data-dropdown-id="${dropdownInstanceId}"]`)
  syncExpanded()
  outsideHandler = (event) => {
    if (!isOpen()) return
    if (rootEl && !rootEl.contains(event.target)) close()
  }
  document.addEventListener('click', outsideHandler, true)
})

onDestroy(() => {
  if (outsideHandler) document.removeEventListener('click', outsideHandler, true)
})

const dataState = derived(() => isOpen() ? 'open' : 'closed')
const dataExpanded = derived(() => isOpen() ? 'true' : 'false')

defineExpose({ isOpen, toggle, open, close })
</script>

<component
  :is="{{ as }}"
  class="{{ dropdownClasses }}"
  data-stx-dropdown
  data-dropdown-id="{{ dropdownInstanceId }}"
  :data-state="dataState()"
  :data-expanded="dataExpanded()"
  @stx:dropdown-toggle="onToggle($event)"
  @stx:dropdown-open="onOpen($event)"
  @stx:dropdown-close="onClose($event)"
  @stx:dropdown-select="onItemSelect($event)"
>
  <slot />
</component>

<style>
[data-stx-dropdown][data-state="closed"] [data-stx-dropdown-items] {
  display: none;
}
</style>
