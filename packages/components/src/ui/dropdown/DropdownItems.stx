<script server>
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'absolute z-10 mt-2 origin-top-right divide-y divide-line rounded-panel bg-panel shadow-lg ring-1 ring-line focus:outline-none'
export const itemsClasses = `${baseClasses} ${className}`.trim()
</script>

<component
  :is="{{ as }}"
  class="{{ itemsClasses }}"
  data-stx-dropdown-items
  role="menu"
  aria-orientation="vertical"
  tabindex="-1"
>
  <slot />
</component>
