<script server>
export const open = $bool($props.open)
export const initialQuery = $props.query || ''
export const className = $props.className || ''

const baseClasses = 'fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20'
export const paletteClasses = `${baseClasses} ${className}`.trim()
export const paletteInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const paletteInstanceId = {{ paletteInstanceId }}
const isOpen = state({{ open }})
const query = state({{ initialQuery }})

function close() {
  if (!isOpen()) return
  isOpen.set(false)
  setActive(null)
  emit('close')
}

function show() {
  if (isOpen()) return
  isOpen.set(true)
}

function onQueryInput(event) {
  query.set(event.target.value)
  emit('query', event.target.value)
}

function onItemSelect(event) {
  event.stopPropagation()
  emit('select', event.detail)
  close()
}

function panelEl() {
  return document.querySelector(`[data-palette-id="${paletteInstanceId}"] [data-stx-command-palette-panel]`)
}

/*
 * The keyboard, as a combobox (stacksjs/stx#2231). Focus stays in the search
 * field so the user can keep typing; the command arrowed to is the ACTIVE
 * option, named by aria-activedescendant on the field and marked
 * aria-selected, and Enter clicks it, so it is selected exactly as a pointer
 * selects it. The items used to be plain divs with only a click handler, so a
 * keyboard could open the palette and close it and do nothing in between.
 *
 * Held as the element rather than an index: the page filters the results as
 * the query changes, and an index would then point at a different command.
 */
let activeItem = null

function listEl() {
  return panelEl()?.querySelector('[data-stx-command-palette-list]') ?? null
}

/** The commands showing now: an item the page hid with :show or hidden is skipped. */
function itemElements() {
  const list = listEl()
  if (!list) return []
  return Array.prototype.filter.call(list.querySelectorAll('[data-stx-command-item]'), (item) => {
    for (let node = item; node && node !== list; node = node.parentElement) {
      if (node.hidden || (node.style && node.style.display === 'none')) return false
    }
    return true
  })
}

function setActive(item) {
  activeItem = item
  const items = itemElements()
  const doc = panelEl()?.ownerDocument || document
  items.forEach((option, index) => {
    // aria-activedescendant needs an id that is unique on the page.
    if (!option.id || doc.querySelectorAll('[id="' + option.id + '"]').length !== 1)
      option.id = 'stx-command-option-' + paletteInstanceId + '-' + index
    option.setAttribute('aria-selected', option === item ? 'true' : 'false')
  })
  const input = panelEl()?.querySelector('[data-stx-command-palette-input]')
  if (!input) return
  if (item) input.setAttribute('aria-activedescendant', item.id)
  else input.removeAttribute('aria-activedescendant')
}

function moveActive(delta) {
  const items = itemElements()
  if (!items.length) return
  const from = items.indexOf(activeItem)
  const next = from < 0
    ? (delta > 0 ? 0 : items.length - 1)
    : (from + delta + items.length) % items.length
  setActive(items[next])
  // The list scrolls, and nothing moves focus there to bring the option in.
  if (items[next].scrollIntoView) items[next].scrollIntoView({ block: 'nearest' })
}

function onPaletteKey(event) {
  const key = event.key
  if (key === 'ArrowDown' || key === 'ArrowUp') {
    event.preventDefault()
    moveActive(key === 'ArrowDown' ? 1 : -1)
  }
  else if (key === 'Home' || key === 'End') {
    event.preventDefault()
    activeItem = null
    moveActive(key === 'Home' ? 1 : -1)
  }
  else if (key === 'Enter' && activeItem && itemElements().includes(activeItem)) {
    event.preventDefault()
    activeItem.click()
  }
}

/*
 * The results changed under the active command: keep it while it still
 * shows, and point at nothing once it is gone rather than at a stale id.
 */
let resultsObserver = null
onMount(() => {
  const list = listEl()
  if (!list || typeof MutationObserver === 'undefined') return
  resultsObserver = new MutationObserver(() => {
    if (activeItem && !itemElements().includes(activeItem)) setActive(null)
  })
  resultsObserver.observe(list, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'hidden'] })
})

/*
 * The palette takes over the page, so it is a modal layer on the page's
 * overlay stack (window.stx.overlays): the page held still behind it, focus
 * straight into the search field and back to whatever opened it, Tab kept
 * inside, and Escape for whichever overlay is on top. It used to listen for
 * Escape on the document and do none of the rest, so focus stayed behind it
 * and a palette opened from a dialog closed the dialog too (stacksjs/stx#2057).
 */
effect(() => {
  if (isOpen()) {
    window.stx.overlays.open(paletteInstanceId, {
      panel: panelEl,
      onEscape: close,
      initialFocus: () => panelEl()?.querySelector('input'),
    })
  }
  else {
    window.stx.overlays.close(paletteInstanceId)
  }
})

onDestroy(() => {
  window.stx.overlays.close(paletteInstanceId)
  resultsObserver?.disconnect()
})

defineExpose({ isOpen, query, show, close })
</script>

<div
  :show="isOpen()"
  class="{{ paletteClasses }}"
  data-stx-command-palette
  data-palette-id="{{ paletteInstanceId }}"
  @stx:command-select="onItemSelect($event)"
>
  <div class="fixed inset-0 bg-neutral-500/25 dark:bg-neutral-500/50 transition-opacity" aria-hidden="true" @click="close()"></div>

  <div
    data-stx-command-palette-panel
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
    tabindex="-1"
    class="mx-auto max-w-xl transform divide-y divide-line overflow-hidden rounded-xl bg-panel shadow-2xl ring-1 ring-line transition-all relative"
  >
    <div class="relative">
      <svg class="pointer-events-none absolute top-3.5 left-4 h-5 w-5 text-fg-soft" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls="stx-command-palette-list-{{ paletteInstanceId }}"
        data-stx-command-palette-input
        class="h-12 w-full border-0 bg-transparent pl-11 pr-4 text-fg placeholder-fg-soft focus:ring-0 sm:text-sm"
        placeholder="Search..."
        aria-label="Search commands"
        :value="query()"
        @input="onQueryInput($event)"
        @keydown="onPaletteKey($event)"
      />
    </div>

    <div
      id="stx-command-palette-list-{{ paletteInstanceId }}"
      role="listbox"
      aria-label="Commands"
      data-stx-command-palette-list
      class="max-h-96 overflow-y-auto py-2"
    >
      <slot />
    </div>
  </div>
</div>
