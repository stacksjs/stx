<script server>
export const className = $props.className || ''
export const as = $props.as || 'button'
export const disabled = $bool($props.disabled)

const baseClasses = 'inline-flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-panel'
export const buttonClasses = `${baseClasses} ${className}`.trim()
</script>

<script client>
const emit = defineEmits()
const isDisabled = useReactiveProp('disabled', {{ disabled }})

function onClick(event) {
  if (isDisabled()) return
  emit('click', event)
  window.stx._host.emitComponentEvent(event.currentTarget, new CustomEvent('stx:popover-toggle', { bubbles: true }))
}
</script>

<component
  :is="{{ as }}"
  class="{{ buttonClasses }}"
  data-stx-popover-button
  aria-expanded="false"
  :disabled="isDisabled()"
  :aria-disabled="isDisabled() ? 'true' : 'false'"
  @click="onClick($event)"
>
  <slot />
</component>
