<script server>
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative'
export const popoverClasses = `${baseClasses} ${className}`.trim()
export const popoverInstanceId = $uid
</script>

<script client>
import { trackNativePopup } from '../../utils/tooltip-position'
const emit = defineEmits()
const popoverInstanceId = {{ popoverInstanceId }}
const isOpen = state(false)
const mounted = state(false)
const rootRef = useRef('rootRef')
const tree = window.stx._host
const nativePopup = !!tree.isNative
let rootEl = null
let outsideHandler = null
let stopPositioning = null

function ownPart(marker) {
  if (!rootEl) return null
  return tree.descendants(rootEl).find(node => {
    if (tree.getAttribute(node, marker) == null) return false
    for (let parent = tree.parent(node); parent; parent = tree.parent(parent)) {
      if (tree.getAttribute(parent, 'data-stx-popover') != null) return parent === rootEl
    }
    return false
  }) || null
}

/*
 * The trigger carries the open state for assistive tech. `isOpen` already
 * drove `data-state` on the root, which styles the panel but says nothing to a
 * screen reader: the button announced itself as a plain button, with no
 * indication that it opens anything or whether it is open right now.
 */
function syncExpanded() {
  if (!rootEl) return
  const trigger = ownPart('data-stx-popover-button')
  if (!trigger) return
  trigger.setAttribute('aria-expanded', isOpen() ? 'true' : 'false')
  const panel = ownPart('data-stx-popover-panel')
  if (!panel) return
  const panelId = tree.getAttribute(panel, 'id') || 'stx-popover-panel-' + popoverInstanceId
  tree.setAttribute(panel, 'id', panelId)
  tree.setAttribute(trigger, 'aria-controls', panelId)
}

function open() { if (!isOpen()) { isOpen.set(true); emit('change', true); syncExpanded() } }
function close() { if (isOpen()) { isOpen.set(false); emit('change', false); syncExpanded() } }
function toggle() { isOpen() ? close() : open() }

function onToggle(event) { event.stopPropagation(); toggle() }
function onClose(event) { event.stopPropagation(); close() }
function onOpen(event) { event.stopPropagation(); open() }

/*
 * Escape dismisses it, from anywhere rather than only from inside the panel.
 *
 * Opening one of these does not move focus, so a keydown bound on the panel
 * never sees the first Escape - focus is still on whatever opened it. Drawer
 * reached the same conclusion and binds on the document; this follows it, and
 * only acts while open so one open popup does not swallow Escape for the page.
 *
 * Focus goes back to the trigger, but only if it had moved into the panel:
 * otherwise this would steal it from wherever the user actually is.
 */
function onEscape() {
  if (!isOpen()) return
  close()
  if (!rootEl) return
  const active = rootEl.ownerDocument && rootEl.ownerDocument.activeElement
  if (!active || !rootEl.contains(active)) return
  const trigger = rootEl.querySelector('[data-stx-popover-button]')
  if (trigger && trigger.focus) trigger.focus()
}

onMount(() => {
  rootEl = rootRef.value
  syncExpanded()
  mounted.set(true)
  if (nativePopup) return
  outsideHandler = (event) => {
    if (!isOpen() || !window.stx.overlays.isTop(popoverInstanceId)) return
    if (rootEl && !rootEl.contains(event.target)) close()
  }
  document.addEventListener('click', outsideHandler, true)
})

/*
 * Open means a layer on the page's overlay stack (window.stx.overlays), as a
 * popup: while it is on top it takes Escape, so inside a dialog one Escape
 * closes this and leaves the dialog open. It used to listen for Escape on the
 * document itself, and whichever of its listener and the dialog's had been
 * added first won (stacksjs/stx#2057). Not modal: it does not lock the page,
 * trap Tab or move focus.
 */
effect(() => {
  if (!mounted()) return
  if (stopPositioning) { stopPositioning(); stopPositioning = null }
  if (isOpen()) {
    const panel = ownPart('data-stx-popover-panel')
    try {
      if (nativePopup && !window.craft?.capabilities?.viewMeasure)
        throw new Error('Native Popover requires viewMeasure support')
      window.stx.overlays.open(popoverInstanceId, { modal: false, root: nativePopup ? panel : null, panel: () => rootEl, onEscape, onBackdrop: close })
      if (nativePopup) {
        const trigger = ownPart('data-stx-popover-button')
        if (!trigger) throw new Error('Native Popover requires a PopoverButton anchor')
        stopPositioning = trackNativePopup(trigger, panel, tree.getAttribute(panel, 'data-stx-popover-position') || 'bottom', style => tree.setStyle(panel, style))
      }
    }
    catch (error) {
      window.stx.overlays.close(popoverInstanceId)
      console.warn('[stx:popover] ' + ((error && error.message) || String(error)))
      close()
    }
  }
  else window.stx.overlays.close(popoverInstanceId)
})

onDestroy(() => {
  if (stopPositioning) stopPositioning()
  window.stx.overlays.close(popoverInstanceId)
  if (outsideHandler) document.removeEventListener('click', outsideHandler, true)
})

const dataState = derived(() => isOpen() ? 'open' : 'closed')

defineExpose({ isOpen, toggle, open, close })
</script>

<component
  :is="{{ as }}"
  x-ref="rootRef"
  class="{{ popoverClasses }}"
  data-stx-popover
  data-popover-id="{{ popoverInstanceId }}"
  :data-state="dataState()"
  @stx:popover-toggle="onToggle($event)"
  @stx:popover-open="onOpen($event)"
  @stx:popover-close="onClose($event)"
>
  <slot />
</component>

<style>
[data-stx-popover][data-state="closed"] [data-stx-popover-panel] {
  display: none;
}
</style>
