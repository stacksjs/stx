<script server>
export const value = $props.value
export const valueJson = JSON.stringify(value === undefined ? null : value)
export const multiple = $bool($props.multiple)
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative'
export const listboxClasses = `${baseClasses} ${className}`.trim()
export const listboxInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const listboxInstanceId = {{ listboxInstanceId }}
const multiple = {{ multiple }}
/*
 * JSON built on the server and emitted raw, rather than a 'null' sentinel
 * through an ordinary interpolation.
 *
 * A `value === undefined ? 'null' : value` ternary was meant to put the bare
 * token null into the script. An interpolation QUOTES a string, so what it
 * emitted was the four-character string "null" -- truthy, in the one place a
 * value is meant to be absent. JSON.stringify produces the correct literal for
 * every type, null included, and raw interpolation passes it through unquoted.
 * Calendar and DateRangePicker already avoid this sentinel and say why
 * (stacksjs/stx#1981).
 */
const initialValue = {!! valueJson !!}

const isOpen = state(false)
const selected = state(initialValue)
let rootEl = null
let outsideHandler = null

function isSelectedValue(v) {
  const cur = selected()
  if (multiple && Array.isArray(cur)) return cur.includes(v)
  return cur === v
}

function selectValue(v) {
  if (multiple) {
    const cur = Array.isArray(selected()) ? selected() : []
    selected.set(cur.includes(v) ? cur.filter(x => x !== v) : [...cur, v])
  }
  else {
    selected.set(v)
    isOpen.set(false)
  }
  syncOptionStates()
  // The single-select branch above closes the panel without going through
  // close(), so the trigger's state has to be refreshed here too.
  syncExpanded()
  emit('change', selected())
}

function syncOptionStates() {
  if (!rootEl) return
  const options = rootEl.querySelectorAll('[data-stx-listbox-option]')
  for (const opt of options) {
    const raw = opt.dataset.optionValue
    let v
    try { v = JSON.parse(raw ?? 'null') }
    catch { v = raw }
    const sel = isSelectedValue(v)
    opt.setAttribute('aria-selected', sel ? 'true' : 'false')
    opt.setAttribute('data-selected', sel ? 'true' : 'false')
  }
}

/*
 * The trigger carries the open state for assistive tech. `isOpen` already
 * drove `data-state` on the root, which styles the panel but says nothing to a
 * screen reader: the button announced itself as a plain button, with no
 * indication that it opens anything or whether it is open right now.
 */
function syncExpanded() {
  if (!rootEl) return
  const trigger = rootEl.querySelector('[data-stx-listbox-button]')
  if (!trigger) return
  trigger.setAttribute('aria-expanded', isOpen() ? 'true' : 'false')
  const panel = rootEl.querySelector('[data-stx-listbox-options]')
  if (!panel) return
  if (!panel.id) panel.id = 'stx-listbox-panel-' + listboxInstanceId
  trigger.setAttribute('aria-controls', panel.id)
}

function open() { if (!isOpen()) { isOpen.set(true); emit('change', selected()); syncExpanded() } }
function close() { if (isOpen()) { isOpen.set(false); syncExpanded() } }
function toggle() { isOpen() ? close() : open() }

function onToggle(event) { event.stopPropagation(); toggle() }
function onSelect(event) {
  event.stopPropagation()
  selectValue(event.detail)
}

/*
 * Escape dismisses it, from anywhere rather than only from inside the panel.
 *
 * Opening one of these does not move focus, so a keydown bound on the panel
 * never sees the first Escape - focus is still on whatever opened it. Drawer
 * reached the same conclusion and binds on the document; this follows it, and
 * only acts while open so one open popup does not swallow Escape for the page.
 *
 * Focus goes back to the trigger, but only if it had moved into the panel:
 * otherwise this would steal it from wherever the user actually is.
 */
function onDocumentKey(event) {
  if (event.key !== 'Escape' || !isOpen()) return
  close()
  if (!rootEl) return
  const active = rootEl.ownerDocument && rootEl.ownerDocument.activeElement
  if (!active || !rootEl.contains(active)) return
  const trigger = rootEl.querySelector('[data-stx-listbox-button]')
  if (trigger && trigger.focus) trigger.focus()
}

/*
 * Roving focus over the options.
 *
 * `role="option"` on an li is not focusable on its own, so the options carry
 * tabindex="-1" and focus moves programmatically -- the same arrangement
 * <Dropdown> uses for its menu items. APG allows either this or
 * aria-activedescendant for a listbox; <Combobox> is the case that REQUIRES
 * the latter, because focus has to stay in its input.
 *
 * Arrows move focus and do not change the selection. Selection following focus
 * is a documented variant, and the quieter of the two: arrowing past an option
 * should not commit a value the user was only passing over.
 */
function optionElements() {
  if (!rootEl) return []
  const all = rootEl.querySelectorAll('[data-stx-listbox-option]')
  return Array.prototype.filter.call(all, option => option.getAttribute('aria-disabled') !== 'true')
}

function focusOptionAt(index) {
  const options = optionElements()
  if (!options.length) return
  const target = options[(index + options.length) % options.length]
  if (target && target.focus) target.focus()
}

function focusedOptionIndex() {
  const doc = rootEl && rootEl.ownerDocument
  return doc ? optionElements().indexOf(doc.activeElement) : -1
}

/** Opening lands on what is already chosen, so the current value is in view. */
function focusSelectedOrFirst(fallbackToLast) {
  const options = optionElements()
  const chosen = options.findIndex(option => option.getAttribute('aria-selected') === 'true')
  if (chosen !== -1) focusOptionAt(chosen)
  else focusOptionAt(fallbackToLast ? options.length - 1 : 0)
}

/*
 * Type-ahead: a printable character jumps to the next option whose label
 * starts with it, wrapping, so a long list is reachable without arrowing
 * through all of it.
 */
function focusByTypeAhead(character) {
  const options = optionElements()
  if (!options.length) return false
  const wanted = character.toLowerCase()
  const from = focusedOptionIndex()
  for (let step = 1; step <= options.length; step++) {
    const candidate = options[(from + step + options.length) % options.length]
    const label = (candidate.textContent || '').trim().toLowerCase()
    if (label.startsWith(wanted)) {
      if (candidate.focus) candidate.focus()
      return true
    }
  }
  return false
}

/*
 * Gated on the event coming from inside this listbox. The handler is on the
 * document so Escape works before focus has moved into the panel, which would
 * otherwise make ArrowDown a page-wide scroll hijack.
 */
function onListboxKey(event) {
  if (!rootEl || !rootEl.contains(event.target)) return
  const key = event.key

  if (!isOpen()) {
    if (key !== 'ArrowDown' && key !== 'ArrowUp') return
    event.preventDefault()
    open()
    focusSelectedOrFirst(key === 'ArrowUp')
    return
  }

  if (key === 'ArrowDown' || key === 'ArrowUp') {
    event.preventDefault()
    const current = focusedOptionIndex()
    if (current === -1) focusSelectedOrFirst(key === 'ArrowUp')
    else focusOptionAt(current + (key === 'ArrowDown' ? 1 : -1))
    return
  }

  if (key === 'Home' || key === 'End') {
    event.preventDefault()
    focusOptionAt(key === 'Home' ? 0 : optionElements().length - 1)
    return
  }

  if (key === 'Enter' || key === ' ') {
    // An li does not activate on Enter, so the option is clicked and runs the
    // handler it already has.
    const current = focusedOptionIndex()
    if (current === -1) return
    event.preventDefault()
    optionElements()[current].click()
    return
  }

  if (key === 'Tab') {
    close()
    return
  }

  // A single printable character, so modifier combinations still reach the
  // browser.
  if (key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
    if (focusByTypeAhead(key)) event.preventDefault()
  }
}

onMount(() => {
  rootEl = document.querySelector(`[data-listbox-id="${listboxInstanceId}"]`)
  syncExpanded()
  syncOptionStates()
  outsideHandler = (event) => {
    if (!isOpen()) return
    if (rootEl && !rootEl.contains(event.target)) close()
  }
  document.addEventListener('click', outsideHandler, true)
  document.addEventListener('keydown', onDocumentKey)
  document.addEventListener('keydown', onListboxKey)
})

onDestroy(() => {
  if (outsideHandler) document.removeEventListener('click', outsideHandler, true)
  document.removeEventListener('keydown', onDocumentKey)
  document.removeEventListener('keydown', onListboxKey)
})

const dataState = derived(() => isOpen() ? 'open' : 'closed')

defineExpose({ isOpen, selected, toggle, open, close, selectValue })
</script>

<component
  :is="{{ as }}"
  class="{{ listboxClasses }}"
  data-stx-listbox
  data-listbox-id="{{ listboxInstanceId }}"
  :data-state="dataState()"
  @stx:listbox-toggle="onToggle($event)"
  @stx:listbox-select="onSelect($event)"
>
  <slot />
</component>

<style>
[data-stx-listbox][data-state="closed"] [data-stx-listbox-options] {
  display: none;
}
</style>
