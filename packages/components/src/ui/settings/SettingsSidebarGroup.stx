<script server>
/*
 * <SettingsSidebarGroup>: a run of sidebar items, set a little apart from the
 * next. System Settings gives its groups no headings; `label` is there for
 * the window that needs one.
 */
export const label = $props.label || ''
export const className = $props.className || ''
</script>

<div data-settings-group role="presentation" class="stx-settings-group {{ className }}">
  @if(label)
    <div class="stx-settings-group-label" role="presentation">{{ label }}</div>
  @endif
  <slot />
</div>

