<script server>
import { SETTINGS_NATIVE } from './native-theme'
import { settingsUpdateView } from './update'

/*
 * <SettingsUpdateRow>: the row every app that updates itself needs. The app
 * and its version, a sentence about where the update stands, and the one
 * button that moves it on: Check Now, Download and Install (with its
 * progress), or Restart to Update.
 *
 *   <SettingsGroup header="Software Update">
 *     <SettingsUpdateRow appName="Library" :status="status()"
 *       @check="craft.updater.check()" @install="craft.updater.install()"
 *       @relaunch="craft.updater.relaunch()" />
 *   </SettingsGroup>
 *
 * `status` is what the updater reports (`craft.updater`'s `UpdateStatus`, or
 * a web app's own of the same shape). The row does nothing on its own: it
 * says what the status says and emits `check`, `install` or `relaunch`. What
 * it says for each state is `settingsUpdateView` in ./update.
 *
 * It is a <SettingsRow> holding <Button appearance="mac">, so it is the same
 * row on the web and on a native host, and the window's search finds it
 * (`setting`, default `software-update`).
 */
export const appName = $props.appName || ''
export const status = $props.status && typeof $props.status === 'object' ? $props.status : null
export const setting = $props.setting || 'software-update'
export const keywords = Array.isArray($props.keywords) ? $props.keywords.join(' ') : ($props.keywords || 'update version upgrade release')
export const className = $props.className || ''
export const served = settingsUpdateView(status, appName)
export const progressClasses = $native ? SETTINGS_NATIVE.updateProgress : 'stx-settings-update-progress'
</script>

<script client>
import { settingsUpdateView } from './update'

const emit = defineEmits(['check', 'install', 'relaunch'])
const current = useReactiveProp('status', {{ status }})
const name = useReactiveProp('appName', {{ appName }})
const view = derived(() => settingsUpdateView(current(), name()))

function act(action) {
  // The status may have moved on since the button was drawn.
  if (view().action === action && !view().busy) emit(action)
}

defineExpose({ view })
</script>

<SettingsRow
  label="{{ served.title }}"
  :label="view().title"
  description="{{ served.sentence }}"
  :description="view().sentence"
  setting="{{ setting }}"
  keywords="{{ keywords }}"
  multiline
  className="{{ className }}"
>
  <span :show="view().progress" :text="view().progress" class="{{ progressClasses }}" data-settings-update-progress>{{ served.progress }}</span>
  <Button :if="view().action === 'check'" appearance="mac" :label="view().actionLabel" :loading="view().busy" @click="act('check')" />
  <Button :if="view().action === 'install'" appearance="mac" variant="primary" :label="view().actionLabel" :loading="view().busy" @click="act('install')" />
  <Button :if="view().action === 'relaunch'" appearance="mac" variant="primary" :label="view().actionLabel" @click="act('relaunch')" />
</SettingsRow>

<style data-native-exclude>
:where(:root) {
  --stx-mac-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', sans-serif;
