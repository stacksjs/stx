<script server>
/*
 * <SettingsPaneHeader>: the card at the top of a pane that says what the pane
 * is. A large icon tile, the pane's name, and a sentence about it.
 *
 *   <SettingsPaneHeader icon="i-f7-gear-alt-fill" tone="grey" title="General"
 *     description="Manage your overall setup and preferences." />
 *
 * Anything in the slot goes under the description: a link, a button.
 */
const TONES = ['grey', 'blue', 'red', 'orange', 'yellow', 'green', 'indigo', 'purple', 'pink', 'ink']
export const icon = $props.icon || ''
export const tone = TONES.includes($props.tone) ? $props.tone : 'grey'
export const title = $props.title || ''
export const description = $props.description || ''
export const className = $props.className || ''
</script>

<script client>
const heading = useReactiveProp('title', {{ title }})
const detail = useReactiveProp('description', {{ description }})
</script>

<header data-settings-pane-header class="stx-settings-hero {{ className }}">
  @if(icon)
    <span class="stx-settings-hero-tile" data-tone="{{ tone }}" aria-hidden="true"><i class="{{ icon }}"></i></span>
  @endif
  <h2 :text="heading()" class="stx-settings-hero-title">{{ title }}</h2>
  <p :show="detail()" :text="detail()" class="stx-settings-hero-description">{{ description }}</p>
  <div class="stx-settings-hero-extra"><slot /></div>
</header>

