<script server>
import { resolveIconColor } from './themes'

// Arc's favorites grid — the block of square tiles above a space's rows.
//
// These are deliberately NOT sidebar rows. They carry no `data-sidebar-item`,
// so the Sidebar controller's selection, arrow-key navigation and disclosure
// logic skip them entirely: a pinned tile is a shortcut, not a place in the
// list. Their own click handler emits `pinnedClick` and that is the whole
// contract.
export const items = ($props.items || []).map(item => ({
  id: item.id,
  label: item.label || '',
  icon: item.icon || '',
  image: item.image || '',
  href: item.href || '',
  iconStyle: resolveIconColor(item.iconColor) ? `color: ${resolveIconColor(item.iconColor)}` : '',
}))

export const columns = $props.columns || 4

// A tile separates itself from the panel by moving AWAY from it, which is not
// the same as being lighter.
//
// Measured against Dia at 2x: on a pale panel its tiles sit about 9 units
// DARKER than the surface behind them, and on a dark panel about 23 units
// lighter. A white overlay does the right thing in dark appearance and the
// wrong one in light, where it lifted the tile off a surface it is meant to be
// recessed into. Each appearance now overlays the colour that increases the
// separation, plus a hairline, which is what gives the well its edge.
//
// Height is 41px rather than 46: Dia's tiles measure 50pt wide by 41pt tall,
// so they are slightly landscape, and 46 made them read as too square against
// the row rhythm underneath.
export const tileClasses = [
  'grid h-[41px] place-items-center rounded-[10px]',
  'bg-black/[0.035] dark:bg-white/[0.09]',
  'ring-1 ring-black/[0.05] dark:ring-white/[0.06]',
  'transition-[background-color,transform] duration-150 ease-out',
  'hover:bg-black/[0.07] dark:hover:bg-white/[0.15]',
  'active:scale-[0.96]',
].join(' ')
</script>

<script client>
const emit = defineEmits()

function onPinnedClick(event) {
  const tile = event.target.closest('[data-space-pinned-item]')
  if (!tile) return
  emit('pinnedClick', { id: tile.dataset.pinnedId, href: tile.getAttribute('href') || '', event })
}
</script>

@if(items.length > 0)
  <div
    data-space-pinned
    class="grid gap-[6px] pb-[10px] pt-[2px]"
    style="grid-template-columns: repeat({{ columns }}, minmax(0, 1fr))"
    role="list"
    aria-label="Pinned"
    @click="onPinnedClick($event)"
  >
    @foreach(items as item)
      @if(item.href)
        <StxLink
          to="{{ item.href }}"
          data-space-pinned-item
          data-pinned-id="{{ item.id }}"
          class="{{ tileClasses }}"
          role="listitem"
          title="{{ item.label }}"
          aria-label="{{ item.label }}"
        >
          @if(item.image)
            <img src="{{ item.image }}" alt="" class="h-[22px] w-[22px] rounded-[5px] object-cover" />
          @else
            <span class="{{ item.icon }} h-[20px] w-[20px]" @if(item.iconStyle)style="{{ item.iconStyle }}"@endif aria-hidden="true"></span>
          @endif
        </StxLink>
      @else
        <button
          type="button"
          data-space-pinned-item
          data-pinned-id="{{ item.id }}"
          class="{{ tileClasses }}"
          role="listitem"
          title="{{ item.label }}"
          aria-label="{{ item.label }}"
        >
          @if(item.image)
            <img src="{{ item.image }}" alt="" class="h-[22px] w-[22px] rounded-[5px] object-cover" />
          @else
            <span class="{{ item.icon }} h-[20px] w-[20px]" @if(item.iconStyle)style="{{ item.iconStyle }}"@endif aria-hidden="true"></span>
          @endif
        </button>
      @endif
    @endforeach
  </div>
@endif
