<script server>
// The window-chrome strip at the top of a macOS sidebar: traffic lights on
// the left, floating "Liquid Glass" toolbar buttons on the right, and the
// whole strip acts as a window drag region inside a Craft window.
export const theme = $props.theme || $props.variant || 'macos'
export const actions = $props.actions || [] // [{ id, icon, label }]
export const title = $props.title || ''
export const subtitle = $props.subtitle || ''
export const logo = $props.logo || ''
export const showSearch = $props.showSearch ?? false
export const searchPlaceholder = $props.searchPlaceholder || 'Search'

export const isMacos = theme === 'macos' || theme === 'tahoe' || theme === 'macos-tahoe' || theme === 'macos-latest'

// Traffic lights: 13px circles, 7px apart, inset ~21px — measured on
// macOS Tahoe. Colors are Apple's exact stoplight values.
export const trafficLightClasses = 'h-[13px] w-[13px] rounded-full shadow-[inset_0_0_1px_rgba(0,0,0,0.2)]'

// Floating toolbar button: a 34px glass circle that brightens on hover.
export const toolbarButtonClasses = [
  'grid h-[34px] w-[34px] place-items-center rounded-full',
  'bg-white/55 dark:bg-white/10',
  'backdrop-blur-xl',
  'shadow-[0_1px_4px_rgba(0,0,0,0.12),inset_0_0.5px_0_rgba(255,255,255,0.6)]',
  'text-[#3c3c43]/75 dark:text-[#ebebf5]/75',
  'transition-colors duration-150',
  'hover:bg-white/80 dark:hover:bg-white/20',
  'active:bg-white/95 dark:active:bg-white/25',
].join(' ')

// Arc's header is quieter than macOS'. No floating glass buttons — just a
// recessed search field and flat ghost icons, sized to sit on the panel
// without competing with the row cards below it.
export const isArc = theme === 'arc'

// Window chrome. A macOS sidebar owns the top-left corner, so it is on by
// default there. Arc's sidebar can go either way — a browser window puts the
// lights and the back/forward controls in the sidebar, while an app that only
// borrows the look wants a bare strip — so on this theme it is opt-in.
//
// `windowControls` says WHO DRAWS THEM, which `showWindowControls` could not
// express:
//
//   'auto'    the default: replicas in a browser, the platform's own inside a
//             Craft window, decided by the host rather than by the author.
//   'draw'    replicas, always. For a web page imitating macOS — a marketing
//             shot, a screenshot — that must look the same everywhere.
//   'native'  the OS already drew them; reserve the room and keep out of it.
//   'none'    no controls, no room.
//
// The distinction is not cosmetic. Inside a real window the platform draws its
// own controls whatever this component does, so replicas there put SIX circles
// in the corner — three live ones from the window server and three that only
// look like buttons. That was the old default's doing: the same markup renders
// on a docs page, where mock lights are the whole point, and in an app, where
// they are a bug, and a fixed choice cannot be right in both.
//
// So the host decides. Craft publishes, before the document is parsed:
//
//   --craft-window-controls-replicas   the `display` a replica should take —
//                                      `none` where it drew real buttons
//   --craft-window-controls-width      the room they need inside the page: the
//                                      far edge of the real buttons, measured
//                                      on the window, and 0 whenever they are
//                                      not over the page — a titlebar of their
//                                      own, a native sidebar under them,
//                                      fullscreen
//
// Both are read as fallbacks, so a browser — where neither is set — draws the
// replicas and reserves nothing, and no JavaScript is involved either way.
// `--stx-native-controls-width` stays the manual override for a host that
// publishes nothing: it is the room to leave AFTER this header's own left
// padding.
const controlsProp = $props.windowControls || ''
export const windowControls = controlsProp
  || (($props.showWindowControls ?? !isArc) ? 'auto' : 'none')
export const autoWindowControls = windowControls === 'auto'
export const showWindowControls = windowControls === 'draw' || autoWindowControls
export const reserveWindowControls = windowControls === 'native' || autoWindowControls
export const showNavigation = $props.showNavigation ?? false

// A replica yields to the real thing — but only when it was the default that
// put it there. An author who asked for 'draw' gets replicas everywhere.
export const replicaStyle = autoWindowControls
  ? 'display: var(--craft-window-controls-replicas, flex)'
  : ''

// The room to leave, measured from the window's left edge and reduced by the
// padding this header already has. The host is the only thing that knows: a
// browser has no window buttons, a Craft window with a titlebar keeps them
// above the page, and only a titlebar-hidden one puts them over this row. So
// with nothing published there is nothing to leave room for — including under
// `native`, which asserts the platform drew them, not that this page is inside
// a window at all. `--stx-native-controls-width` covers a host that draws its
// own and publishes nothing.
const controlsWidth = 'var(--craft-window-controls-width, 0px)'
export const macosControlsReserve = `var(--stx-native-controls-width, max(0px, calc(${controlsWidth} - 21px)))`
export const arcControlsReserve = `var(--stx-native-controls-width, max(0px, calc(${controlsWidth} - 12px)))`

// No top padding when the platform's controls overlay this row — see the row
// itself for why 14pt is the number that matters. Expressed as arithmetic
// rather than a branch because only the host knows: a window that keeps its
// buttons in a titlebar publishes a width of 0 and keeps the padding.
export const arcChromePadding = `padding-top: max(0px, calc(12px - ${controlsWidth}))`

// A titled Arc header with window controls puts the two on one row, the way
// Arc and Dia do. A logo needs the wider second row to sit in, so its presence
// keeps the old two-row shape.
export const titleInChrome = isArc && (showWindowControls || reserveWindowControls) && !!title && !logo

// Back / forward / reload, as in Arc's URL strip. Flat and ghosted, not glass.
export const navButtons = [
  { id: 'back', icon: 'i-f7-arrow-left', label: 'Back' },
  { id: 'forward', icon: 'i-f7-arrow-right', label: 'Forward' },
  { id: 'reload', icon: 'i-f7-arrow-clockwise', label: 'Reload' },
]

// Arc's chrome takes its color from the panel rather than declaring its own.
// On a plain warm panel that resolves to the theme's ink; inside a space it
// follows `--stx-space-ink` and crossfades along with the panel on every
// swipe. A hardcoded `text-[#2c2a28]` would stay dark over a saturated space
// and would not move when the space changed.
export const arcSearchClasses = [
  'h-[30px] w-full rounded-[8px] border-0',
  'bg-black/[0.045] dark:bg-white/[0.07]',
  'pl-[28px] pr-[8px]',
  'text-[13px] text-current',
  'placeholder:text-current placeholder:opacity-40',
  'focus:outline-none focus:ring-2 focus:ring-black/10 dark:focus:ring-white/15',
].join(' ')

export const arcActionClasses = [
  'grid h-[28px] w-[28px] place-items-center rounded-[7px]',
  'opacity-55 transition-[background-color,opacity] duration-150',
  'hover:bg-black/[0.05] hover:opacity-100 dark:hover:bg-white/10',
].join(' ')
</script>

<script client>
const emit = defineEmits()

function onAction(event) {
  emit('action', event.currentTarget?.dataset?.sidebarAction || event.target.closest('[data-sidebar-action]')?.dataset.sidebarAction)
}

function onSearchInput(event) {
  emit('search', event.target.value)
}

function onWindowControl(action) {
  const api = window.craft?.window
  if (action === 'close') api?.close?.()
  if (action === 'minimize') api?.minimize?.()
  if (action === 'zoom') (api?.maximize || api?.zoom)?.call(api)
  emit('windowControl', action)
}
</script>

@if(isMacos)
  <div class="flex h-[52px] shrink-0 items-center justify-between pl-[21px] pr-[10px] [-webkit-app-region:drag]">
    @if(showWindowControls || reserveWindowControls)
      <div class="flex items-center [-webkit-app-region:no-drag]">
        @if(reserveWindowControls)
          <!--
            Empty on purpose. Where the platform drew the real buttons they are
            already here, over the top of this row; anything rendered into this
            space would sit underneath them.
          -->
          <span class="shrink-0" style="width: {{ macosControlsReserve }}" aria-hidden="true"></span>
        @endif
        @if(showWindowControls)
          <div class="group/lights flex items-center gap-[7px]" style="{{ replicaStyle }}">
            <button type="button" class="{{ trafficLightClasses }} bg-[#ff5f57]" aria-label="Close window" @click="onWindowControl('close')"></button>
            <button type="button" class="{{ trafficLightClasses }} bg-[#febc2e]" aria-label="Minimize window" @click="onWindowControl('minimize')"></button>
            <button type="button" class="{{ trafficLightClasses }} bg-[#28c840]" aria-label="Zoom window" @click="onWindowControl('zoom')"></button>
          </div>
        @endif
      </div>
    @elseif(logo || title)
      <div class="flex min-w-0 items-center gap-[8px] [-webkit-app-region:no-drag]">
        @if(logo)
          <img src="{{ logo }}" alt="" class="h-[24px] w-[24px] shrink-0 object-contain" />
        @endif
        @if(title)
          <span class="truncate text-[13px] font-semibold tracking-[-0.01em] text-[#1d1d1f] dark:text-[#f5f5f7]">{{ title }}</span>
        @endif
      </div>
    @else
      <span></span>
    @endif

    <div class="flex items-center gap-[8px] [-webkit-app-region:no-drag]">
      @foreach(actions as action)
        <button type="button" class="{{ toolbarButtonClasses }}" aria-label="{{ action.label }}" data-sidebar-action="{{ action.id }}" @click="onAction($event)">
          <span class="{{ action.icon }} h-[16px] w-[16px]" aria-hidden="true"></span>
        </button>
      @endforeach
      <slot name="actions" />
    </div>
  </div>

  @if(showSearch)
    <div class="shrink-0 px-[10px] pb-[6px]">
      <div class="relative">
        <span class="i-f7-search absolute left-[8px] top-1/2 h-[13px] w-[13px] -translate-y-1/2 text-[#3c3c43]/50 dark:text-[#ebebf5]/50" aria-hidden="true"></span>
        <input
          type="text"
          placeholder="{{ searchPlaceholder }}"
          class="h-[28px] w-full rounded-[8px] border-0 bg-black/5 pl-[26px] pr-[8px] text-[13px] text-black placeholder:text-[#3c3c43]/50 focus:outline-none focus:ring-2 focus:ring-[#0088ff]/60 dark:bg-white/10 dark:text-white dark:placeholder:text-[#ebebf5]/50"
          @input="onSearchInput($event)"
        />
      </div>
    </div>
  @endif
@elseif(isArc)
  <!--
    No top padding when the platform owns the controls. The header has to line
    its title up with buttons it does not draw, and the arithmetic is fixed by
    the row rather than by the text: the chrome row is 28pt tall because its
    action buttons are, so its contents centre 14pt down — which is exactly
    where the platform puts the middle of its controls (they span 8..19pt).
    Any padding above pushes the name below buttons it is meant to sit beside.
  -->
  <div class="flex flex-col gap-[8px] px-[10px] pb-[8px]" style="{{ reserveWindowControls ? arcChromePadding : 'padding-top: 12px' }}">
    @if(showWindowControls || reserveWindowControls || showNavigation)
      <div class="flex items-center gap-[12px] px-[2px] [-webkit-app-region:drag]">
        @if(reserveWindowControls)
          <!--
            Empty on purpose. The window server has already drawn three live
            buttons here; anything rendered into this space would sit under
            them, and a replica beside them would make six.
          -->
          <span class="shrink-0" style="width: {{ arcControlsReserve }}" aria-hidden="true"></span>
        @endif
        @if(showWindowControls)
          <div class="flex items-center gap-[7px] [-webkit-app-region:no-drag]" style="{{ replicaStyle }}">
            <button type="button" class="{{ trafficLightClasses }} bg-[#ff5f57]" aria-label="Close window" @click="onWindowControl('close')"></button>
            <button type="button" class="{{ trafficLightClasses }} bg-[#febc2e]" aria-label="Minimize window" @click="onWindowControl('minimize')"></button>
            <button type="button" class="{{ trafficLightClasses }} bg-[#28c840]" aria-label="Zoom window" @click="onWindowControl('zoom')"></button>
          </div>
        @endif
        <!--
          The title belongs on THIS row when there are window controls to sit
          beside, which is how Arc and Dia name the current space: lights, then
          the name, on one line. Given its own row below it read as a heading
          over the list rather than as a label on the window, and cost a line
          of panel height to say so.
        -->
        @if(titleInChrome)
          <span class="min-w-0 flex-1 truncate text-[13px] font-semibold">{{ title }}</span>
        @else
          <span class="flex-1"></span>
        @endif
        @if(showNavigation)
          <div class="flex items-center gap-[2px] [-webkit-app-region:no-drag]">
            @foreach(navButtons as nav)
              <button type="button" class="{{ arcActionClasses }}" aria-label="{{ nav.label }}" data-sidebar-action="{{ nav.id }}" @click="onAction($event)">
                <span class="{{ nav.icon }} h-[14px] w-[14px]" aria-hidden="true"></span>
              </button>
            @endforeach
          </div>
        @endif
        @if(titleInChrome && actions.length > 0)
          <div class="flex items-center gap-[2px] [-webkit-app-region:no-drag]">
            @foreach(actions as action)
              <button type="button" class="{{ arcActionClasses }}" aria-label="{{ action.label }}" data-sidebar-action="{{ action.id }}" @click="onAction($event)">
                <span class="{{ action.icon }} h-[15px] w-[15px]" aria-hidden="true"></span>
              </button>
            @endforeach
          </div>
        @endif
      </div>
    @endif

    @if(!titleInChrome && (title || logo || actions.length > 0))
      <div class="flex items-center gap-[8px]">
        @if(logo)
          <img src="{{ logo }}" alt="{{ title }}" class="h-[20px] w-[20px] rounded-[6px] object-cover" />
        @endif
        @if(title)
          <span class="min-w-0 flex-1 truncate text-[13px] font-medium">{{ title }}</span>
        @else
          <span class="flex-1"></span>
        @endif
        @foreach(actions as action)
          <button type="button" class="{{ arcActionClasses }}" aria-label="{{ action.label }}" data-sidebar-action="{{ action.id }}" @click="onAction($event)">
            <span class="{{ action.icon }} h-[15px] w-[15px]" aria-hidden="true"></span>
          </button>
        @endforeach
        <slot name="actions" />
      </div>
    @endif

    @if(showSearch)
      <div class="relative">
        <span class="i-f7-search absolute left-[9px] top-1/2 h-[13px] w-[13px] -translate-y-1/2 opacity-40" aria-hidden="true"></span>
        <input
          type="text"
          placeholder="{{ searchPlaceholder }}"
          class="{{ arcSearchClasses }}"
          @input="onSearchInput($event)"
        />
      </div>
    @endif
  </div>
@else
  <div class="flex h-13 items-center gap-3 border-b border-black/5 px-4 dark:border-white/10">
    @if(logo)
      <img src="{{ logo }}" alt="{{ title }}" class="h-8 w-8 rounded-lg object-cover" />
    @endif
    <div class="min-w-0">
      @if(title)
        <div class="truncate text-sm font-semibold text-black/90 dark:text-white">{{ title }}</div>
      @endif
      @if(subtitle)
        <div class="truncate text-xs text-black/50 dark:text-white/50">{{ subtitle }}</div>
      @endif
    </div>
    <slot name="actions" />
  </div>
@endif
