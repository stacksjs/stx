<script server>
export const className = $props.className || ''
export const as = $props.as || 'button'
/*
 * An icon-only control needs a name. It is not in the tab order (APG puts the
 * combobox itself there and gives this button tabindex="-1"), but a screen
 * reader still reaches it in browse mode, where it announced "button".
 */
export const label = $props.label || 'Show options'

const baseClasses = 'absolute inset-y-0 right-0 flex items-center pr-2'
export const buttonClasses = `${baseClasses} ${className}`.trim()
</script>

<script client>
function onClick(event) {
  event.currentTarget.dispatchEvent(new CustomEvent('stx:combobox-toggle', { bubbles: true }))
}
</script>

<component
  :is="{{ as }}"
  class="{{ buttonClasses }}"
  data-stx-combobox-button
  tabindex="-1"
  aria-label="{{ label }}"
  @click="onClick($event)"
>
  <svg class="h-5 w-5 text-fg-soft" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor">
    <path d="M7 7l3-3 3 3m0 6l-3 3-3-3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</component>
