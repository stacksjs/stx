<script server>
export const value = $props.value
export const valueJson = JSON.stringify(value === undefined ? null : value)
export const className = $props.className || ''
export const as = $props.as || 'div'

const baseClasses = 'relative'
export const comboboxClasses = `${baseClasses} ${className}`.trim()
export const comboboxInstanceId = $uid
</script>

<script client>
const emit = defineEmits()
const comboboxInstanceId = {{ comboboxInstanceId }}
/*
 * JSON built on the server and emitted raw, rather than a 'null' sentinel
 * through an ordinary interpolation.
 *
 * A `value === undefined ? 'null' : value` ternary was meant to put the bare
 * token null into the script. An interpolation QUOTES a string, so what it
 * emitted was the four-character string "null" -- truthy, in the one place a
 * value is meant to be absent. JSON.stringify produces the correct literal for
 * every type, null included, and raw interpolation passes it through unquoted.
 * Calendar and DateRangePicker already avoid this sentinel and say why
 * (stacksjs/stx#1981).
 */
const initialValue = {!! valueJson !!}

const isOpen = state(false)
const selected = state(initialValue)
const query = state('')
/*
 * The ACTIVE option, which is not the focused one.
 *
 * A combobox keeps focus in its input so the user can keep typing, so there is
 * no focused option to move -- the active one is named by
 * `aria-activedescendant` on the input instead. That is why <Listbox> and
 * <Dropdown> move real focus with a roving tabindex and this does not, and why
 * aria-activedescendant was absent until there was something to point it at.
 */
const activeIndex = state(-1)
let rootEl = null
let outsideHandler = null

function isSelectedValue(v) {
  return selected() === v
}

function selectValue(v) {
  selected.set(v)
  isOpen.set(false)
  syncOptionStates()
  syncExpanded()
  emit('change', v)
}

function syncOptionStates() {
  if (!rootEl) return
  const options = rootEl.querySelectorAll('[data-stx-combobox-option]')
  for (const opt of options) {
    const raw = opt.dataset.optionValue
    let v
    try { v = JSON.parse(raw ?? 'null') }
    catch { v = raw }
    const sel = isSelectedValue(v)
    opt.setAttribute('aria-selected', sel ? 'true' : 'false')
    opt.setAttribute('data-selected', sel ? 'true' : 'false')
  }
}

/*
 * role="combobox" makes aria-expanded REQUIRED, and the state lived only in
 * `data-state` on the root. Nothing announced whether the list was showing.
 *
 * aria-activedescendant is deliberately absent: it names the option a user has
 * moved to, and this combobox has no option keyboard navigation to move with,
 * so pointing at one would describe a focus that does not exist.
 */
function syncExpanded() {
  if (!rootEl) return
  const input = rootEl.querySelector('[data-stx-combobox-input]')
  if (!input) return
  input.setAttribute('aria-expanded', isOpen() ? 'true' : 'false')
  const list = rootEl.querySelector('[data-stx-combobox-options]')
  if (!list) return
  if (!list.id) list.id = 'stx-combobox-list-' + comboboxInstanceId
  input.setAttribute('aria-controls', list.id)
}

function optionElements() {
  if (!rootEl) return []
  const all = rootEl.querySelectorAll('[data-stx-combobox-option]')
  return Array.prototype.filter.call(all, option => option.getAttribute('aria-disabled') !== 'true')
}

/*
 * aria-activedescendant needs an id to point at, so the options are given one
 * here rather than in the markup: the component does not know its own index
 * and an id has to be unique on the page, not just within the list.
 */
function syncActiveOption() {
  if (!rootEl) return
  const options = optionElements()
  const index = activeIndex()
  const doc = rootEl.ownerDocument
  for (let i = 0; i < options.length; i++) {
    /*
     * An id is only usable here if it is UNIQUE, and an existing one may not
     * be: event binding stamps every bound element `__stx_evt_0`, restarting
     * per component render, so four options arrive sharing one id and
     * getElementById returns an arbitrary one of them. An author's own id is
     * kept when it really is unique; otherwise this assigns its own.
     */
    const existing = options[i].id
    const unique = existing && doc.querySelectorAll('[id="' + existing + '"]').length === 1
    if (!unique) options[i].id = 'stx-combobox-option-' + comboboxInstanceId + '-' + i
    if (i === index) options[i].setAttribute('data-active', 'true')
    else options[i].removeAttribute('data-active')
  }
  const input = rootEl.querySelector('[data-stx-combobox-input]')
  if (!input) return
  const active = index >= 0 ? options[index] : null
  if (active) input.setAttribute('aria-activedescendant', active.id)
  else input.removeAttribute('aria-activedescendant')
}

function moveActive(delta) {
  const options = optionElements()
  if (!options.length) return
  const from = activeIndex()
  const next = from < 0
    ? (delta > 0 ? 0 : options.length - 1)
    : (from + delta + options.length) % options.length
  activeIndex.set(next)
  syncActiveOption()
  const landed = optionElements()[next]
  // The list scrolls at max-h-60, so an option stepped past the fold has to be
  // brought in: there is no focus move to do it for us.
  if (landed && landed.scrollIntoView) landed.scrollIntoView({ block: 'nearest' })
}

/*
 * Gated on the event coming from inside this combobox, like the Escape
 * handler, so an arrow key elsewhere on the page still scrolls it.
 *
 * Space is deliberately absent. On <Listbox> and <Dropdown> it activates the
 * focused item; here focus is in a text input and Space has to type a space.
 */
function onComboboxKey(event) {
  if (!rootEl || !rootEl.contains(event.target)) return
  const key = event.key

  if (!isOpen()) {
    if (key !== 'ArrowDown' && key !== 'ArrowUp') return
    event.preventDefault()
    open()
    activeIndex.set(-1)
    moveActive(key === 'ArrowDown' ? 1 : -1)
    return
  }

  if (key === 'ArrowDown' || key === 'ArrowUp') {
    event.preventDefault()
    moveActive(key === 'ArrowDown' ? 1 : -1)
    return
  }

  if (key === 'Home' || key === 'End') {
    event.preventDefault()
    activeIndex.set(-1)
    moveActive(key === 'Home' ? 1 : -1)
    return
  }

  if (key === 'Enter') {
    const options = optionElements()
    const index = activeIndex()
    if (index < 0 || !options[index]) return
    event.preventDefault()
    options[index].click()
    return
  }

  if (key === 'Tab') close()
}

function open() { if (!isOpen()) { isOpen.set(true); syncExpanded() } }
function close() { if (isOpen()) { isOpen.set(false); activeIndex.set(-1); syncActiveOption(); syncExpanded() } }
function toggle() { isOpen() ? close() : open() }

function onToggle(event) { event.stopPropagation(); toggle() }
function onSelect(event) { event.stopPropagation(); selectValue(event.detail) }
function onQuery(event) {
  event.stopPropagation()
  query.set(event.detail)
  // The list the indexes referred to is about to change under them.
  activeIndex.set(-1)
  syncActiveOption()
  if (!isOpen()) open()
  emit('query', event.detail)
}

/*
 * Escape dismisses it, from anywhere rather than only from inside the panel.
 *
 * Opening one of these does not move focus, so a keydown bound on the panel
 * never sees the first Escape - focus is still on whatever opened it. Drawer
 * reached the same conclusion and binds on the document; this follows it, and
 * only acts while open so one open popup does not swallow Escape for the page.
 *
 * Focus goes back to the trigger, but only if it had moved into the panel:
 * otherwise this would steal it from wherever the user actually is.
 */
function onDocumentKey(event) {
  if (event.key !== 'Escape' || !isOpen()) return
  close()
  if (!rootEl) return
  const active = rootEl.ownerDocument && rootEl.ownerDocument.activeElement
  if (!active || !rootEl.contains(active)) return
  // The input is the tab stop here; the chevron is deliberately tabindex="-1".
  const trigger = rootEl.querySelector('[data-stx-combobox-input]')
  if (trigger && trigger.focus) trigger.focus()
}

onMount(() => {
  rootEl = document.querySelector(`[data-combobox-id="${comboboxInstanceId}"]`)
  syncOptionStates()
  syncExpanded()
  outsideHandler = (event) => {
    if (!isOpen()) return
    if (rootEl && !rootEl.contains(event.target)) close()
  }
  document.addEventListener('click', outsideHandler, true)
  document.addEventListener('keydown', onDocumentKey)
  document.addEventListener('keydown', onComboboxKey)
})

onDestroy(() => {
  if (outsideHandler) document.removeEventListener('click', outsideHandler, true)
  document.removeEventListener('keydown', onDocumentKey)
  document.removeEventListener('keydown', onComboboxKey)
})

const dataState = derived(() => isOpen() ? 'open' : 'closed')

defineExpose({ isOpen, selected, query, activeIndex, toggle, open, close, selectValue })
</script>

<component
  :is="{{ as }}"
  class="{{ comboboxClasses }}"
  data-stx-combobox
  data-combobox-id="{{ comboboxInstanceId }}"
  :data-state="dataState()"
  @stx:combobox-toggle="onToggle($event)"
  @stx:combobox-select="onSelect($event)"
  @stx:combobox-query="onQuery($event)"
>
  <slot />
</component>

<style>
[data-stx-combobox][data-state="closed"] [data-stx-combobox-options] {
  display: none;
}
</style>
