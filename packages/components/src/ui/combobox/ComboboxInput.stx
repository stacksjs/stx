<script server>
export const displayValue = $props.displayValue
export const className = $props.className || ''
export const placeholder = $props.placeholder || ''
export const disabled = $bool($props.disabled)

const baseClasses = 'w-full rounded-panel border-none bg-panel py-2 pl-3 pr-10 text-sm leading-5 text-fg focus:ring-0 focus:outline-none focus-visible:border-accent-solid focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-panel focus-visible:ring-offset-2'
const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : ''
export const inputClasses = `${baseClasses} ${disabledClasses} ${className}`.trim()
</script>

<script client>
const isDisabled = {{ disabled }}

function onInput(event) {
  if (isDisabled) return
  event.currentTarget.dispatchEvent(
    new CustomEvent('stx:combobox-query', { bubbles: true, detail: event.target.value }),
  )
}
</script>

<input
  type="text"
  class="{{ inputClasses }}"
  data-stx-combobox-input
  placeholder="{{ placeholder }}"
  value="{{ displayValue }}"
  @if(disabled)disabled@endif
  @input="onInput($event)"
  autocomplete="off"
/>
