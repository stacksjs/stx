<script server>
import { applyHeadwindClasses, highlight } from '../utils/highlighter'

export const code = $props.code || ''
export const language = $props.language || 'typescript'
export const theme = $props.theme || 'auto'
/*
 * `$bool`, not `!== false`. A plain attribute arrives as a STRING, so
 * `copyable="false"` was `'false' !== false` - true - and the copy button
 * rendered anyway, which is half of why #2014 looked like a template-gating
 * problem. Same shape as the 103 props in stacksjs/stx#2006; `!== false` is a
 * third spelling of it that the library-wide sweep does not recognise.
 */
export const lineNumbers = $bool($props.lineNumbers, true)
export const copyable = $bool($props.copyable, true)
export const className = $props.className || ''

/*
 * `lineNumbers` is still not passed on. `highlight()` can number lines now (as
 * a CSS counter, so they never reach a copy), but this prop defaults to true
 * and has always been dropped: honouring it would put numbers on every block
 * already in use. Turning it on is its own change.
 */
const result = await highlight(code, { language, theme })
export const highlightedCode = applyHeadwindClasses(result.html, className)
// The same sheet the <style> block below ships as literal text. A <style>
// inside a component is extracted from its source before interpolation runs,
// so `{{ highlightCss }}` in one would ship an empty tag; the literal copy is
// what a page gets, and this export is for a caller that wants the string.
export const highlightCss = result.css
export const renderedOnServer = code !== ''
export const liveClasses = `rounded-md overflow-auto text-sm leading-relaxed font-mono ${className}`.trim()

/*
 * The clipboard payload, decided on the SERVER.
 *
 * `{{ copyable ? code : '' }}` in the client script does not work:
 * interpolateScriptExpressions resolves an identifier or a property path, not
 * an arbitrary expression, so a ternary emits nothing at all (#1989) and the
 * declaration came out as a bare `const code = `. A named export is a plain
 * identifier, which is what the interpolator can resolve.
 */
export const copyPayload = copyable ? code : ''
</script>

<script client>
/*
 * The code is shipped to the browser only when there is a copy button to need
 * it (stacksjs/stx#2014).
 *
 * This was an unconditional `const code = {{ code }}`, while `copyable` gated
 * only the button in the template - so `:copyable="false"` still emitted the
 * full snippet as page JavaScript. An app whose blocks are install commands
 * carrying a per-resource credential had no way to render one without that,
 * which defeats an invariant it maintains deliberately: stx's own
 * extractBridgeData skips `__` and `$` names, and `:code="__agentInstall.install"`
 * routed straight around it. In the ordinary case it was dead weight - a block
 * with no copy button shipping a duplicate of its own content.
 *
 * Reading the text out of the DOM at click time would drop the payload for
 * everyone, which the report suggests and which I measured before rejecting:
 * the highlighter renders line numbers as TEXT, so once `lineNumbers` is
 * honoured (it is currently accepted and dropped) `textContent` copies
 * "1const a = 1" rather than the code. Gating is the version that cannot
 * silently corrupt what lands on the clipboard.
 */
let code = {{ copyPayload }}
const copied = state(false)

/*
 * A block whose code is bound (`:code="snippet()"`) follows it in the browser.
 *
 * The new code is shown at once, as text. It is coloured as well when the page
 * hands this block a highlighter: `:highlighter="highlightToHtml"`, the function
 * this package exports, which runs in a browser through the highlighter's
 * browser entry. It is passed in rather than imported here because an import
 * in this script is bundled into every page that has a code block on it, and a
 * page of static snippets should not download a tokenizer and its grammars to
 * show HTML the server already coloured.
 *
 * `null` as the default for `code`, not the server's code: a default would put
 * the snippet in this script whether or not anything needs it (#2014).
 */
const liveCode = useReactiveProp('code', null, { parse: v => v })
const liveLanguage = useReactiveProp('language', {{ language }}, { parse: v => (v == null ? '' : String(v)) })
const liveHighlighter = useReactiveProp('highlighter', null, { parse: v => v })
const liveHtml = state('')
// What the server drew. A bound prop is not known there, so it drew nothing.
let renderedCode = {{ renderedOnServer }} ? null : ''
let renderedLanguage = {{ language }}
let request = 0

const themeAttribute = {{ theme }} === 'light' || {{ theme }} === 'dark' ? ' data-syntax-theme="' + {{ theme }} + '"' : ''
function plainHtml(text) {
  return '<pre class="syntax"' + themeAttribute + '><code>' + String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</code></pre>'
}

effect(() => {
  const next = liveCode()
  const language = liveLanguage() || {{ language }}
  const highlighter = liveHighlighter()
  if (typeof next !== 'string') return
  // The first value a bound prop delivers is the one the server drew.
  if (renderedCode === null) {
    renderedCode = next
    return
  }
  if (next === renderedCode && language === renderedLanguage) return

  renderedCode = next
  renderedLanguage = language
  if ({{ copyable }}) code = next
  const mine = ++request
  liveHtml.set(plainHtml(next))
  if (typeof highlighter !== 'function') return

  Promise.resolve()
    .then(() => highlighter(next, { language, theme: {{ theme }} }))
    .then((html) => {
      // A later change has already been drawn, or there was nothing to colour.
      if (mine === request && typeof html === 'string' && html) liveHtml.set(html)
    })
    .catch(() => {})
})
</script>

<div class="relative group">
  {{-- The server's render, until a bound `code` changes; then the browser's. --}}
  <div :show="!liveHtml()">{!! highlightedCode !!}</div>
  <div class="{{ liveClasses }}" :show="liveHtml()" :html="liveHtml()"></div>

  @if(copyable)
    <button
      @click="copyToClipboard()"
      {{-- Reachable without a mouse (#2014). It was `opacity-0
           group-hover:opacity-100` with no focus variant, so a keyboard user
           who tabbed to it saw nothing and on a touch device it never appeared
           at all - the control was there, took focus, and was invisible.

           `focus-visible:opacity-100` fixes the keyboard half. The touch half
           cannot be done with a hover variant, and the engine has no
           `@media (hover: none)` variant to hang it on, so the button is now
           always present at 60% and comes to full opacity on hover or focus.
           That is a visible change - the button no longer hides until pointed
           at - and it is the only arrangement that is operable on a phone. --}}
      class="absolute top-2 right-2 opacity-60 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity duration-200 px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-white text-xs rounded-panel font-medium"
      aria-label="Copy code"
    >
      <span :show="copied()" class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Copied!
      </span>
      <span :show="!copied()" class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        Copy
      </span>
    </button>
  @endif
</div>

<style>
/* codeBlockCss() in utils/syntax-theme.ts, as literal text. A test holds the two
   together; change that file and paste, not this. */
:where(:root) {
  --stx-syntax-background: #ffffff;
  --stx-syntax-foreground: #24292f;
  --stx-syntax-keyword: #cf222e;
  --stx-syntax-string: #0a3069;
  --stx-syntax-comment: #6e7781;
  --stx-syntax-numeric: #0550ae;
  --stx-syntax-constant: #0550ae;
  --stx-syntax-function: #8250df;
  --stx-syntax-operator: #cf222e;
  --stx-syntax-punctuation: #24292f;
  --stx-syntax-type: #953800;
  --stx-syntax-variable: #953800;
  --stx-syntax-tag: #116329;
  --stx-syntax-attribute: #0550ae;
}
@media (prefers-color-scheme: dark) {
:where(:root:not(.light)) {
  --stx-syntax-background: #0d1117;
  --stx-syntax-foreground: #c9d1d9;
  --stx-syntax-keyword: #ff7b72;
  --stx-syntax-string: #a5d6ff;
  --stx-syntax-comment: #8b949e;
  --stx-syntax-numeric: #79c0ff;
  --stx-syntax-constant: #79c0ff;
  --stx-syntax-function: #d2a8ff;
  --stx-syntax-operator: #ff7b72;
  --stx-syntax-punctuation: #c9d1d9;
  --stx-syntax-type: #ffa657;
  --stx-syntax-variable: #ffa657;
  --stx-syntax-tag: #7ee787;
  --stx-syntax-attribute: #79c0ff;
}
}
:where(.dark) {
  --stx-syntax-background: #0d1117;
  --stx-syntax-foreground: #c9d1d9;
  --stx-syntax-keyword: #ff7b72;
  --stx-syntax-string: #a5d6ff;
  --stx-syntax-comment: #8b949e;
  --stx-syntax-numeric: #79c0ff;
  --stx-syntax-constant: #79c0ff;
  --stx-syntax-function: #d2a8ff;
  --stx-syntax-operator: #ff7b72;
  --stx-syntax-punctuation: #c9d1d9;
  --stx-syntax-type: #ffa657;
  --stx-syntax-variable: #ffa657;
  --stx-syntax-tag: #7ee787;
  --stx-syntax-attribute: #79c0ff;
}
:where([data-syntax-theme="light"]) {
  --stx-syntax-background: #ffffff;
  --stx-syntax-foreground: #24292f;
  --stx-syntax-keyword: #cf222e;
  --stx-syntax-string: #0a3069;
  --stx-syntax-comment: #6e7781;
  --stx-syntax-numeric: #0550ae;
  --stx-syntax-constant: #0550ae;
  --stx-syntax-function: #8250df;
  --stx-syntax-operator: #cf222e;
  --stx-syntax-punctuation: #24292f;
  --stx-syntax-type: #953800;
  --stx-syntax-variable: #953800;
  --stx-syntax-tag: #116329;
  --stx-syntax-attribute: #0550ae;
}
:where([data-syntax-theme="dark"]) {
  --stx-syntax-background: #0d1117;
  --stx-syntax-foreground: #c9d1d9;
  --stx-syntax-keyword: #ff7b72;
  --stx-syntax-string: #a5d6ff;
  --stx-syntax-comment: #8b949e;
  --stx-syntax-numeric: #79c0ff;
  --stx-syntax-constant: #79c0ff;
  --stx-syntax-function: #d2a8ff;
  --stx-syntax-operator: #ff7b72;
  --stx-syntax-punctuation: #c9d1d9;
  --stx-syntax-type: #ffa657;
  --stx-syntax-variable: #ffa657;
  --stx-syntax-tag: #7ee787;
  --stx-syntax-attribute: #79c0ff;
}
.tok-keyword { color: var(--stx-syntax-keyword); }
.tok-string { color: var(--stx-syntax-string); }
.tok-comment { color: var(--stx-syntax-comment); }
.tok-numeric { color: var(--stx-syntax-numeric); }
.tok-constant { color: var(--stx-syntax-constant); }
.tok-function { color: var(--stx-syntax-function); }
.tok-operator { color: var(--stx-syntax-operator); }
.tok-punctuation { color: var(--stx-syntax-punctuation); }
.tok-type { color: var(--stx-syntax-type); }
.tok-variable { color: var(--stx-syntax-variable); }
.tok-tag { color: var(--stx-syntax-tag); }
.tok-attribute { color: var(--stx-syntax-attribute); }
.tok-comment { font-style: italic; }
.syntax {
  margin: 0;
  padding: 1rem;
  overflow-x: auto;
  border-radius: 0.375rem;
  background-color: var(--stx-syntax-background);
  color: var(--stx-syntax-foreground);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-size: 0.875rem;
  line-height: 1.5;
  tab-size: 2;
}
.syntax code { display: block; font-family: inherit; }
.syntax[data-line-numbers] { counter-reset: stx-syntax-line; }
.syntax[data-line-numbers] .line::before {
  counter-increment: stx-syntax-line;
  content: counter(stx-syntax-line);
  display: inline-block;
  width: 2.5em;
  margin-right: 1em;
  text-align: right;
  opacity: 0.5;
  user-select: none;
}
</style>
